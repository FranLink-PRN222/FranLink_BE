@page
@model PresentationLayer_FranLink.Pages.Supply.InternalOrders.IndexModel
@{
    ViewData["Title"] = "Supply Coordinator - Internal Orders";
}

<h1>Supply Coordinator - Internal Orders</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>Store</th>
            <th>Kitchen</th>
            <th>Order Status</th>
            <th>Delivery Status</th>
            <th>Items</th>
            <th>Scheduled Date</th>
            <th>Order Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model.Orders)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.FranchiseStore?.Name</td>
                <td>@(order.CentralKitchen?.Name ?? "Not assigned")</td>
                <td>@order.Status</td>
                <td>@(order.Delivery?.DeliveryStatus ?? "N/A")</td>
                <td>@(order.Items?.Count ?? 0)</td>
                <td>@(order.Delivery?.ScheduledDate?.ToShortDateString() ?? "-")</td>
                <td>@order.OrderDate.ToLocalTime()</td>
                <td>
                    @if (order.Status == "Pending")
                    {
                        var hasStock = Model.HasSufficientInventory.ContainsKey(order.Id)
                            ? Model.HasSufficientInventory[order.Id]
                            : false;

                        if (hasStock)
                        {
                            <span class="badge bg-success me-2">Sufficient stock</span>
                        }
                        else
                        {
                            <span class="badge bg-danger me-2">Insufficient stock</span>
                        }

                        <a asp-page="./Details" asp-route-id="@order.Id" class="btn btn-sm btn-primary me-1">Review</a>

                        <form method="post" asp-page-handler="Cancel" asp-route-id="@order.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                        </form>
                    }
                    else if (order.Status == "Ready")
                    {
                        if (order.Delivery?.DeliveryStatus == "NotScheduled")
                        {
                            <!-- Supply chỉ lập lịch (NotScheduled -> Preparing) -->
                            <form method="post" asp-page-handler="StartDelivery" asp-route-id="@order.Id" class="d-inline">
                                <input type="date" name="scheduledDate" class="form-control form-control-sm d-inline w-auto" required />
                                <button type="submit" class="btn btn-sm btn-secondary ms-1">Schedule Delivery</button>
                            </form>
                        }
                        else
                        {
                            <!-- Các bước vận chuyển tiếp theo do bên giao hàng confirm; Supply chỉ theo dõi trạng thái -->
                            <span class="text-muted">In delivery pipeline</span>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

