@page
@model PresentationLayer_FranLink.Pages.Supply.InternalOrders.IndexModel
@{
    ViewData["Title"] = "Supply Coordinator - Internal Orders";
}

<h1>Supply Coordinator - Internal Orders</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>Store</th>
            <th>Kitchen</th>
            <th>Order Status</th>
            <th>Delivery Status</th>
            <th>Order Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model.Orders)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.FranchiseStore?.Name</td>
                <td>@(order.CentralKitchen?.Name ?? "Not assigned")</td>
                <td>@order.Status</td>
                <td>@(order.Delivery?.DeliveryStatus ?? "N/A")</td>
                <td>@order.OrderDate.ToLocalTime()</td>
                <td>
                    @if (order.Status == "Pending")
                    {
                        <!-- Supply chỉ chọn bếp + duyệt / hủy -->
                        <form method="post" asp-page-handler="Approve" asp-route-id="@order.Id" class="d-inline">
                            <select name="centralKitchenId" class="form-select form-select-sm d-inline w-auto" required>
                                <option value="">Select Kitchen</option>
                                @foreach (var ck in Model.CentralKitchens)
                                {
                                    <option value="@ck.Value">@ck.Text</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-success ms-1">Approve</button>
                        </form>

                        <form method="post" asp-page-handler="Cancel" asp-route-id="@order.Id" class="d-inline ms-1">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                        </form>
                    }
                    else if (order.Status == "Ready")
                    {
                        if (order.Delivery?.DeliveryStatus == "NotScheduled")
                        {
                            <!-- Bước 1: Lập lịch giao (NotScheduled -> Preparing) -->
                            <form method="post" asp-page-handler="StartDelivery" asp-route-id="@order.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-secondary">Schedule Delivery</button>
                            </form>
                        }
                        else if (order.Delivery?.DeliveryStatus == "Preparing")
                        {
                            <!-- Bước 2: Bắt đầu giao (Preparing -> InTransit) -->
                            <form method="post" asp-page-handler="StartDelivery" asp-route-id="@order.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-info">Start Delivery</button>
                            </form>
                        }
                        else if (order.Delivery?.DeliveryStatus == "InTransit")
                        {
                            <!-- Bước 3: Giao xong (InTransit -> Delivered) -->
                            <form method="post" asp-page-handler="MarkDelivered" asp-route-id="@order.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success">Mark Delivered</button>
                            </form>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

