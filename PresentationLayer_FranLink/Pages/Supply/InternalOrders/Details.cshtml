@page "{id:int}"
@model PresentationLayer_FranLink.Pages.Supply.InternalOrders.DetailsModel
@{
    ViewData["Title"] = "Review Internal Order";
    Layout = "_LayoutFranLink";
}

<div class="px-6 py-8 lg:px-20 max-w-[1280px] mx-auto w-full flex flex-col gap-8">

    <!-- Header Actions & Alerts -->
    <div class="flex flex-col gap-6">
        <div class="flex items-center justify-between">
            <div class="space-y-1">
                <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
                    <a asp-page="./Index" class="hover:text-[#137fec] transition-colors">Supply Orders</a>
                    <span class="material-symbols-outlined text-[10px]">chevron_right</span>
                    <span class="text-slate-600">Review Order #@Model.Order.Id</span>
                </nav>
                <h1 class="text-slate-900 text-3xl font-extrabold tracking-tight flex items-center gap-3">
                    <span class="material-symbols-outlined text-3xl text-[#137fec]">task_alt</span>
                    Review Internal Order #@Model.Order.Id
                </h1>
            </div>
            <a asp-page="./Index" class="flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-200 bg-white text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors shadow-sm">
                <span class="material-symbols-outlined text-lg">arrow_back</span> Back to List
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="p-4 rounded-xl border border-emerald-100 bg-emerald-50/50 flex items-center gap-3 text-emerald-800 text-sm font-medium animate-in fade-in slide-in-from-top-2">
                <span class="material-symbols-outlined text-emerald-500">check_circle</span>
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="p-4 rounded-xl border border-rose-100 bg-rose-50/50 flex items-center gap-3 text-rose-800 text-sm font-medium animate-in fade-in slide-in-from-top-2">
                <span class="material-symbols-outlined text-rose-500">error</span>
                @TempData["ErrorMessage"]
            </div>
        }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
        
        <!-- Left: Order Summary -->
        <div class="lg:col-span-1 space-y-6">
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50">
                    <h3 class="text-slate-900 font-bold flex items-center gap-2">
                        <span class="material-symbols-outlined text-slate-400">info</span>
                        Order Summary
                    </h3>
                </div>
                <div class="p-6 space-y-5">
                    <div class="grid grid-cols-1 gap-4">
                        <div class="space-y-1">
                            <p class="text-slate-400 text-[10px] font-bold uppercase tracking-widest">Requesting Store</p>
                            <p class="text-slate-900 font-bold flex items-center gap-2">
                                <span class="material-symbols-outlined text-slate-400 text-sm">store</span>
                                @Model.Order.FranchiseStore?.Name
                            </p>
                        </div>
                        <div class="space-y-1">
                            <p class="text-slate-400 text-[10px] font-bold uppercase tracking-widest">Target Kitchen</p>
                            <p class="text-slate-900 font-bold flex items-center gap-2">
                                <span class="material-symbols-outlined text-slate-400 text-sm">kitchen</span>
                                @Model.Order.CentralKitchen?.Name
                            </p>
                        </div>
                        <div class="pt-2 flex items-center justify-between">
                            <div class="space-y-1">
                                <p class="text-slate-400 text-[10px] font-bold uppercase tracking-widest">Order Status</p>
                                @{
                                    var orderStatusColor = Model.Order.Status switch {
                                        "Pending" => "bg-amber-100 text-amber-700",
                                        "Approved" => "bg-emerald-100 text-emerald-700",
                                        "Cancelled" => "bg-slate-100 text-slate-600",
                                        _ => "bg-slate-100 text-slate-600"
                                    };
                                }
                                <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold uppercase @orderStatusColor">@Model.Order.Status</span>
                            </div>
                            <div class="space-y-1 text-right">
                                <p class="text-slate-400 text-[10px] font-bold uppercase tracking-widest">Delivery</p>
                                <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-sky-100 text-sky-700">@Model.Order.Delivery?.DeliveryStatus</span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Action Footer -->
                @if (Model.Order.Status == "Pending")
                {
                    <div class="px-6 py-6 border-t border-slate-100 bg-slate-50/30">
                        @if (Model.HasSufficientInventory)
                        {
                            <form method="post" asp-page-handler="Approve" asp-route-id="@Model.Order.Id" class="w-full">
                                <button type="submit" class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold shadow-lg shadow-emerald-200 transition-all flex items-center justify-center gap-2 group">
                                    <span class="material-symbols-outlined group-hover:scale-110 transition-transform">verified</span>
                                    Approve & Allocate
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="flex flex-col gap-2 p-3 rounded-lg border border-rose-100 bg-rose-50/50 text-rose-700 text-xs font-semibold">
                                <span class="flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">warning</span>
                                    Insufficient stock in kitchen
                                </span>
                                <p class="text-[10px] text-rose-500 font-normal leading-relaxed text-center">Cannot approve: Some items requested exceed the current kitchen inventory levels.</p>
                            </div>
                        }
                        
                        <form method="post" asp-page-handler="Cancel" asp-route-id="@Model.Order.Id" class="mt-3 w-full">
                            <button type="submit" class="w-full py-2.5 rounded-xl border border-slate-200 bg-white text-slate-600 hover:text-rose-600 hover:border-rose-200 hover:bg-rose-50 font-bold transition-all flex items-center justify-center gap-2">
                                <span class="material-symbols-outlined text-lg">cancel</span>
                                Reject Order
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>

        <!-- Right: Detail Items -->
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden min-h-[400px]">
                <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
                    <h3 class="text-slate-900 font-bold flex items-center gap-2">
                        <span class="material-symbols-outlined text-slate-400">list_alt</span>
                        Items & Kitchen Inventory Hub
                    </h3>
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">@Model.Items.Count Items Requested</span>
                </div>
                
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50/80">
                            <th class="px-6 py-3 text-xs font-bold text-slate-500 uppercase tracking-wider">Product</th>
                            <th class="px-6 py-3 text-xs font-bold text-slate-500 uppercase tracking-wider text-center">Requested</th>
                            <th class="px-6 py-3 text-xs font-bold text-slate-500 uppercase tracking-wider text-center">Kitchen Stock</th>
                            <th class="px-6 py-3 text-xs font-bold text-slate-500 uppercase tracking-wider text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var item in Model.Items)
                        {
                            <tr class="hover:bg-slate-50/50 transition-colors group">
                                <td class="px-6 py-4">
                                    <div class="flex flex-col">
                                        <span class="text-slate-900 font-bold group-hover:text-[#137fec] transition-colors">@item.ProductName</span>
                                        <span class="text-[10px] text-slate-400 font-medium">Internal SKU Identification</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-slate-100 text-slate-800 font-bold text-sm">
                                        @item.RequestedQuantity
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <div class="flex flex-col items-center">
                                        <span class="text-slate-600 font-bold text-sm">@item.AvailableQuantity</span>
                                        @{
                                            var pct = item.AvailableQuantity > 0 ? (Math.Min(100, (double)item.AvailableQuantity / item.RequestedQuantity * 100)) : 0;
                                            var barColor = pct >= 100 ? "bg-emerald-500" : (pct > 50 ? "bg-amber-500" : "bg-rose-500");
                                        }
                                        <div class="w-16 h-1 bg-slate-100 rounded-full mt-1.5 overflow-hidden">
                                            <div class="h-full @barColor transition-all duration-500" style="width: @pct%"></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    @if (item.IsSufficient)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-700 text-xs font-bold">
                                            <span class="material-symbols-outlined text-sm leading-none">check_circle</span>
                                            Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-rose-100 text-rose-700 text-xs font-bold">
                                            <span class="material-symbols-outlined text-sm leading-none">error_outline</span>
                                            Low Stock
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                
                @if (!Model.Items.Any())
                {
                    <div class="py-20 flex flex-col items-center justify-center text-slate-400 gap-4">
                        <span class="material-symbols-outlined text-6xl opacity-10">inventory_2</span>
                        <p class="text-sm font-medium">No items found for this order.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

