@page "{id:int}"
@model PresentationLayer_FranLink.Pages.Supply.InternalOrders.DetailsModel
@{
    ViewData["Title"] = "Review Internal Order";
}

<h1>Review Internal Order #@Model.Order.Id</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="card mb-3">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Store</dt>
            <dd class="col-sm-9">@Model.Order.FranchiseStore?.Name</dd>

            <dt class="col-sm-3">Kitchen</dt>
            <dd class="col-sm-9">@Model.Order.CentralKitchen?.Name</dd>

            <dt class="col-sm-3">Order Status</dt>
            <dd class="col-sm-9">@Model.Order.Status</dd>

            <dt class="col-sm-3">Delivery Status</dt>
            <dd class="col-sm-9">@Model.Order.Delivery?.DeliveryStatus ?? "N/A"</dd>

            <dt class="col-sm-3">Scheduled Date</dt>
            <dd class="col-sm-9">@Model.Order.Delivery?.ScheduledDate?.ToShortDateString() ?? "-"</dd>
        </dl>
    </div>
</div>

<h3>Items &amp; Kitchen Inventory</h3>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Product</th>
            <th>Requested Qty</th>
            <th>Available in Kitchen</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.RequestedQuantity</td>
                <td>@item.AvailableQuantity</td>
                <td>
                    @if (item.IsSufficient)
                    {
                        <span class="badge bg-success">OK</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Insufficient</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    @if (Model.Order.Status == "Pending")
    {
        if (Model.HasSufficientInventory)
        {
            <form method="post" asp-page-handler="Approve" asp-route-id="@Model.Order.Id" class="d-inline">
                <button type="submit" class="btn btn-success">Approve</button>
            </form>
        }
        else
        {
            <span class="text-danger me-2">Cannot approve: insufficient stock in kitchen.</span>
        }

        <form method="post" asp-page-handler="Cancel" asp-route-id="@Model.Order.Id" class="d-inline ms-1">
            <button type="submit" class="btn btn-outline-danger">Cancel</button>
        </form>
    }

    <a asp-page="Index" class="btn btn-secondary ms-2">Back to List</a>
</div>

