@page
@model PresentationLayer_FranLink.Pages.CentralKitchenStaff.ProductionPlanning.IndexModel
@{
    ViewData["Title"] = "Production Planning - Aggregated Demand";
}

<div class="container-fluid">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/CentralKitchenStaff/Index">Staff Dashboard</a></li>
            <li class="breadcrumb-item active">Production Planning</li>
        </ol>
    </nav>

    <h2><i class="bi bi-graph-up"></i> Production Planning - Aggregated Demand</h2>
    <p class="text-muted">Tổng hợp nhu cầu từ các đơn hàng Pending, Approved, Producing để lập kế hoạch sản xuất.</p>

    <form method="get" class="mb-4">
        <select asp-for="CentralKitchenId" asp-items="Model.CentralKitchens" class="form-select" style="width: auto;" onchange="this.form.submit()"></select>
    </form>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Demand by Product</span>
            <a asp-page="/Manager/Production/Start" class="btn btn-sm btn-success">Start Production</a>
        </div>
        <div class="card-body p-0">
            @if (Model.Demand.Any())
            {
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th class="text-center">Orders</th>
                            <th class="text-center">Demanded</th>
                            <th class="text-center">Available</th>
                            <th class="text-center">Shortage</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Demand)
                        {
                            var rowClass = item.ShortageQuantity > 0 ? "table-danger" : "";
                            <tr class="@rowClass">
                                <td><strong>@item.ProductName</strong></td>
                                <td><span class="badge bg-secondary">@(item.Category ?? "-")</span></td>
                                <td class="text-center">@item.OrderCount</td>
                                <td class="text-center">@item.TotalQuantityDemanded</td>
                                <td class="text-center">@item.AvailableInInventory</td>
                                <td class="text-center">
                                    @if (item.ShortageQuantity > 0)
                                    {
                                        <span class="badge bg-danger">@item.ShortageQuantity</span>
                                    }
                                    else
                                    {
                                        <span class="text-success">OK</span>
                                    }
                                </td>
                                <td>
                                    @if (item.ShortageQuantity > 0)
                                    {
                                        <a asp-page="/Manager/Production/Start" class="btn btn-sm btn-outline-success">Produce</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                    <p>No pending/approved orders. No demand to plan for.</p>
                </div>
            }
        </div>
    </div>
</div>
