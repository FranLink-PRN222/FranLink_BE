@page
@model PresentationLayer_FranLink.Pages.CentralKitchenStaff.IndexModel
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor httpContextAccessor
@{
    ViewData["Title"] = "Chef Dashboard";
    Layout = "_LayoutFranLink";
    var username = httpContextAccessor.HttpContext?.Session.GetString("Username") ?? "Chef";
}

<div class="flex-1 flex flex-col p-6 md:p-10 overflow-y-auto bg-slate-50/50">

    <!-- Kitchen Selector -->
    <div class="mb-6 flex items-center gap-4">
        <form method="get" class="flex items-center gap-3">
            <label class="text-sm font-semibold text-slate-600">Kitchen:</label>
            <select name="CentralKitchenId" asp-for="CentralKitchenId" asp-items="Model.CentralKitchens"
                    class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-800 shadow-sm focus:ring-2 focus:ring-[#137fec] focus:border-transparent outline-none"
                    onchange="this.form.submit()">
                <option value="">-- Select Kitchen --</option>
            </select>
        </form>
    </div>

    @if (!Model.CentralKitchenId.HasValue || Model.CentralKitchenId == 0)
    {
        <!-- Welcome state -->
        <div class="mb-8">
            <h2 class="text-slate-900 text-3xl font-extrabold tracking-tight mb-2">Welcome back, @username 👋</h2>
            <p class="text-slate-500 text-lg">Please select your assigned kitchen to begin today's operations.</p>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-12 flex flex-col items-center gap-3 text-slate-400 shadow-sm">
            <span class="material-symbols-outlined text-5xl">kitchen</span>
            <p class="font-semibold">No kitchen selected</p>
            <p class="text-sm">Select a Central Kitchen from the dropdown to load your operational hub.</p>
        </div>
    }
    else
    {
        <!-- Welcome Header -->
        <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h2 class="text-slate-900 text-3xl font-extrabold tracking-tight mb-2">Kitchen Execution & Supply</h2>
                <p class="text-slate-500 text-lg">Active kitchen: <span class="text-slate-900 font-bold">@Model.CentralKitchens.FirstOrDefault(x => x.Value == Model.CentralKitchenId.ToString())?.Text</span></p>
            </div>
            <div class="flex items-center gap-3">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-blue-50 text-xs font-semibold text-blue-700 border border-blue-100">
                    <span class="material-symbols-outlined text-sm">precision_manufacturing</span>
                    Production Ongoing
                </span>
            </div>
        </div>

        <!-- Section 1: Order Processing & Supply -->
        <section class="mb-10">
            <div class="flex items-center gap-2 mb-5">
                <span class="material-symbols-outlined text-amber-600">inbox</span>
                <h3 class="text-slate-900 text-xl font-bold tracking-tight">Order Processing</h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                <!-- Pending Orders -->
                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                    <p class="text-slate-500 text-xs font-bold uppercase tracking-wider mb-1">New Orders</p>
                    <p class="text-slate-900 text-3xl font-extrabold tracking-tight">@Model.PendingOrders</p>
                    <div class="mt-4 flex items-center justify-between border-t border-slate-50 pt-3">
                        <span class="text-xs text-amber-600 bg-amber-50 px-2 py-0.5 rounded font-bold">Awaiting Receipt</span>
                        <a asp-page="Orders/Index" asp-route-centralKitchenId="@Model.CentralKitchenId" asp-route-status="Pending"
                           class="text-xs text-[#137fec] font-bold hover:underline">Process Now →</a>
                    </div>
                </div>

                <!-- Active Shipments -->
                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                    <p class="text-slate-500 text-xs font-bold uppercase tracking-wider mb-1">Delivering</p>
                    <p class="text-slate-900 text-3xl font-extrabold tracking-tight">@Model.DeliveringOrders</p>
                    <div class="mt-4 flex items-center justify-between border-t border-slate-50 pt-3">
                        <span class="text-xs text-blue-600 bg-blue-50 px-2 py-0.5 rounded font-bold">In-Transit</span>
                        <a asp-page="Orders/Index" asp-route-centralKitchenId="@Model.CentralKitchenId" asp-route-status="Delivering"
                           class="text-xs text-[#137fec] font-bold hover:underline">Track →</a>
                    </div>
                </div>

                <!-- Quick Action: Materials -->
                <div class="bg-slate-900 p-6 rounded-xl shadow-lg flex flex-col justify-between">
                    <div>
                        <p class="text-slate-400 text-xs font-bold uppercase tracking-wider mb-1">Inventory Guard</p>
                        <h4 class="text-white font-bold">Check Materials</h4>
                    </div>
                    <a asp-page="Materials/Index" asp-route-centralKitchenId="@Model.CentralKitchenId"
                       class="mt-4 inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-white text-slate-900 text-xs font-bold hover:bg-slate-100 transition-colors">
                        <span class="material-symbols-outlined text-sm">inventory_2</span>
                        Manage Stock & Expiry
                    </a>
                </div>
            </div>
        </section>

        <!-- Section 2: Production Hub -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-10">
            <!-- Production Demand (Shortage) -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
                <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-rose-600 text-lg">warning_amber</span>
                        <h3 class="text-slate-900 font-bold">Production Demand</h3>
                    </div>
                    <a asp-page="ProductionPlanning/Index" asp-route-centralKitchenId="@Model.CentralKitchenId"
                       class="text-[#137fec] text-xs font-bold hover:underline">Planning View</a>
                </div>
                <div class="flex-1">
                    @if (Model.TopDemand.Any())
                    {
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50/30 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                    <th class="px-6 py-2">Product</th>
                                    <th class="px-6 py-2 text-center">Needed</th>
                                    <th class="px-6 py-2 text-center">Shortage</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var item in Model.TopDemand)
                                {
                                    <tr class="hover:bg-slate-50/50 transition-colors">
                                        <td class="px-6 py-3 text-sm font-semibold text-slate-900">@item.ProductName</td>
                                        <td class="px-6 py-3 text-sm text-center text-slate-600">@item.TotalQuantityDemanded</td>
                                        <td class="px-6 py-3 text-center">
                                            <span class="px-2 py-0.5 rounded-md text-[11px] font-bold bg-rose-50 text-rose-600">@item.ShortageQuantity</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="flex flex-col items-center gap-2 py-12 text-slate-400">
                            <span class="material-symbols-outlined text-3xl">task_alt</span>
                            <p class="text-sm font-medium">All demand satisfied.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Active Production Batches -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
                <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-emerald-600 text-lg">heat_pump</span>
                        <h3 class="text-slate-900 font-bold">Current Batches</h3>
                    </div>
                </div>
                <div class="flex-1">
                    @if (Model.InProgressProductions.Any())
                    {
                        <ul class="divide-y divide-slate-100">
                            @foreach (var p in Model.InProgressProductions)
                            {
                                <li class="flex items-center justify-between px-6 py-4 hover:bg-slate-50/50 transition-colors">
                                    <div>
                                        <p class="text-sm font-bold text-slate-900">@p.RecipeName</p>
                                        <div class="flex items-center gap-2 mt-0.5">
                                            <span class="text-[11px] font-medium text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded">Qty: @p.PlannedQuantity</span>
                                            <span class="text-[11px] text-slate-400 italic">Started @p.StartTime.ToLocalTime().ToString("HH:mm")</span>
                                        </div>
                                    </div>
                                    <a asp-page="/Production/Batch/Complete" asp-route-id="@p.ProductionId"
                                       class="ml-4 px-4 py-1.5 rounded-lg bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-700 transition-shadow shadow-md shadow-emerald-600/20">
                                        Finish
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="flex flex-col items-center gap-2 py-12 text-slate-400">
                            <span class="material-symbols-outlined text-3xl">restaurant_menu</span>
                            <p class="text-sm font-medium">No active productions.</p>
                            <a asp-page="/Manager/Production/Start" class="text-[#137fec] text-xs font-bold hover:underline mt-1">Start New Batch</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Quick Terminal -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8 bg-gradient-to-br from-white to-slate-50/50">
            <h3 class="text-slate-900 font-bold mb-6 flex items-center gap-2">
                <span class="size-2 rounded-full bg-blue-500"></span>
                Operational Actions
            </h3>
            <div class="flex flex-wrap gap-4">
                <a asp-page="Orders/Index" asp-route-centralKitchenId="@Model.CentralKitchenId"
                   class="flex flex-col items-center bg-white border border-slate-200 p-5 rounded-2xl w-40 hover:border-blue-500 hover:shadow-lg hover:shadow-blue-500/10 transition-all group">
                    <div class="p-3 bg-blue-50 text-blue-600 rounded-xl mb-3 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined">inbox</span>
                    </div>
                    <span class="text-sm font-bold text-slate-800">Process Orders</span>
                </a>
                
                <a asp-page="ProductionPlanning/Index" asp-route-centralKitchenId="@Model.CentralKitchenId"
                        class="flex flex-col items-center bg-white border border-slate-200 p-5 rounded-2xl w-40 hover:border-emerald-500 hover:shadow-lg hover:shadow-emerald-500/10 transition-all group">
                    <div class="p-3 bg-emerald-50 text-emerald-600 rounded-xl mb-3 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined">event_note</span>
                    </div>
                    <span class="text-sm font-bold text-slate-800">Planning</span>
                </a>

                <a asp-page="Materials/Index" asp-route-centralKitchenId="@Model.CentralKitchenId"
                        class="flex flex-col items-center bg-white border border-slate-200 p-5 rounded-2xl w-40 hover:border-amber-500 hover:shadow-lg hover:shadow-amber-500/10 transition-all group">
                    <div class="p-3 bg-amber-50 text-amber-600 rounded-xl mb-3 group-hover:bg-amber-600 group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined">hourglass_top</span>
                    </div>
                    <span class="text-sm font-bold text-slate-800">Expiry Watch</span>
                </a>

                <a asp-page="/Production/Batch/Start"
                        class="flex flex-col items-center bg-white border border-slate-200 p-5 rounded-2xl w-40 hover:border-indigo-500 hover:shadow-lg hover:shadow-indigo-500/10 transition-all group">
                    <div class="p-3 bg-indigo-50 text-indigo-600 rounded-xl mb-3 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined">add_circle</span>
                    </div>
                    <span class="text-sm font-bold text-slate-800">New Production</span>
                </a>
            </div>
        </div>
    }
</div>
