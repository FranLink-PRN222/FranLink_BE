@page
@model PresentationLayer_FranLink.Pages.CentralKitchenStaff.IndexModel
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor httpContextAccessor
@{
    ViewData["Title"] = "Chef Dashboard";
    Layout = "_LayoutFranLink";
    var username = httpContextAccessor.HttpContext?.Session.GetString("Username") ?? "Chef";
}

<div class="flex-1 flex flex-col p-6 md:p-10 overflow-y-auto bg-slate-50/50">

    <!-- Kitchen Selector -->
    <div class="mb-6 flex items-center gap-4">
        <form method="get" class="flex items-center gap-3">
            <label class="text-sm font-semibold text-slate-600">Kitchen:</label>
            <select name="CentralKitchenId" asp-for="CentralKitchenId" asp-items="Model.CentralKitchens"
                    class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-800 shadow-sm focus:ring-2 focus:ring-[#137fec] focus:border-transparent outline-none"
                    onchange="this.form.submit()">
                <option value="">-- Select Kitchen --</option>
            </select>
        </form>
    </div>

    @if (!Model.CentralKitchenId.HasValue || Model.CentralKitchenId == 0)
    {
        <!-- Welcome state -->
        <div class="mb-8">
            <h2 class="text-slate-900 text-3xl font-extrabold tracking-tight mb-2">Welcome back, @username 👋</h2>
            <p class="text-slate-500 text-lg">Please select a kitchen above to see today's operational overview.</p>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-12 flex flex-col items-center gap-3 text-slate-400 shadow-sm">
            <span class="material-symbols-outlined text-5xl">kitchen</span>
            <p class="font-semibold">No kitchen selected</p>
            <p class="text-sm">Select a Central Kitchen from the dropdown to load your dashboard.</p>
        </div>
    }
    else
    {
        <!-- Welcome Header -->
        <div class="mb-8">
            <h2 class="text-slate-900 text-3xl font-extrabold tracking-tight mb-2">Welcome back, @username 👋</h2>
            <p class="text-slate-500 text-lg">Here's a snapshot of what's heating up in your kitchen today.</p>
        </div>

        <!-- KPI Cards -->
        <section class="mb-10">
            <div class="flex items-center justify-between mb-5">
                <h3 class="text-slate-900 text-xl font-bold tracking-tight">Operational Overview</h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">

                <!-- Pending Orders -->
                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                    <div class="flex items-center justify-between mb-4">
                        <div class="p-2.5 bg-amber-50 rounded-lg text-amber-600">
                            <span class="material-symbols-outlined">pending_actions</span>
                        </div>
                        <span class="text-amber-500 text-xs font-bold bg-amber-50 px-2 py-1 rounded-full">Urgent</span>
                    </div>
                    <p class="text-slate-500 text-sm font-semibold uppercase tracking-wider mb-1">Pending Orders</p>
                    <p class="text-slate-900 text-3xl font-extrabold tracking-tight">@Model.PendingOrders</p>
                    <a asp-page="Orders/Index" asp-route-centralKitchenId="@Model.CentralKitchenId" asp-route-status="Pending"
                       class="mt-3 inline-flex text-xs text-[#137fec] font-bold hover:underline">View & Process →</a>
                </div>

                <!-- Preparing -->
                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                    <div class="flex items-center justify-between mb-4">
                        <div class="p-2.5 bg-blue-50 rounded-lg text-blue-600">
                            <span class="material-symbols-outlined">kitchen</span>
                        </div>
                        <span class="text-blue-500 text-xs font-bold bg-blue-50 px-2 py-1 rounded-full">In Progress</span>
                    </div>
                    <p class="text-slate-500 text-sm font-semibold uppercase tracking-wider mb-1">Preparing</p>
                    <p class="text-slate-900 text-3xl font-extrabold tracking-tight">@Model.PreparingOrders</p>
                    <a asp-page="Orders/Index" asp-route-centralKitchenId="@Model.CentralKitchenId" asp-route-status="Approved"
                       class="mt-3 inline-flex text-xs text-[#137fec] font-bold hover:underline">View →</a>
                </div>

                <!-- Delivering -->
                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                    <div class="flex items-center justify-between mb-4">
                        <div class="p-2.5 bg-emerald-50 rounded-lg text-emerald-600">
                            <span class="material-symbols-outlined">local_shipping</span>
                        </div>
                        <span class="text-emerald-500 text-xs font-bold bg-emerald-50 px-2 py-1 rounded-full">Active</span>
                    </div>
                    <p class="text-slate-500 text-sm font-semibold uppercase tracking-wider mb-1">Delivering</p>
                    <p class="text-slate-900 text-3xl font-extrabold tracking-tight">@Model.DeliveringOrders</p>
                    <a asp-page="Orders/Index" asp-route-centralKitchenId="@Model.CentralKitchenId" asp-route-status="Delivering"
                       class="mt-3 inline-flex text-xs text-[#137fec] font-bold hover:underline">View →</a>
                </div>
            </div>
        </section>

        <!-- Two-column section -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">

            <!-- Production Shortage -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
                    <h3 class="text-slate-900 font-bold">Production Shortage</h3>
                    <a asp-page="ProductionPlanning/Index" asp-route-centralKitchenId="@Model.CentralKitchenId"
                       class="text-[#137fec] text-sm font-semibold hover:underline">Full Report</a>
                </div>
                @if (Model.TopDemand.Any())
                {
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 text-xs font-bold text-slate-500 uppercase tracking-wider">
                                <th class="px-6 py-3">Product</th>
                                <th class="px-6 py-3 text-center">Demanded</th>
                                <th class="px-6 py-3 text-center">Available</th>
                                <th class="px-6 py-3 text-center">Shortage</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var item in Model.TopDemand)
                            {
                                <tr class="hover:bg-slate-50/50 transition-colors">
                                    <td class="px-6 py-3 text-sm font-semibold text-slate-900">@item.ProductName</td>
                                    <td class="px-6 py-3 text-sm text-center text-slate-600">@item.TotalQuantityDemanded</td>
                                    <td class="px-6 py-3 text-sm text-center text-slate-600">@item.AvailableInInventory</td>
                                    <td class="px-6 py-3 text-center">
                                        <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-rose-100 text-rose-700">@item.ShortageQuantity</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="flex flex-col items-center gap-2 py-10 text-slate-400">
                        <span class="material-symbols-outlined text-3xl">check_circle</span>
                        <p class="text-sm">No shortage. Inventory meets demand.</p>
                    </div>
                }
            </div>

            <!-- In-Progress Productions -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
                    <h3 class="text-slate-900 font-bold">In-Progress Productions</h3>
                    <a asp-page="/Manager/Production/Index" asp-route-centralKitchenId="@Model.CentralKitchenId"
                       class="text-[#137fec] text-sm font-semibold hover:underline">Manage</a>
                </div>
                @if (Model.InProgressProductions.Any())
                {
                    <ul class="divide-y divide-slate-100">
                        @foreach (var p in Model.InProgressProductions)
                        {
                            <li class="flex items-center justify-between px-6 py-4 hover:bg-slate-50/50 transition-colors">
                                <div>
                                    <p class="text-sm font-bold text-slate-900">@p.RecipeName — @p.ProductName</p>
                                    <p class="text-xs text-slate-500 mt-0.5">Qty: @p.PlannedQuantity &nbsp;·&nbsp; Started: @p.StartTime.ToLocalTime().ToString("HH:mm")</p>
                                </div>
                                <a asp-page="/Manager/Production/Complete" asp-route-id="@p.ProductionId"
                                   class="ml-4 px-3 py-1.5 rounded-lg bg-emerald-100 text-emerald-700 text-xs font-bold hover:bg-emerald-200 transition-colors">
                                    Complete
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="flex flex-col items-center gap-2 py-10 text-slate-400">
                        <span class="material-symbols-outlined text-3xl">hourglass_empty</span>
                        <p class="text-sm">No productions in progress.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
            <h3 class="text-slate-900 font-bold mb-4">Quick Actions</h3>
            <div class="flex flex-wrap gap-3">
                <a asp-page="Orders/Index" asp-route-centralKitchenId="@Model.CentralKitchenId"
                   class="flex items-center gap-2 px-5 py-3 rounded-xl bg-[#137fec] text-white text-sm font-bold hover:bg-[#137fec]/90 transition-colors shadow-sm shadow-[#137fec]/30">
                    <span class="material-symbols-outlined text-lg">inbox</span>
                    Process Orders
                </a>
                <a asp-page="ProductionPlanning/Index" asp-route-centralKitchenId="@Model.CentralKitchenId"
                   class="flex items-center gap-2 px-5 py-3 rounded-xl bg-blue-100 text-blue-700 text-sm font-bold hover:bg-blue-200 transition-colors">
                    <span class="material-symbols-outlined text-lg">insights</span>
                    Production Planning
                </a>
                <a asp-page="Materials/Index" asp-route-centralKitchenId="@Model.CentralKitchenId"
                   class="flex items-center gap-2 px-5 py-3 rounded-xl bg-amber-100 text-amber-700 text-sm font-bold hover:bg-amber-200 transition-colors">
                    <span class="material-symbols-outlined text-lg">inventory_2</span>
                    Materials & Expiry
                </a>
                <a asp-page="/Manager/Production/Start"
                   class="flex items-center gap-2 px-5 py-3 rounded-xl bg-emerald-100 text-emerald-700 text-sm font-bold hover:bg-emerald-200 transition-colors">
                    <span class="material-symbols-outlined text-lg">play_arrow</span>
                    Start Production
                </a>
            </div>
        </div>
    }
</div>
