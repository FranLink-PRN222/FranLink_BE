@page
@model PresentationLayer_FranLink.Pages.Manager.Distribution.IndexModel
@{
    ViewData["Title"] = "Distribution Dashboard";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🚚 Distribution Dashboard</h2>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">From Date</label>
                    <input asp-for="FromDate" type="date" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">To Date</label>
                    <input asp-for="ToDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Central Kitchen</label>
                    <select asp-for="CentralKitchenId" asp-items="Model.CentralKitchens" class="form-select">
                        <option value="">-- All Kitchens --</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary">Apply Filter</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="card text-white bg-primary h-100">
                <div class="card-body text-center">
                    <h6>Total Orders</h6>
                    <h2>@Model.Summary.TotalOrders</h2>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-white bg-success h-100">
                <div class="card-body text-center">
                    <h6>Completed</h6>
                    <h2>@Model.Summary.CompletedOrders</h2>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-dark bg-warning h-100">
                <div class="card-body text-center">
                    <h6>Pending</h6>
                    <h2>@Model.Summary.PendingOrders</h2>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-white bg-info h-100">
                <div class="card-body text-center">
                    <h6>Delivering</h6>
                    <h2>@Model.Summary.DeliveringOrders</h2>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-white bg-danger h-100">
                <div class="card-body text-center">
                    <h6>Cancelled</h6>
                    <h2>@Model.Summary.CancelledOrders</h2>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-white bg-secondary h-100">
                <div class="card-body text-center">
                    <h6>Fulfillment Rate</h6>
                    <h2>@Model.Summary.OrderFulfillmentRate%</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Value Stats -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-primary">
                <div class="card-body">
                    <h5 class="text-muted">Total Order Value</h5>
                    <h2 class="text-primary">@Model.Summary.TotalValue.ToString("N0") VND</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-info">
                <div class="card-body">
                    <h5 class="text-muted">Average Order Value</h5>
                    <h2 class="text-info">@Model.Summary.AverageOrderValue.ToString("N0") VND</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-success">
                <div class="card-body">
                    <h5 class="text-muted">Avg Delivery Time</h5>
                    <h2 class="text-success">@Model.DeliveryStats.AverageDeliveryTimeHours hours</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Top Stores -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">🏪 Top Stores by Value</h5>
                    <a asp-page="ByStore" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.TopStores.Any())
                    {
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Store</th>
                                    <th class="text-center">Orders</th>
                                    <th class="text-end">Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var store in Model.TopStores)
                                {
                                    <tr>
                                        <td>
                                            <strong>@store.StoreName</strong><br />
                                            <small class="text-muted">@store.StoreAddress</small>
                                        </td>
                                        <td class="text-center">@store.OrderCount</td>
                                        <td class="text-end">@store.TotalValue.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">No data available</div>
                    }
                </div>
            </div>
        </div>

        <!-- Top Products -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">📦 Top Products Distributed</h5>
                    <a asp-page="ByProduct" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.TopProducts.Any())
                    {
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th class="text-center">Qty Ordered</th>
                                    <th class="text-center">Qty Delivered</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var product in Model.TopProducts)
                                {
                                    <tr>
                                        <td>
                                            <strong>@product.ProductName</strong><br />
                                            <small class="text-muted">@product.Category</small>
                                        </td>
                                        <td class="text-center">@product.TotalQuantityOrdered</td>
                                        <td class="text-center">
                                            <span class="badge bg-success">@product.TotalQuantityDelivered</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">No data available</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Daily Distribution Chart Data -->
    @if (Model.Summary.ByDay.Any())
    {
        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0">📅 Daily Distribution</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th class="text-center">Orders</th>
                            <th class="text-end">Total Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in Model.Summary.ByDay.OrderByDescending(d => d.Date).Take(10))
                        {
                            <tr>
                                <td>@day.Date.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">@day.OrderCount</td>
                                <td class="text-end">@day.TotalValue.ToString("N0") VND</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
