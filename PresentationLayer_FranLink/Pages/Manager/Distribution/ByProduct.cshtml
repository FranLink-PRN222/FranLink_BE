@page
@model PresentationLayer_FranLink.Pages.Manager.Distribution.ByProductModel
@{
    ViewData["Title"] = "Distribution by Product";
}

<div class="container-fluid">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="Index">Distribution</a></li>
            <li class="breadcrumb-item active">By Product</li>
        </ol>
    </nav>

    <h2>📦 Distribution by Product</h2>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">From Date</label>
                    <input asp-for="FromDate" type="date" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">To Date</label>
                    <input asp-for="ToDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Central Kitchen</label>
                    <select asp-for="CentralKitchenId" asp-items="Model.CentralKitchens" class="form-select">
                        <option value="">-- All Kitchens --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Category</label>
                    <select asp-for="Category" class="form-select">
                        <option value="">-- All Categories --</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary">Apply Filter</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Results -->
    <div class="card">
        <div class="card-header">
            <span>Found @Model.Products.Count product(s)</span>
        </div>
        <div class="card-body p-0">
            @if (Model.Products.Any())
            {
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th class="text-center">Orders</th>
                            <th class="text-center">Qty Ordered</th>
                            <th class="text-center">Qty Delivered</th>
                            <th class="text-center">Delivery Rate</th>
                            <th class="text-end">Total Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Products)
                        {
                            var deliveryRate = product.TotalQuantityOrdered > 0
                                ? Math.Round((decimal)product.TotalQuantityDelivered / product.TotalQuantityOrdered * 100, 1)
                                : 0;
                            var rateClass = deliveryRate >= 90 ? "bg-success"
                                : deliveryRate >= 70 ? "bg-warning text-dark"
                                : "bg-danger";
                            <tr>
                                <td><strong>@product.ProductName</strong></td>
                                <td><span class="badge bg-secondary">@product.Category</span></td>
                                <td class="text-center">@product.OrderCount</td>
                                <td class="text-center">@product.TotalQuantityOrdered</td>
                                <td class="text-center">@product.TotalQuantityDelivered</td>
                                <td class="text-center">
                                    <span class="badge @rateClass">@deliveryRate%</span>
                                </td>
                                <td class="text-end">@product.TotalValue.ToString("N0") VND</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-secondary">
                        <tr>
                            <th colspan="2">Total</th>
                            <th class="text-center">-</th>
                            <th class="text-center">@Model.Products.Sum(p => p.TotalQuantityOrdered)</th>
                            <th class="text-center">@Model.Products.Sum(p => p.TotalQuantityDelivered)</th>
                            <th></th>
                            <th class="text-end">@Model.Products.Sum(p => p.TotalValue).ToString("N0") VND</th>
                        </tr>
                    </tfoot>
                </table>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                    <p>No product distribution data found for the selected criteria.</p>
                </div>
            }
        </div>
    </div>
</div>
