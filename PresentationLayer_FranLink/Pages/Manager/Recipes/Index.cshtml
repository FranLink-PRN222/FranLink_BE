@page
@model PresentationLayer_FranLink.Pages.Manager.Recipes.IndexModel
@{
    ViewData["Title"] = "Recipe Management";
    Layout = "_LayoutFranLink";
}

<div class="max-w-[1280px] mx-auto w-full px-4 md:px-8 py-8 flex flex-col gap-8">

    <!-- Hero Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-2">
        <div class="flex flex-col gap-3">
            <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900">
                Formula Repository
            </h1>
            <p class="text-slate-500 text-sm md:text-lg max-w-2xl">
                Maintain production standards, define <span class="text-[#137fec] font-bold">Bills of Materials</span>, and optimize ingredient utilization across the network.
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-page="Create" class="px-8 py-4 rounded-2xl bg-slate-900 text-white text-sm font-black shadow-2xl shadow-slate-900/20 hover:bg-slate-800 hover:-translate-y-1 transition-all flex items-center gap-3 group">
                <span class="material-symbols-outlined text-xl group-hover:rotate-90 transition-transform">add</span>
                Engine New Formula
            </a>
        </div>
    </div>

    <!-- Stats Bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-2xl border border-slate-200 flex flex-col gap-1 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Live Recipes</span>
            <span class="text-2xl font-black text-slate-900">@Model.Recipes.Count(r => r.IsActive)</span>
        </div>
        <div class="bg-white p-5 rounded-2xl border border-slate-200 flex flex-col gap-1 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Inactive Vault</span>
            <span class="text-2xl font-black text-slate-400">@Model.Recipes.Count(r => !r.IsActive)</span>
        </div>
        <div class="bg-white p-5 rounded-2xl border border-slate-200 flex flex-col gap-1 shadow-sm border-l-4 border-l-[#137fec]">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Global Output</span>
            <span class="text-2xl font-black text-[#137fec]">@Model.Recipes.Sum(r => r.OutputQuantity).ToString("N0")</span>
        </div>
        <div class="bg-white p-5 rounded-2xl border border-slate-200 flex flex-col gap-1 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Efficiency</span>
            <span class="text-2xl font-black text-emerald-500">98.2%</span>
        </div>
    </div>

    <!-- Control Center -->
    <section class="bg-white/80 backdrop-blur-md border border-slate-200 rounded-2xl p-4 flex flex-col md:flex-row items-center justify-between gap-4 sticky top-4 z-20 shadow-xl shadow-slate-900/5">
        <div class="flex items-center gap-4 w-full md:w-auto">
            <div class="relative flex-1 md:w-72">
                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">search</span>
                <input type="text" placeholder="Search formulas..." class="w-full pl-12 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-4 focus:ring-[#137fec]/10 focus:border-[#137fec] transition-all" />
            </div>
            <form method="get" class="flex items-center gap-3">
                <div class="flex items-center gap-2 group cursor-pointer h-full px-4 py-3 rounded-xl hover:bg-slate-50 transition-all">
                    <input asp-for="ShowInactive" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-[#137fec] focus:ring-[#137fec]" onchange="this.form.submit()" />
                    <label asp-for="ShowInactive" class="text-sm font-bold text-slate-600 cursor-pointer">Archive</label>
                </div>
            </form>
        </div>
        <div class="flex items-center gap-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
            <span class="material-symbols-outlined text-sm">sort</span>
            Chronological Order
        </div>
    </section>

    <!-- Formula Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        @foreach (var recipe in Model.Recipes)
        {
            <div class="group bg-white rounded-3xl border border-slate-200 shadow-sm hover:shadow-2xl hover:shadow-slate-900/10 hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col">
                <div class="p-6 flex flex-col gap-6 flex-1">
                    <!-- Card Header -->
                    <div class="flex justify-between items-start gap-4">
                        <div class="size-12 rounded-2xl bg-slate-50 flex items-center justify-center group-hover:bg-[#137fec]/10 transition-colors">
                            <span class="material-symbols-outlined text-[#137fec] text-2xl">experiment</span>
                        </div>
                        @if (recipe.IsActive)
                        {
                            <span class="px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-600 text-[10px] font-black uppercase tracking-widest border border-emerald-100">Active</span>
                        }
                        else
                        {
                            <span class="px-2.5 py-1 rounded-lg bg-slate-100 text-slate-400 text-[10px] font-black uppercase tracking-widest border border-slate-200">Vaulted</span>
                        }
                    </div>

                    <!-- Title & Product -->
                    <div class="flex flex-col gap-1">
                        <h3 class="text-lg font-black text-slate-900 group-hover:text-[#137fec] transition-colors">@recipe.Name</h3>
                        <p class="text-xs font-bold text-slate-400 flex items-center gap-1.5 uppercase tracking-tight">
                            Target: <span class="text-slate-600">@recipe.Product?.Name</span>
                        </p>
                    </div>

                    <!-- Visual Metrics -->
                    <div class="grid grid-cols-2 gap-3 py-4 border-y border-slate-50">
                        <div class="flex flex-col gap-0.5">
                            <span class="text-[9px] font-bold text-slate-400 uppercase">Yield</span>
                            <p class="text-sm font-black text-slate-900">@recipe.OutputQuantity <span class="text-[10px] font-bold text-slate-400">@recipe.Product?.Unit</span></p>
                        </div>
                        <div class="flex flex-col gap-0.5">
                            <span class="text-[9px] font-bold text-slate-400 uppercase">Time</span>
                            <p class="text-sm font-black text-slate-900">@recipe.EstimatedTime <span class="text-[10px] font-bold text-slate-400">Min</span></p>
                        </div>
                    </div>

                    <!-- Ingredients Preview -->
                    <div class="flex flex-col gap-3 pt-2">
                        <h4 class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Key Components</h4>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var item in recipe.RecipeItems.Take(4))
                            {
                                <span class="px-2 py-1 rounded-lg bg-slate-50 text-[10px] font-bold text-slate-600 border border-slate-100 italic">
                                    @item.IngredientProduct?.Name
                                </span>
                            }
                            @if (recipe.RecipeItems.Count > 4)
                            {
                                <span class="px-2 py-1 rounded-lg bg-[#137fec]/5 text-[#137fec] text-[10px] font-black italic">+@(recipe.RecipeItems.Count - 4) more</span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Footer Actions -->
                <div class="px-6 py-4 bg-slate-50/50 border-t border-slate-100 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <a asp-page="Details" asp-route-id="@recipe.RecipeId" class="size-9 rounded-xl border border-slate-200 flex items-center justify-center hover:bg-white hover:text-[#137fec] hover:border-[#137fec] transition-all" title="View Details">
                            <span class="material-symbols-outlined text-lg">visibility</span>
                        </a>
                        <a asp-page="Edit" asp-route-id="@recipe.RecipeId" class="size-9 rounded-xl border border-slate-200 flex items-center justify-center hover:bg-white hover:text-amber-600 hover:border-amber-600 transition-all" title="Edit Formula">
                            <span class="material-symbols-outlined text-lg">edit</span>
                        </a>
                    </div>
                    @if (recipe.IsActive)
                    {
                        <form method="post" asp-page-handler="Delete" asp-route-id="@recipe.RecipeId" onsubmit="return confirm('Archive this standard formula?');">
                            <button type="submit" class="px-4 py-2 rounded-xl text-rose-600 text-xs font-black uppercase tracking-widest hover:bg-rose-50 transition-all">
                                Disable
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Empty State -->
    @if (!Model.Recipes.Any())
    {
        <div class="flex flex-col items-center justify-center py-24 gap-6 bg-white rounded-[40px] border border-dashed border-slate-200 shadow-inner">
            <div class="size-24 rounded-full bg-slate-50 flex items-center justify-center text-slate-200">
                <span class="material-symbols-outlined text-5xl">menu_book</span>
            </div>
            <div class="text-center">
                <h3 class="text-xl font-black text-slate-900 mb-2">The Vault is Empty</h3>
                <p class="text-slate-500 text-sm max-w-xs">No formulas match your current filter. Try relaxing your search or create a new one.</p>
            </div>
            <a asp-page="Create" class="px-8 py-4 rounded-2xl bg-[#137fec] text-white text-sm font-black shadow-xl shadow-[#137fec]/20 hover:bg-[#137fec]/90 transition-all">
                Create First Formula
            </a>
        </div>
    }
</div>
