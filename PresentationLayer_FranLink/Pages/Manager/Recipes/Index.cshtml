@page
@model PresentationLayer_FranLink.Pages.Manager.Recipes.IndexModel
@{
    ViewData["Title"] = "Recipe Management";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-journal-text me-2"></i>Recipe Management</h2>
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Create New Recipe
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="ShowInactive" />
                        <label class="form-check-label" asp-for="ShowInactive">Show Inactive Recipes</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-funnel me-1"></i>Apply
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Recipes Grid -->
    @if (Model.Recipes.Any())
    {
        <div class="row">
            @foreach (var recipe in Model.Recipes)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 @(recipe.IsActive ? "" : "border-secondary")">
                        <div class="card-header d-flex justify-content-between align-items-center @(recipe.IsActive ? "bg-light" : "bg-secondary text-white")">
                            <h6 class="mb-0">@recipe.Name</h6>
                            @if (recipe.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-dark">Inactive</span>
                            }
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                <small class="text-muted">Output Product:</small><br />
                                <strong>@recipe.Product?.Name</strong>
                            </div>
                            <div class="row mb-2">
                                <div class="col-6">
                                    <small class="text-muted">Output Qty:</small><br />
                                    <span>@recipe.OutputQuantity</span>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted">Est. Time:</small><br />
                                    <span>@recipe.EstimatedTime min</span>
                                </div>
                            </div>
                            <div class="mb-2">
                                <small class="text-muted">Ingredients:</small><br />
                                @if (recipe.RecipeItems.Any())
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var item in recipe.RecipeItems.Take(3))
                                        {
                                            <li><i class="bi bi-dot"></i>@item.IngredientProduct?.Name - @item.Quantity @item.Unit</li>
                                        }
                                        @if (recipe.RecipeItems.Count > 3)
                                        {
                                            <li class="text-muted"><i class="bi bi-three-dots"></i> +@(recipe.RecipeItems.Count - 3) more</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">No ingredients defined</span>
                                }
                            </div>
                        </div>
                        <div class="card-footer">
                            <a asp-page="Details" asp-route-id="@recipe.RecipeId" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye"></i> View
                            </a>
                            <a asp-page="Edit" asp-route-id="@recipe.RecipeId" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            @if (recipe.IsActive)
                            {
                                <form method="post" asp-page-handler="Delete" asp-route-id="@recipe.RecipeId" class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to deactivate this recipe?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="mt-3">
            <small class="text-muted">Showing @Model.Recipes.Count recipe(s)</small>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-journal-x display-1 text-muted"></i>
            <p class="mt-3 text-muted">No recipes found.</p>
            <a asp-page="Create" class="btn btn-primary">Create First Recipe</a>
        </div>
    }
</div>
