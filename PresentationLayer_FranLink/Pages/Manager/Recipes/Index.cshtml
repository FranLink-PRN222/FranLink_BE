@page
@model PresentationLayer_FranLink.Pages.Manager.Recipes.IndexModel
@{
    ViewData["Title"] = "Recipe Management";
    Layout = "_LayoutFranLink";
}

<div class="max-w-[1280px] mx-auto w-full px-4 md:px-8 py-8 flex flex-col gap-6">

    <!-- Header -->
    <section class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Recipes & BOM</h1>
            <p class="text-slate-500 text-sm md:text-base mt-1">
                Define production recipes, output quantities and ingredient bills of materials for each product.
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <a asp-page="Create"
               class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#137fec] text-white text-sm font-bold shadow-md hover:bg-[#137fec]/90 transition-colors">
                <span class="material-symbols-outlined text-lg">receipt_long</span>
                <span>Create Recipe</span>
            </a>
        </div>
    </section>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 flex items-start gap-2">
            <span class="material-symbols-outlined text-base mt-0.5">check_circle</span>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    <!-- Filters -->
    <section class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm flex items-center justify-between gap-3">
        <div class="flex items-center gap-2">
            <input asp-for="ShowInactive"
                   type="checkbox"
                   class="h-4 w-4 rounded border-slate-300 text-[#137fec] focus:ring-[#137fec]" />
            <label asp-for="ShowInactive" class="text-sm text-slate-600">Show inactive recipes</label>
        </div>
        <button type="submit"
                formmethod="get"
                class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 text-white text-sm font-semibold px-4 py-2 hover:bg-slate-800 transition-colors">
            <span class="material-symbols-outlined text-base">filter_alt</span>
            Apply
        </button>
    </section>

    <!-- Recipes grid -->
    <section class="flex flex-col gap-4">
        @if (Model.Recipes.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var recipe in Model.Recipes)
                {
                    var statusBg = recipe.IsActive ? "bg-emerald-50 border-emerald-100" : "bg-slate-50 border-slate-200";
                    var statusChipBg = recipe.IsActive ? "bg-emerald-100 text-emerald-700" : "bg-slate-200 text-slate-700";
                    var statusText = recipe.IsActive ? "Active" : "Inactive";

                    <article class="border rounded-xl @statusBg shadow-sm flex flex-col">
                        <header class="px-4 py-3 border-b border-slate-100 flex items-start justify-between gap-3">
                            <div class="flex flex-col gap-1">
                                <h2 class="text-sm font-semibold text-slate-900 line-clamp-2">@recipe.Name</h2>
                                <p class="text-xs text-slate-400">
                                    Output: <span class="font-semibold text-slate-700">@recipe.OutputQuantity</span>
                                    @recipe.Product?.Unit
                                </p>
                            </div>
                            <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-[11px] font-bold @statusChipBg">
                                <span class="size-1.5 rounded-full @(recipe.IsActive ? "bg-emerald-500" : "bg-slate-500")"></span>
                                @statusText
                            </span>
                        </header>
                        <div class="px-4 py-3 flex-1 flex flex-col gap-2">
                            <div>
                                <p class="text-[11px] font-semibold text-slate-500 uppercase">Output product</p>
                                <p class="text-sm text-slate-800">
                                    @recipe.Product?.Name
                                </p>
                            </div>
                            <div class="flex items-center justify-between text-xs text-slate-500">
                                <span class="inline-flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[16px] text-slate-400">timer</span>
                                    @recipe.EstimatedTime min
                                </span>
                                <span class="inline-flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[16px] text-slate-400">list_alt</span>
                                    @recipe.RecipeItems.Count ingredients
                                </span>
                            </div>
                            <div class="mt-1">
                                <p class="text-[11px] font-semibold text-slate-500 uppercase mb-1">Key ingredients</p>
                                @if (recipe.RecipeItems.Any())
                                {
                                    <ul class="space-y-1">
                                        @foreach (var item in recipe.RecipeItems.Take(3))
                                        {
                                            <li class="flex items-center justify-between text-xs text-slate-600">
                                                <span class="truncate">@item.IngredientProduct?.Name</span>
                                                <span class="ml-2 text-slate-400">@item.Quantity @item.Unit</span>
                                            </li>
                                        }
                                        @if (recipe.RecipeItems.Count > 3)
                                        {
                                            <li class="text-[11px] text-slate-400">+@(recipe.RecipeItems.Count - 3) more ingredients</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="text-xs text-slate-400 italic">No ingredients defined</p>
                                }
                            </div>
                        </div>
                        <footer class="px-4 py-3 border-t border-slate-100 flex items-center justify-between text-xs">
                            <div class="flex items-center gap-2">
                                <a asp-page="Details" asp-route-id="@recipe.RecipeId"
                                   class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50">
                                    <span class="material-symbols-outlined text-sm">visibility</span>
                                    View
                                </a>
                                <a asp-page="Edit" asp-route-id="@recipe.RecipeId"
                                   class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50">
                                    <span class="material-symbols-outlined text-sm">edit</span>
                                    Edit
                                </a>
                            </div>
                            @if (recipe.IsActive)
                            {
                                <form method="post"
                                      asp-page-handler="Delete"
                                      asp-route-id="@recipe.RecipeId"
                                      class="inline"
                                      onsubmit="return confirm('Deactivate this recipe?');">
                                    <button type="submit"
                                            class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-[11px] font-semibold text-rose-700 bg-rose-50 hover:bg-rose-100">
                                        <span class="material-symbols-outlined text-sm">block</span>
                                        Disable
                                    </button>
                                </form>
                            }
                        </footer>
                    </article>
                }
            </div>
            <div class="px-1 text-xs text-slate-500 flex items-center justify-between">
                <span>Showing <span class="font-semibold text-slate-900">@Model.Recipes.Count</span> recipes</span>
                <span class="inline-flex items-center gap-1">
                    <span class="material-symbols-outlined text-[14px]">factory</span>
                    Used in production planning
                </span>
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center py-16 text-slate-400 gap-3">
                <span class="material-symbols-outlined text-5xl">menu_book</span>
                <p class="text-sm font-medium">No recipes found.</p>
                <a asp-page="Create"
                   class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#137fec] text-white text-sm font-bold shadow-md hover:bg-[#137fec]/90 transition-colors">
                    <span class="material-symbols-outlined text-lg">add</span>
                    Create first recipe
                </a>
            </div>
        }
    </section>
</div>
