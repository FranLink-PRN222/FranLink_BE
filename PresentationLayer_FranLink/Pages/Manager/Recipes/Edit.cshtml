@page "{id:int}"
@model PresentationLayer_FranLink.Pages.Manager.Recipes.EditModel
@{
    ViewData["Title"] = "Edit Recipe";
    Layout = "_LayoutFranLink";
}

<div class="max-w-[1280px] mx-auto w-full px-4 md:px-8 py-8 flex flex-col gap-8">
    
    <!-- Header Area -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div class="flex flex-col gap-2">
            <nav class="flex items-center gap-2 text-xs font-bold text-slate-400 uppercase tracking-widest">
                <a asp-page="Index" class="hover:text-[#137fec] transition-colors">Recipes</a>
                <span class="material-symbols-outlined text-[10px]">chevron_right</span>
                <span class="text-slate-500">Edit Formula</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-slate-900 flex items-center gap-3">
                <span class="material-symbols-outlined text-4xl text-amber-500">edit_note</span>
                Refine Recipe
            </h1>
            <p class="text-slate-500 text-sm md:text-base max-w-2xl">
                Updating requirements for <span class="font-bold text-slate-900">@Model.Input.Name</span>. Changes to quantities will synchronize across future production scheduling.
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-page="Details" asp-route-id="@Model.Input.RecipeId" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-all flex items-center gap-2">
                <span class="material-symbols-outlined text-lg">visibility</span>
                View Live
            </a>
        </div>
    </div>

    <form method="post" class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-8 items-start">
        <input type="hidden" asp-for="Input.RecipeId" />
        
        <div asp-validation-summary="ModelOnly" class="lg:col-span-2 p-4 bg-rose-50 border border-rose-200 rounded-xl text-rose-700 text-sm font-medium flex gap-3 items-start @(ViewData.ModelState.IsValid ? "hidden" : "")">
             <span class="material-symbols-outlined text-rose-500">error</span>
             <div>Please review the configuration errors below.</div>
        </div>

        <!-- Main Form Column -->
        <div class="flex flex-col gap-6">
            
            <!-- Basic Information Card -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-[#137fec]">tune</span>
                        <h2 class="text-slate-900 font-bold">Base Configuration</h2>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Recipe Status</span>
                        <label class="relative inline-flex items-center cursor-pointer group">
                            <input asp-for="Input.IsActive" type="checkbox" class="sr-only peer">
                            <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
                            <span class="ml-2 text-xs font-bold text-slate-500 group-peer-checked:text-emerald-600">Active</span>
                        </label>
                    </div>
                </div>
                <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="md:col-span-2">
                        <label asp-for="Input.Name" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Recipe Name <span class="text-rose-500">*</span></label>
                        <input asp-for="Input.Name" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-bold focus:ring-4 focus:ring-[#137fec]/10 focus:border-[#137fec] transition-all" />
                        <span asp-validation-for="Input.Name" class="text-[10px] text-rose-500 font-bold uppercase mt-1"></span>
                    </div>

                    <div>
                        <label asp-for="Input.ProductId" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Output Product <span class="text-rose-500">*</span></label>
                        <select asp-for="Input.ProductId" asp-items="Model.ProductList" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-semibold focus:ring-4 focus:ring-[#137fec]/10 focus:border-[#137fec] transition-all">
                            <option value="">-- Choose output --</option>
                        </select>
                        <span asp-validation-for="Input.ProductId" class="text-[10px] text-rose-500 font-bold uppercase mt-1"></span>
                    </div>

                    <div>
                        <label asp-for="Input.OutputQuantity" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Standard Yield <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <input asp-for="Input.OutputQuantity" type="number" min="1" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-bold focus:ring-4 focus:ring-[#137fec]/10 focus:border-[#137fec] transition-all" />
                            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs font-bold uppercase">Units</span>
                        </div>
                        <span asp-validation-for="Input.OutputQuantity" class="text-[10px] text-rose-500 font-bold uppercase mt-1"></span>
                    </div>

                    <div>
                        <label asp-for="Input.EstimatedTime" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Est. Duration</label>
                        <div class="relative">
                            <input asp-for="Input.EstimatedTime" type="number" step="0.5" min="0" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-bold focus:ring-4 focus:ring-[#137fec]/10 focus:border-[#137fec] transition-all" />
                            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs font-bold uppercase">Mins</span>
                        </div>
                        <span asp-validation-for="Input.EstimatedTime" class="text-[10px] text-rose-500 font-bold uppercase mt-1"></span>
                    </div>

                    <div class="md:col-span-2">
                        <label asp-for="Input.Instructions" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Operational Instructions</label>
                        <textarea asp-for="Input.Instructions" rows="4" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:ring-4 focus:ring-[#137fec]/10 focus:border-[#137fec] transition-all" placeholder="Enter process details..."></textarea>
                        <span asp-validation-for="Input.Instructions" class="text-[10px] text-rose-500 font-bold uppercase mt-1"></span>
                    </div>
                </div>
            </div>

            <!-- Ingredients Card -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-[#137fec]">egg</span>
                        <h2 class="text-slate-900 font-bold">Interactive BOM</h2>
                    </div>
                    <button type="button" id="addIngredient" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#137fec] text-white text-xs font-bold hover:bg-[#137fec]/90 transition-all shadow-md shadow-[#137fec]/20">
                        <span class="material-symbols-outlined text-sm">add</span>
                        Add Ingredient
                    </button>
                </div>
                
                <div class="p-6">
                    <div class="hidden md:grid grid-cols-[1fr_120px_140px_1fr_48px] gap-4 mb-3 px-2">
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Ingredient</span>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest text-center">Qty</span>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest text-center">Unit</span>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Notes</span>
                        <span></span>
                    </div>

                    <div id="ingredientsContainer" class="flex flex-col gap-3">
                        @for (int i = 0; i < Model.Input.Items.Count; i++)
                        {
                            <div class="ingredient-row grid grid-cols-1 md:grid-cols-[1fr_120px_140px_1fr_48px] gap-3 items-start bg-slate-50/50 p-4 md:p-2 rounded-xl border border-slate-100 md:border-transparent md:bg-transparent transition-all" data-index="@i">
                                <input type="hidden" name="Input.Items[@i].RecipeItemId" value="@Model.Input.Items[i].RecipeItemId" />
                                <div class="w-full">
                                    <select name="Input.Items[@i].IngredientProductId" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm text-slate-900 font-medium focus:ring-2 focus:ring-[#137fec]/20 focus:border-[#137fec] transition-all" required>
                                        <option value="">Select component</option>
                                        @foreach (var item in Model.IngredientList)
                                        {
                                            <option value="@item.Value" selected="@(Model.Input.Items[i].IngredientProductId.ToString() == item.Value)">@item.Text</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <input name="Input.Items[@i].Quantity" type="number" step="0.01" min="0" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm text-[#137fec] font-bold text-center focus:ring-2 focus:ring-[#137fec]/20 focus:border-[#137fec] transition-all" value="@Model.Input.Items[i].Quantity" placeholder="0.00" required />
                                </div>
                                <div>
                                    <select name="Input.Items[@i].Unit" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm text-slate-700 font-bold text-center focus:ring-2 focus:ring-[#137fec]/20 focus:border-[#137fec] transition-all">
                                        <option value="">Unit</option>
                                        <option value="gram" selected="@(Model.Input.Items[i].Unit == "gram")">gram</option>
                                        <option value="kg" selected="@(Model.Input.Items[i].Unit == "kg")">kg</option>
                                        <option value="ml" selected="@(Model.Input.Items[i].Unit == "ml")">ml</option>
                                        <option value="lít" selected="@(Model.Input.Items[i].Unit == "lít")">lít</option>
                                        <option value="cái" selected="@(Model.Input.Items[i].Unit == "cái")">cái</option>
                                        <option value="hộp" selected="@(Model.Input.Items[i].Unit == "hộp")">hộp</option>
                                        <option value="gói" selected="@(Model.Input.Items[i].Unit == "gói")">gói</option>
                                    </select>
                                </div>
                                <div>
                                    <input name="Input.Items[@i].Notes" type="text" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm text-slate-500 focus:ring-2 focus:ring-[#137fec]/20 focus:border-[#137fec] transition-all" value="@Model.Input.Items[i].Notes" placeholder="Optional notes" />
                                </div>
                                <div class="flex justify-end items-center h-full">
                                    <button type="button" class="btn-remove-ingredient p-2 rounded-lg text-slate-400 hover:bg-rose-50 hover:text-rose-500 transition-all">
                                        <span class="material-symbols-outlined text-lg">delete</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mt-6 pt-6 border-t border-slate-100 flex flex-col md:flex-row items-center justify-between gap-4">
                        <p class="text-xs text-slate-400 font-medium max-w-sm">
                            <span class="font-bold text-amber-500">System Note:</span> Ingredient edits are logged. Modified ratios will apply to all new production orders immediately.
                        </p>
                        <div class="flex items-center gap-3 w-full md:w-auto">
                            <a asp-page="Index" class="flex-1 md:flex-none inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl border border-slate-200 text-slate-600 font-bold hover:bg-slate-50 transition-all">
                                Discard
                            </a>
                            <button type="submit" class="flex-1 md:flex-none inline-flex items-center justify-center gap-2 px-8 py-3 bg-[#137fec] text-white rounded-xl font-bold shadow-lg shadow-[#137fec]/20 hover:bg-[#137fec]/90 hover:-translate-y-0.5 active:translate-y-0 transition-all">
                                <span class="material-symbols-outlined">save</span>
                                Update Formula
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Area -->
        <aside class="flex flex-col gap-6">
            <div class="bg-slate-900 rounded-2xl p-6 text-white shadow-xl relative overflow-hidden">
                <div class="absolute -right-8 -top-8 h-32 w-32 bg-amber-500/20 rounded-full blur-3xl"></div>
                <h3 class="text-sm font-bold uppercase tracking-widest text-slate-400 mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined text-amber-500 text-lg">history</span>
                    Audit Snapshot
                </h3>
                <div class="flex flex-col gap-4 text-[11px]">
                    <div class="flex gap-3">
                        <span class="material-symbols-outlined text-[#137fec] text-sm">info</span>
                        <p class="text-slate-400 leading-relaxed italic">
                            Formula changes trigger recalculations for warehouse stock requirements.
                        </p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex flex-col gap-4">
                <h4 class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest">Ownership</h4>
                <div class="flex items-center gap-3">
                    <div class="h-10 w-10 rounded-full bg-slate-100 flex items-center justify-center overflow-hidden border border-slate-200">
                        <span class="material-symbols-outlined text-slate-400">person</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-xs font-bold text-slate-900">Current Manager</span>
                        <span class="text-[10px] text-slate-500">Authorized Editor</span>
                    </div>
                </div>
            </div>
        </aside>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let ingredientIndex = @Model.Input.Items.Count;

        document.getElementById('addIngredient').addEventListener('click', function() {
            const container = document.getElementById('ingredientsContainer');
            const row = document.createElement('div');
            row.className = 'ingredient-row grid grid-cols-1 md:grid-cols-[1fr_120px_140px_1fr_48px] gap-3 items-start bg-slate-50/50 p-4 md:p-2 rounded-xl border border-slate-100 md:border-transparent md:bg-transparent transition-all animate-fade-in-down';
            row.setAttribute('data-index', ingredientIndex);
            
            row.innerHTML = `
                <input type="hidden" name="Input.Items[${ingredientIndex}].RecipeItemId" value="0" />
                <div class="w-full">
                    <select name="Input.Items[${ingredientIndex}].IngredientProductId" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm text-slate-900 font-medium focus:ring-2 focus:ring-[#137fec]/20 focus:border-[#137fec] transition-all" required>
                        <option value="">Select component</option>
                        @foreach (var item in Model.IngredientList)
                        {
                            @:<option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                <div>
                    <input name="Input.Items[${ingredientIndex}].Quantity" type="number" step="0.01" min="0" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm text-[#137fec] font-bold text-center focus:ring-2 focus:ring-[#137fec]/20 focus:border-[#137fec] transition-all" placeholder="0.00" required />
                </div>
                <div>
                    <select name="Input.Items[${ingredientIndex}].Unit" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm text-slate-700 font-bold text-center focus:ring-2 focus:ring-[#137fec]/20 focus:border-[#137fec] transition-all">
                        <option value="">Unit</option>
                        <option value="gram">gram</option>
                        <option value="kg">kg</option>
                        <option value="ml">ml</option>
                        <option value="lít">lít</option>
                        <option value="cái">cái</option>
                        <option value="hộp">hộp</option>
                        <option value="gói">gói</option>
                    </select>
                </div>
                <div>
                    <input name="Input.Items[${ingredientIndex}].Notes" type="text" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm text-slate-500 focus:ring-2 focus:ring-[#137fec]/20 focus:border-[#137fec] transition-all" placeholder="Optional notes" />
                </div>
                <div class="flex justify-end items-center h-full">
                    <button type="button" class="btn-remove-ingredient p-2 rounded-lg text-slate-400 hover:bg-rose-50 hover:text-rose-500 transition-all">
                        <span class="material-symbols-outlined text-lg">delete</span>
                    </button>
                </div>
            `;
            
            container.appendChild(row);
            ingredientIndex++;
        });

        document.getElementById('ingredientsContainer').addEventListener('click', function(e) {
            if (e.target.closest('.btn-remove-ingredient')) {
                const row = e.target.closest('.ingredient-row');
                if (document.querySelectorAll('.ingredient-row').length > 1) {
                    row.classList.add('scale-95', 'opacity-0');
                    setTimeout(() => row.remove(), 150);
                } else {
                    row.querySelectorAll('input:not([type="hidden"]), select').forEach(el => el.value = '');
                }
            }
        });
    </script>

    <style>
        @@keyframes fade-in-down {
            0% { opacity: 0; transform: translateY(-10px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in-down {
            animation: fade-in-down 0.3s ease-out forwards;
        }
    </style>
}
