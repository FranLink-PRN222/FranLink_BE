@page "{id:int}"
@model PresentationLayer_FranLink.Pages.Manager.Recipes.EditModel
@{
    ViewData["Title"] = "Edit Recipe";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="Index">Recipes</a></li>
            <li class="breadcrumb-item active">Edit</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-10">
            <div class="card">
                <div class="card-header bg-warning">
                    <h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Recipe</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="Input.RecipeId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Recipe Info -->
                        <h6 class="text-muted mb-3">Recipe Information</h6>
                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label asp-for="Input.Name" class="form-label">Recipe Name <span class="text-danger">*</span></label>
                                <input asp-for="Input.Name" class="form-control" />
                                <span asp-validation-for="Input.Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Input.ProductId" class="form-label">Output Product <span class="text-danger">*</span></label>
                                <select asp-for="Input.ProductId" asp-items="Model.ProductList" class="form-select">
                                    <option value="">-- Select Product --</option>
                                </select>
                                <span asp-validation-for="Input.ProductId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="Input.OutputQuantity" class="form-label">Output Quantity <span class="text-danger">*</span></label>
                                <input asp-for="Input.OutputQuantity" type="number" min="1" class="form-control" />
                                <small class="text-muted">Units produced per batch</small>
                                <span asp-validation-for="Input.OutputQuantity" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Input.EstimatedTime" class="form-label">Estimated Time (minutes)</label>
                                <input asp-for="Input.EstimatedTime" type="number" step="0.5" min="0" class="form-control" />
                                <span asp-validation-for="Input.EstimatedTime" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">&nbsp;</label>
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="Input.IsActive" class="form-check-input" type="checkbox" />
                                    <label class="form-check-label" asp-for="Input.IsActive">Active</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.Instructions" class="form-label">Instructions</label>
                            <textarea asp-for="Input.Instructions" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Input.Instructions" class="text-danger"></span>
                        </div>

                        <hr />

                        <!-- Ingredients -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="text-muted mb-0">Ingredients (Định mức nguyên liệu)</h6>
                            <button type="button" class="btn btn-sm btn-outline-success" id="addIngredient">
                                <i class="bi bi-plus-lg me-1"></i>Add Ingredient
                            </button>
                        </div>

                        <div id="ingredientsContainer">
                            @for (int i = 0; i < Model.Input.Items.Count; i++)
                            {
                                <div class="row ingredient-row mb-2" data-index="@i">
                                    <input type="hidden" name="Input.Items[@i].RecipeItemId" value="@Model.Input.Items[i].RecipeItemId" />
                                    <div class="col-md-4">
                                        <select name="Input.Items[@i].IngredientProductId" class="form-select" required>
                                            <option value="">-- Select Ingredient --</option>
                                            @foreach (var item in Model.IngredientList)
                                            {
                                                if (Model.Input.Items[i].IngredientProductId.ToString() == item.Value)
                                                {
                                                    <option value="@item.Value" selected>@item.Text</option>
                                                }
                                                else
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <input name="Input.Items[@i].Quantity" type="number" step="0.01" min="0" class="form-control" value="@Model.Input.Items[i].Quantity" placeholder="Qty" required />
                                    </div>
                                    <div class="col-md-2">
                                        <select name="Input.Items[@i].Unit" class="form-select">
                                            <option value="">Unit</option>
                                            <option value="gram" selected="@(Model.Input.Items[i].Unit == "gram")">gram</option>
                                            <option value="kg" selected="@(Model.Input.Items[i].Unit == "kg")">kg</option>
                                            <option value="ml" selected="@(Model.Input.Items[i].Unit == "ml")">ml</option>
                                            <option value="lít" selected="@(Model.Input.Items[i].Unit == "lít")">lít</option>
                                            <option value="cái" selected="@(Model.Input.Items[i].Unit == "cái")">cái</option>
                                            <option value="hộp" selected="@(Model.Input.Items[i].Unit == "hộp")">hộp</option>
                                            <option value="gói" selected="@(Model.Input.Items[i].Unit == "gói")">gói</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <input name="Input.Items[@i].Notes" type="text" class="form-control" value="@Model.Input.Items[i].Notes" placeholder="Notes" />
                                    </div>
                                    <div class="col-md-1">
                                        <button type="button" class="btn btn-outline-danger btn-remove-ingredient" title="Remove">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a asp-page="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back to List
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check-lg me-1"></i>Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let ingredientIndex = @Model.Input.Items.Count;

        document.getElementById('addIngredient').addEventListener('click', function() {
            const container = document.getElementById('ingredientsContainer');
            const row = document.createElement('div');
            row.className = 'row ingredient-row mb-2';
            row.setAttribute('data-index', ingredientIndex);
            
            row.innerHTML = `
                <input type="hidden" name="Input.Items[${ingredientIndex}].RecipeItemId" value="0" />
                <div class="col-md-4">
                    <select name="Input.Items[${ingredientIndex}].IngredientProductId" class="form-select" required>
                        <option value="">-- Select Ingredient --</option>
                        @foreach (var item in Model.IngredientList)
                        {
                            @:<option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <input name="Input.Items[${ingredientIndex}].Quantity" type="number" step="0.01" min="0" class="form-control" placeholder="Qty" required />
                </div>
                <div class="col-md-2">
                    <select name="Input.Items[${ingredientIndex}].Unit" class="form-select">
                        <option value="">Unit</option>
                        <option value="gram">gram</option>
                        <option value="kg">kg</option>
                        <option value="ml">ml</option>
                        <option value="lít">lít</option>
                        <option value="cái">cái</option>
                        <option value="hộp">hộp</option>
                        <option value="gói">gói</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <input name="Input.Items[${ingredientIndex}].Notes" type="text" class="form-control" placeholder="Notes" />
                </div>
                <div class="col-md-1">
                    <button type="button" class="btn btn-outline-danger btn-remove-ingredient" title="Remove">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            `;
            
            container.appendChild(row);
            ingredientIndex++;
        });

        document.getElementById('ingredientsContainer').addEventListener('click', function(e) {
            if (e.target.closest('.btn-remove-ingredient')) {
                const row = e.target.closest('.ingredient-row');
                if (document.querySelectorAll('.ingredient-row').length > 1) {
                    row.remove();
                } else {
                    row.querySelectorAll('input, select').forEach(el => {
                        if (el.name && !el.name.includes('RecipeItemId')) {
                            el.value = '';
                        }
                    });
                }
            }
        });
    </script>
}
