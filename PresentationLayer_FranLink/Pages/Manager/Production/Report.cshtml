@page
@model PresentationLayer_FranLink.Pages.Manager.Production.ReportModel
@{
    ViewData["Title"] = "Production Report";
}

<div class="container-fluid">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="Index">Production</a></li>
            <li class="breadcrumb-item active">Report</li>
        </ol>
    </nav>

    <h2>📊 Production Report</h2>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">From Date</label>
                    <input asp-for="FromDate" type="date" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">To Date</label>
                    <input asp-for="ToDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Central Kitchen</label>
                    <select asp-for="CentralKitchenId" asp-items="Model.CentralKitchens" class="form-select">
                        <option value="">-- All Kitchens --</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary">Generate Report</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary h-100">
                <div class="card-body">
                    <h6 class="card-title">Total Productions</h6>
                    <h2>@Model.Summary.TotalProductions</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info h-100">
                <div class="card-body">
                    <h6 class="card-title">Planned vs Actual</h6>
                    <h2>@Model.Summary.TotalPlannedQuantity / @Model.Summary.TotalActualQuantity</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white @(Model.Summary.EfficiencyRate >= 90 ? "bg-success" : Model.Summary.EfficiencyRate >= 70 ? "bg-warning" : "bg-danger") h-100">
                <div class="card-body">
                    <h6 class="card-title">Efficiency Rate</h6>
                    <h2>@Model.Summary.EfficiencyRate%</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-secondary h-100">
                <div class="card-body">
                    <h6 class="card-title">Avg. Production Time</h6>
                    <h2>@Model.Summary.AverageProductionTimeMinutes min</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- By Product -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">📦 Production by Product</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Summary.ByProduct.Any())
                    {
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th class="text-center">Planned</th>
                                    <th class="text-center">Actual</th>
                                    <th class="text-center">Efficiency</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Summary.ByProduct)
                                {
                                    var effClass = item.EfficiencyRate >= 90 ? "bg-success" : item.EfficiencyRate >= 70 ? "bg-warning text-dark" : "bg-danger";
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td class="text-center">@item.TotalPlanned</td>
                                        <td class="text-center">@item.TotalActual</td>
                                        <td class="text-center">
                                            <span class="badge @effClass">@item.EfficiencyRate%</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">No data available</div>
                    }
                </div>
            </div>
        </div>

        <!-- By Day -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">📅 Daily Production</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Summary.ByDay.Any())
                    {
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th class="text-center">Productions</th>
                                    <th class="text-center">Total Quantity</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var day in Model.Summary.ByDay.OrderByDescending(d => d.Date))
                                {
                                    <tr>
                                        <td>@day.Date.ToString("dd/MM/yyyy")</td>
                                        <td class="text-center">@day.ProductionCount</td>
                                        <td class="text-center">
                                            <span class="badge bg-primary">@day.TotalQuantity</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">No data available</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Efficiency Analysis -->
    @if (Model.Summary.ByProduct.Any())
    {
        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0">📈 Efficiency Analysis</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    @{
                        var highEff = Model.Summary.ByProduct.Where(p => p.EfficiencyRate >= 90).ToList();
                        var medEff = Model.Summary.ByProduct.Where(p => p.EfficiencyRate >= 70 && p.EfficiencyRate < 90).ToList();
                        var lowEff = Model.Summary.ByProduct.Where(p => p.EfficiencyRate < 70).ToList();
                    }
                    <div class="col-md-4">
                        <div class="card border-success">
                            <div class="card-header bg-success text-white">
                                High Efficiency (≥90%)
                            </div>
                            <ul class="list-group list-group-flush">
                                @if (highEff.Any())
                                {
                                    @foreach (var p in highEff)
                                    {
                                        <li class="list-group-item d-flex justify-content-between">
                                            <span>@p.ProductName</span>
                                            <span>@p.EfficiencyRate%</span>
                                        </li>
                                    }
                                }
                                else
                                {
                                    <li class="list-group-item text-muted">None</li>
                                }
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-warning">
                            <div class="card-header bg-warning text-dark">
                                Medium Efficiency (70-89%)
                            </div>
                            <ul class="list-group list-group-flush">
                                @if (medEff.Any())
                                {
                                    @foreach (var p in medEff)
                                    {
                                        <li class="list-group-item d-flex justify-content-between">
                                            <span>@p.ProductName</span>
                                            <span>@p.EfficiencyRate%</span>
                                        </li>
                                    }
                                }
                                else
                                {
                                    <li class="list-group-item text-muted">None</li>
                                }
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-danger">
                            <div class="card-header bg-danger text-white">
                                Low Efficiency (&lt;70%)
                            </div>
                            <ul class="list-group list-group-flush">
                                @if (lowEff.Any())
                                {
                                    @foreach (var p in lowEff)
                                    {
                                        <li class="list-group-item d-flex justify-content-between">
                                            <span>@p.ProductName</span>
                                            <span>@p.EfficiencyRate%</span>
                                        </li>
                                    }
                                }
                                else
                                {
                                    <li class="list-group-item text-muted">None</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
