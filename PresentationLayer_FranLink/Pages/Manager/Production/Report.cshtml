@page
@model PresentationLayer_FranLink.Pages.Manager.Production.ReportModel
@{
    ViewData["Title"] = "Production Report";
    Layout = "_LayoutFranLink";
}

<div class="max-w-[1280px] mx-auto w-full px-4 md:px-8 py-8 flex flex-col gap-6">

    <!-- Header -->
    <section class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs text-slate-400 mb-1">
                <a asp-page="Index" class="hover:text-slate-600">Production</a>
                <span>/</span>
                <span>Report</span>
            </div>
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 flex items-center gap-2">
                <span class="material-symbols-outlined text-[#137fec] text-3xl">monitoring</span>
                Production performance report
            </h1>
            <p class="text-slate-500 text-sm md:text-base mt-1 max-w-2xl">
                Analyse planned vs actual output, efficiency, and daily production volumes across central kitchens.
            </p>
        </div>
    </section>

    <!-- Filters -->
    <section class="bg-white border border-slate-200 rounded-xl p-4 md:p-5 shadow-sm flex flex-col gap-4">
        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wide flex items-center gap-2">
            <span class="material-symbols-outlined text-base text-slate-400">filter_alt</span>
            Filter by date range & kitchen
        </div>
        <form method="get" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
            <div>
                <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">From date</label>
                <input asp-for="FromDate"
                       type="date"
                       class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#137fec] focus:border-transparent" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">To date</label>
                <input asp-for="ToDate"
                       type="date"
                       class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#137fec] focus:border-transparent" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Central kitchen</label>
                <select asp-for="CentralKitchenId"
                        asp-items="Model.CentralKitchens"
                        class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#137fec] focus:border-transparent">
                    <option value="">All kitchens</option>
                </select>
            </div>
            <div class="flex gap-2 justify-end">
                <button type="submit"
                        class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 text-white text-sm font-semibold px-4 py-2.5 hover:bg-slate-800 transition-colors">
                    <span class="material-symbols-outlined text-base">refresh</span>
                    Generate report
                </button>
            </div>
        </form>
    </section>

    <!-- Summary cards -->
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-5 flex flex-col gap-2">
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Total batches</p>
            <p class="text-3xl font-bold text-slate-900">@Model.Summary.TotalProductions</p>
        </div>
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-5 flex flex-col gap-2">
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Planned vs actual</p>
            <p class="text-lg font-semibold text-slate-900">
                <span class="text-2xl">@Model.Summary.TotalPlannedQuantity</span>
                <span class="mx-1 text-slate-400">/</span>
                <span class="text-2xl">@Model.Summary.TotalActualQuantity</span>
            </p>
        </div>
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-5 flex flex-col gap-2">
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Efficiency rate</p>
            <p class="text-3xl font-bold @(Model.Summary.EfficiencyRate >= 90 ? "text-emerald-600" : Model.Summary.EfficiencyRate >= 70 ? "text-amber-500" : "text-rose-500")">
                @Model.Summary.EfficiencyRate%
            </p>
        </div>
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-5 flex flex-col gap-2">
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Avg production time</p>
            <p class="text-3xl font-bold text-slate-900">
                @Model.Summary.AverageProductionTimeMinutes
                <span class="text-base font-normal text-slate-500">min</span>
            </p>
        </div>
    </section>

    <!-- Tables: by product / by day -->
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- By product -->
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-lg text-[#137fec]">inventory_2</span>
                    <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide">Production by product</h2>
                </div>
            </div>
            <div class="overflow-x-auto">
                @if (Model.Summary.ByProduct.Any())
                {
                    <table class="w-full text-left text-sm border-collapse">
                        <thead class="bg-slate-50 text-xs text-slate-500 uppercase tracking-wide">
                            <tr>
                                <th class="px-5 py-2.5">Product</th>
                                <th class="px-5 py-2.5 text-center">Planned</th>
                                <th class="px-5 py-2.5 text-center">Actual</th>
                                <th class="px-5 py-2.5 text-center">Efficiency</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var item in Model.Summary.ByProduct)
                            {
                                var color = item.EfficiencyRate >= 90 ? "bg-emerald-100 text-emerald-700" :
                                            item.EfficiencyRate >= 70 ? "bg-amber-100 text-amber-700" :
                                            "bg-rose-100 text-rose-700";
                                <tr class="hover:bg-slate-50/70 transition-colors">
                                    <td class="px-5 py-3 text-slate-800">@item.ProductName</td>
                                    <td class="px-5 py-3 text-center text-slate-700">@item.TotalPlanned</td>
                                    <td class="px-5 py-3 text-center text-slate-700">@item.TotalActual</td>
                                    <td class="px-5 py-3 text-center">
                                        <span class="inline-flex items-center justify-center min-w-[3.5rem] px-2 py-1 rounded-full text-[11px] font-bold @color">
                                            @item.EfficiencyRate%
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="py-10 text-center text-sm text-slate-400">
                        No production data for the selected period.
                    </div>
                }
            </div>
        </div>

        <!-- By day -->
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-lg text-emerald-600">calendar_month</span>
                    <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide">Daily production</h2>
                </div>
            </div>
            <div class="overflow-x-auto">
                @if (Model.Summary.ByDay.Any())
                {
                    <table class="w-full text-left text-sm border-collapse">
                        <thead class="bg-slate-50 text-xs text-slate-500 uppercase tracking-wide">
                            <tr>
                                <th class="px-5 py-2.5">Date</th>
                                <th class="px-5 py-2.5 text-center">Batches</th>
                                <th class="px-5 py-2.5 text-center">Total quantity</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var day in Model.Summary.ByDay.OrderByDescending(d => d.Date))
                            {
                                <tr class="hover:bg-slate-50/70 transition-colors">
                                    <td class="px-5 py-3 text-slate-800">@day.Date.ToString("dd/MM/yyyy")</td>
                                    <td class="px-5 py-3 text-center text-slate-700">@day.ProductionCount</td>
                                    <td class="px-5 py-3 text-center">
                                        <span class="inline-flex items-center justify-center min-w-[3.5rem] px-2 py-1 rounded-full bg-slate-100 text-[11px] font-bold text-slate-700">
                                            @day.TotalQuantity
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="py-10 text-center text-sm text-slate-400">
                        No daily production records.
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Efficiency analysis -->
    @if (Model.Summary.ByProduct.Any())
    {
        <section class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-lg text-amber-600">insights</span>
                    <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide">Efficiency analysis</h2>
                </div>
            </div>
            <div class="px-5 py-4 grid grid-cols-1 md:grid-cols-3 gap-4 text-sm text-slate-700">
                @{
                    var highEff = Model.Summary.ByProduct.Where(p => p.EfficiencyRate >= 90).ToList();
                    var medEff = Model.Summary.ByProduct.Where(p => p.EfficiencyRate >= 70 && p.EfficiencyRate < 90).ToList();
                    var lowEff = Model.Summary.ByProduct.Where(p => p.EfficiencyRate < 70).ToList();
                }
                <div class="border border-emerald-100 rounded-lg overflow-hidden">
                    <div class="px-3 py-2 bg-emerald-50 text-emerald-700 text-xs font-bold uppercase tracking-wide">
                        High efficiency (≥ 90%)
                    </div>
                    <ul class="divide-y divide-slate-100">
                        @if (highEff.Any())
                        {
                            @foreach (var p in highEff)
                            {
                                <li class="px-3 py-2 flex items-center justify-between">
                                    <span class="truncate pr-2">@p.ProductName</span>
                                    <span class="text-emerald-600 font-semibold">@p.EfficiencyRate%</span>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="px-3 py-3 text-xs text-slate-400">No products in this band.</li>
                        }
                    </ul>
                </div>
                <div class="border border-amber-100 rounded-lg overflow-hidden">
                    <div class="px-3 py-2 bg-amber-50 text-amber-700 text-xs font-bold uppercase tracking-wide">
                        Medium efficiency (70–89%)
                    </div>
                    <ul class="divide-y divide-slate-100">
                        @if (medEff.Any())
                        {
                            @foreach (var p in medEff)
                            {
                                <li class="px-3 py-2 flex items-center justify-between">
                                    <span class="truncate pr-2">@p.ProductName</span>
                                    <span class="text-amber-600 font-semibold">@p.EfficiencyRate%</span>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="px-3 py-3 text-xs text-slate-400">No products in this band.</li>
                        }
                    </ul>
                </div>
                <div class="border border-rose-100 rounded-lg overflow-hidden">
                    <div class="px-3 py-2 bg-rose-50 text-rose-700 text-xs font-bold uppercase tracking-wide">
                        Low efficiency (&lt; 70%)
                    </div>
                    <ul class="divide-y divide-slate-100">
                        @if (lowEff.Any())
                        {
                            @foreach (var p in lowEff)
                            {
                                <li class="px-3 py-2 flex items-center justify-between">
                                    <span class="truncate pr-2">@p.ProductName</span>
                                    <span class="text-rose-600 font-semibold">@p.EfficiencyRate%</span>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="px-3 py-3 text-xs text-slate-400">No products in this band.</li>
                        }
                    </ul>
                </div>
            </div>
        </section>
    }
</div>
