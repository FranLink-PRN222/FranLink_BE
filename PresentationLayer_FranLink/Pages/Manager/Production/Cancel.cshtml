@page "{id:int}"
@model PresentationLayer_FranLink.Pages.Manager.Production.CancelModel
@{
    ViewData["Title"] = "Cancel Production";
    var duration = DateTime.UtcNow - Model.Production.StartTime;
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="Index">Production</a></li>
            <li class="breadcrumb-item active">Cancel #@Model.Id</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">❌ Cancel Production #@Model.Id</h4>
                </div>
                <div class="card-body">
                    <!-- Production Info -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-muted">Recipe</h6>
                            <p class="mb-1"><strong>@Model.Production.Recipe.Name</strong></p>
                            <small class="text-muted">@Model.Production.Recipe.Product.Name</small>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Central Kitchen</h6>
                            <p><strong>@Model.Production.CentralKitchen.Name</strong></p>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4">
                            <h6 class="text-muted">Planned Quantity</h6>
                            <h3 class="text-primary">@Model.Production.PlannedQuantity</h3>
                        </div>
                        <div class="col-md-4">
                            <h6 class="text-muted">Started At</h6>
                            <p>@Model.Production.StartTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <div class="col-md-4">
                            <h6 class="text-muted">Duration</h6>
                            <p>@duration.Hours h @duration.Minutes m</p>
                        </div>
                    </div>

                    <div class="alert alert-warning">
                        <strong>⚠️ Warning:</strong> Cancelling a production cannot be undone. No inventory changes will be made.
                    </div>

                    <hr />

                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Reason" class="form-label">
                                Reason for Cancellation <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Reason" class="form-control" rows="3" required placeholder="Why is this production being cancelled?"></textarea>
                            <span asp-validation-for="Reason" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-page="Index" class="btn btn-secondary">Go Back</a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-x-circle"></i> Cancel Production
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
