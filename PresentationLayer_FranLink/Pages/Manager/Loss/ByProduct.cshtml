@page
@model PresentationLayer_FranLink.Pages.Manager.Loss.ByProductModel
@{
    ViewData["Title"] = "Loss by Product";
    Layout = "_LayoutFranLink";
}

<div class="container-fluid">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="Index">Loss Report</a></li>
            <li class="breadcrumb-item active">By Product</li>
        </ol>
    </nav>

    <h2>📦 Loss by Product</h2>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">From Date</label>
                    <input asp-for="FromDate" type="date" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">To Date</label>
                    <input asp-for="ToDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Central Kitchen</label>
                    <select asp-for="CentralKitchenId" asp-items="Model.CentralKitchens" class="form-select">
                        <option value="">-- All Locations --</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary">Apply Filter</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Results -->
    <div class="card">
        <div class="card-header">
            <span>Found @Model.Products.Count product(s) with loss</span>
        </div>
        <div class="card-body p-0">
            @if (Model.Products.Any())
            {
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th class="text-center">Disposals</th>
                            <th class="text-center">Quantity Lost</th>
                            <th class="text-end">Loss Value</th>
                            <th>Top Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Products)
                        {
                            var reasonClass = product.TopReason switch
                            {
                                "Expired" => "bg-warning text-dark",
                                "Damaged" => "bg-danger",
                                "Quality Issue" => "bg-info",
                                _ => "bg-secondary"
                            };
                            <tr>
                                <td><strong>@product.ProductName</strong></td>
                                <td><span class="badge bg-secondary">@product.Category</span></td>
                                <td class="text-center">@product.DisposalCount</td>
                                <td class="text-center">@product.LostQuantity</td>
                                <td class="text-end text-danger">@product.LostValue.ToString("N0")</td>
                                <td><span class="badge @reasonClass">@product.TopReason</span></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-secondary">
                        <tr>
                            <th colspan="2">Total</th>
                            <th class="text-center">@Model.Products.Sum(p => p.DisposalCount)</th>
                            <th class="text-center">@Model.Products.Sum(p => p.LostQuantity)</th>
                            <th class="text-end">@Model.Products.Sum(p => p.LostValue).ToString("N0")</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                    <p>No product loss data found for the selected criteria.</p>
                </div>
            }
        </div>
    </div>
</div>
