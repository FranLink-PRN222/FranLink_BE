@page
@model PresentationLayer_FranLink.Pages.Manager.Loss.IndexModel
@{
    ViewData["Title"] = "Loss Report Dashboard";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📉 Loss Report Dashboard</h2>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">From Date</label>
                    <input asp-for="FromDate" type="date" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">To Date</label>
                    <input asp-for="ToDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Central Kitchen</label>
                    <select asp-for="CentralKitchenId" asp-items="Model.CentralKitchens" class="form-select">
                        <option value="">-- All Locations --</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary">Apply Filter</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-danger h-100">
                <div class="card-body text-center">
                    <h6>Total Loss Value</h6>
                    <h3>@Model.Summary.TotalLossValue.ToString("N0") VND</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-secondary h-100">
                <div class="card-body text-center">
                    <h6>Total Items Lost</h6>
                    <h3>@Model.Summary.TotalLossItems</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info h-100">
                <div class="card-body text-center">
                    <h6>Total Disposals</h6>
                    <h3>@Model.Summary.TotalDisposals</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning h-100">
                <div class="card-body text-center">
                    <h6>Expired Loss</h6>
                    <h3>@Model.Summary.ExpiredLossValue.ToString("N0")</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Loss by Reason -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">📊 Loss by Reason</h5>
                    <a asp-page="ByReason" class="btn btn-sm btn-outline-primary">Details</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.ByReason.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var reason in Model.ByReason)
                            {
                                var colorClass = reason.Reason switch
                                {
                                    "Expired" => "bg-warning text-dark",
                                    "Damaged" => "bg-danger",
                                    "Quality Issue" => "bg-info",
                                    _ => "bg-secondary"
                                };
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="badge @colorClass">@reason.Reason</span>
                                        <br />
                                        <small class="text-muted">@reason.ItemCount items</small>
                                    </div>
                                    <div class="text-end">
                                        <strong>@reason.TotalValue.ToString("N0")</strong>
                                        <br />
                                        <small class="text-muted">@reason.Percentage%</small>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">No loss data available</div>
                    }
                </div>
            </div>
        </div>

        <!-- Top Loss Products -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">🔥 Top Loss Products</h5>
                    <a asp-page="ByProduct" class="btn btn-sm btn-outline-primary">All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.TopProducts.Any())
                    {
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Loss</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var product in Model.TopProducts)
                                {
                                    <tr>
                                        <td>
                                            <strong>@product.ProductName</strong>
                                            <br />
                                            <small class="text-muted">@product.TopReason</small>
                                        </td>
                                        <td class="text-center">@product.LostQuantity</td>
                                        <td class="text-end text-danger">@product.LostValue.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">No data available</div>
                    }
                </div>
            </div>
        </div>

        <!-- Loss by Location -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">📍 Loss by Location</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.ByLocation.Any())
                    {
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Location</th>
                                    <th class="text-center">Items</th>
                                    <th class="text-end">Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var loc in Model.ByLocation.Take(5))
                                {
                                    <tr>
                                        <td>
                                            <strong>@loc.LocationName</strong>
                                            <br />
                                            <small class="badge bg-secondary">@loc.LocationType</small>
                                        </td>
                                        <td class="text-center">@loc.TotalQuantity</td>
                                        <td class="text-end text-danger">@loc.TotalValue.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">No data available</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Daily Trend -->
    @if (Model.Summary.ByDay.Any())
    {
        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0">📅 Daily Loss Trend</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th class="text-center">Disposals</th>
                            <th class="text-center">Quantity</th>
                            <th class="text-end">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in Model.Summary.ByDay.OrderByDescending(d => d.Date).Take(10))
                        {
                            <tr>
                                <td>@day.Date.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">@day.DisposalCount</td>
                                <td class="text-center">@day.Quantity</td>
                                <td class="text-end text-danger">@day.Value.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
