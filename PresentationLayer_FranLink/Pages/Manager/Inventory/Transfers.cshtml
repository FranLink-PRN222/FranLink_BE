@page
@model PresentationLayer_FranLink.Pages.Manager.Inventory.TransfersModel
@{
    ViewData["Title"] = "Inventory Logistics";
    Layout = "_LayoutFranLink";
}

<div class="max-w-[1440px] mx-auto w-full px-4 md:px-8 py-8 flex flex-col gap-8">
    
    <!-- Header Area -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="flex flex-col gap-2">
            <nav class="flex items-center gap-2 text-xs font-bold text-slate-400 uppercase tracking-widest">
                <a asp-page="/Manager/Inventory/Dashboard" class="hover:text-[#137fec] transition-colors">Inventory</a>
                <span class="material-symbols-outlined text-[10px]">chevron_right</span>
                <span class="text-slate-500">Logistics & Transfers</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-slate-900 flex items-center gap-3">
                <span class="material-symbols-outlined text-4xl text-sky-500">local_shipping</span>
                Inventory Transfers
            </h1>
            <p class="text-slate-500 text-sm md:text-base max-w-2xl font-medium">
                Manage stock movements across the franchise network. Track approval workflows and fulfillment status.
            </p>
        </div>
        <div class="flex items-center gap-3">
            <button type="button" onclick="openModal('createTransferModal')" class="inline-flex items-center gap-2 px-6 py-3 bg-slate-900 text-white rounded-2xl font-black text-xs uppercase tracking-widest shadow-xl shadow-slate-900/20 hover:bg-slate-800 hover:-translate-y-0.5 active:translate-y-0 transition-all">
                <span class="material-symbols-outlined text-lg">add_circle</span>
                New Request
            </button>
            <a asp-page="/Manager/Inventory/Dashboard" class="p-3 rounded-2xl border border-slate-200 text-slate-500 hover:bg-slate-50 transition-all">
                <span class="material-symbols-outlined">dashboard</span>
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="p-4 rounded-2xl flex items-center gap-3 @(Model.IsSuccess ? "bg-emerald-50 text-emerald-700 border border-emerald-100" : "bg-rose-50 text-rose-700 border border-rose-100") anim-fade-in">
            <span class="material-symbols-outlined">@(Model.IsSuccess ? "check_circle" : "error")</span>
            <p class="text-sm font-bold">@Model.Message</p>
        </div>
    }

    <!-- Status Navigator -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        @{
            var statusTypes = new[] { 
                new { Id = "Pending", Label = "Pending", Icon = "schedule", Color = "amber", Count = Model.AllTransfers.Count(t => t.Status == "Pending") },
                new { Id = "Approved", Label = "Approved", Icon = "verified", Color = "emerald", Count = Model.AllTransfers.Count(t => t.Status == "Approved") },
                new { Id = "Completed", Label = "Completed", Icon = "task_alt", Color = "sky", Count = Model.AllTransfers.Count(t => t.Status == "Completed") },
                new { Id = "Rejected", Label = "Rejected", Icon = "cancel", Color = "rose", Count = Model.AllTransfers.Count(t => t.Status == "Rejected") },
                new { Id = "", Label = "All Streams", Icon = "reorder", Color = "slate", Count = Model.AllTransfers.Count() }
            };
        }

        @foreach (var status in statusTypes)
        {
            var isActive = Model.StatusFilter == status.Id || (string.IsNullOrEmpty(Model.StatusFilter) && string.IsNullOrEmpty(status.Id));
            var accentColor = status.Color;
            
            <a asp-page="/Manager/Inventory/Transfers" asp-route-status="@status.Id" 
               class="group relative bg-white p-5 rounded-[24px] border-2 transition-all duration-300 @(isActive ? $"border-{accentColor}-500 ring-4 ring-{accentColor}-500/10 shadow-lg" : "border-slate-100 hover:border-slate-300")">
                
                <div class="flex flex-col gap-3">
                    <div class="size-10 rounded-xl @(isActive ? $"bg-{accentColor}-500 text-white shadow-lg shadow-{accentColor}-500/30" : $"bg-{accentColor}-50 text-{accentColor}-500") flex items-center justify-center transition-all">
                        <span class="material-symbols-outlined text-xl">@status.Icon</span>
                    </div>
                    <div>
                        <h3 class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-0.5">@status.Label</h3>
                        <p class="text-xl font-black text-slate-900">@status.Count</p>
                    </div>
                </div>
                
                @if (isActive)
                {
                    <div class="absolute top-4 right-4 h-1.5 w-1.5 rounded-full bg-@accentColor-500"></div>
                }
            </a>
        }
    </div>

    <!-- Transfers Table -->
    <div class="bg-white rounded-[32px] border border-slate-200 shadow-sm overflow-hidden flex flex-col">
        <div class="px-8 py-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
            <h2 class="text-slate-900 font-bold flex items-center gap-2">
                <span class="material-symbols-outlined text-slate-400 text-lg">sync_alt</span>
                Logistics Registry
            </h2>
            <div class="flex items-center gap-2">
                <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Viewing:</span>
                <span class="px-2.5 py-1 bg-slate-900 text-white text-[10px] font-black uppercase tracking-tight rounded-lg">@(string.IsNullOrEmpty(Model.StatusFilter) ? "All Activity" : Model.StatusFilter)</span>
            </div>
        </div>

        <div class="overflow-x-auto">
            @if (Model.Transfers.Any())
            {
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-100">
                            <th class="px-8 py-4 text-[10px] font-black text-slate-500 uppercase tracking-widest">Order ID</th>
                            <th class="px-6 py-4 text-[10px] font-black text-slate-500 uppercase tracking-widest">Movement Route</th>
                            <th class="px-6 py-4 text-[10px] font-black text-slate-500 uppercase tracking-widest">Asset Details</th>
                            <th class="px-6 py-4 text-[10px] font-black text-slate-500 uppercase tracking-widest">Originator & Date</th>
                            <th class="px-6 py-4 text-[10px] font-black text-slate-500 uppercase tracking-widest text-center">Status</th>
                            <th class="px-8 py-4 text-[10px] font-black text-slate-500 uppercase tracking-widest text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var transfer in Model.Transfers)
                        {
                            <tr class="group hover:bg-slate-50/80 transition-all">
                                <td class="px-8 py-6 font-mono text-xs font-black text-[#137fec]">#@transfer.Id</td>
                                <td class="px-6 py-6">
                                    <div class="flex items-center gap-3">
                                        <div class="flex flex-col">
                                            <span class="text-[9px] font-black text-slate-400 uppercase tracking-tighter">From</span>
                                            <span class="text-xs font-bold text-slate-900">@(transfer.FromCentralKitchen?.Name ?? transfer.FromStore?.Name)</span>
                                        </div>
                                        <span class="material-symbols-outlined text-slate-300 text-sm">trending_flat</span>
                                        <div class="flex flex-col text-right md:text-left">
                                            <span class="text-[9px] font-black text-[#137fec] uppercase tracking-tighter">To</span>
                                            <span class="text-xs font-bold text-slate-900">@(transfer.ToCentralKitchen?.Name ?? transfer.ToStore?.Name)</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-6">
                                    <div class="flex flex-col">
                                        <span class="text-xs font-black text-slate-900 tracking-tight">@transfer.Product?.Name</span>
                                        <span class="text-[10px] font-bold text-emerald-600">Qty: @transfer.Quantity @transfer.Product?.Unit</span>
                                    </div>
                                </td>
                                <td class="px-6 py-6">
                                    <div class="flex flex-col">
                                        <span class="text-xs font-bold text-slate-700">@transfer.RequestedBy?.Username</span>
                                        <span class="text-[10px] font-medium text-slate-400">@transfer.RequestDate.ToString("MMM dd, HH:mm")</span>
                                    </div>
                                </td>
                                <td class="px-6 py-6 text-center">
                                    @{
                                        var statusStyles = transfer.Status switch {
                                            "Pending" => "bg-amber-50 text-amber-600 border-amber-100",
                                            "Approved" => "bg-emerald-50 text-emerald-600 border-emerald-100",
                                            "Completed" => "bg-sky-50 text-sky-600 border-sky-100",
                                            "Rejected" => "bg-rose-50 text-rose-600 border-rose-100",
                                            _ => "bg-slate-50 text-slate-600 border-slate-100"
                                        };
                                    }
                                    <span class="px-2.5 py-1 rounded-full border @statusStyles text-[10px] font-black uppercase tracking-widest">
                                        @transfer.Status
                                    </span>
                                </td>
                                <td class="px-8 py-6 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        @if (transfer.Status == "Pending")
                                        {
                                            <form method="post" class="flex gap-1">
                                                <input type="hidden" name="transferId" value="@transfer.Id" />
                                                <button type="submit" asp-page-handler="Approve" class="size-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center hover:bg-emerald-500 hover:text-white transition-all shadow-sm" title="Approve">
                                                    <span class="material-symbols-outlined text-sm">done</span>
                                                </button>
                                                <button type="submit" asp-page-handler="Reject" class="size-8 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center hover:bg-rose-500 hover:text-white transition-all shadow-sm" title="Reject">
                                                    <span class="material-symbols-outlined text-sm">close</span>
                                                </button>
                                            </form>
                                        }
                                        else if (transfer.Status == "Approved")
                                        {
                                            <form method="post">
                                                <input type="hidden" name="transferId" value="@transfer.Id" />
                                                <button type="submit" asp-page-handler="Complete" class="h-8 px-3 rounded-lg bg-[#137fec] text-white flex items-center justify-center gap-1.5 text-[10px] font-black uppercase tracking-widest hover:bg-[#0b66c2] transition-all shadow-lg shadow-[#137fec]/20" title="Mark as Completed">
                                                    <span class="material-symbols-outlined text-sm">inventory_2</span>
                                                    Collect
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-[10px] font-bold text-slate-300 uppercase tracking-tighter">Locked</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="p-20 flex flex-col items-center justify-center text-center gap-4">
                    <div class="size-20 rounded-full bg-slate-50 text-slate-300 flex items-center justify-center">
                        <span class="material-symbols-outlined text-5xl">inventory_2</span>
                    </div>
                    <div class="max-w-xs">
                        <h3 class="text-slate-900 font-bold text-lg">No Orders Found</h3>
                        <p class="text-slate-500 text-sm">There are no transfer requests currently matching this filter.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Premium Modal Integration -->
<div id="createTransferModal" class="hidden fixed inset-0 z-[100] overflow-y-auto">
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" onclick="closeModal('createTransferModal')"></div>
    <div class="flex min-h-full items-center justify-center p-4 sm:p-6 lg:p-8">
        <div class="relative w-full max-w-2xl transform overflow-hidden rounded-[32px] bg-white text-left shadow-2xl transition-all border border-slate-100">
            <div class="bg-slate-50 px-8 py-6 border-b border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="size-10 rounded-xl bg-sky-500 text-white flex items-center justify-center shadow-lg shadow-sky-500/20">
                        <span class="material-symbols-outlined text-xl">transit_enterexit</span>
                    </div>
                    <div>
                        <h3 class="text-lg font-black text-slate-900 tracking-tight">Streamstock Initiation</h3>
                        <p class="text-xs text-slate-500 font-bold uppercase tracking-widest">Global Supply Protocol</p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('createTransferModal')" class="size-10 rounded-xl hover:bg-white hover:shadow-md flex items-center justify-center text-slate-400 transition-all">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <form method="post" asp-page-handler="Create">
                <div class="px-8 py-10 flex flex-col gap-8">
                    <!-- Routing Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 relative">
                        <div class="absolute inset-y-0 left-1/2 -translate-x-1/2 hidden md:flex items-center justify-center pointer-events-none">
                            <span class="material-symbols-outlined text-slate-200">arrow_forward</span>
                        </div>
                        
                        <div class="flex flex-col gap-4">
                            <h4 class="text-[10px] font-black text-slate-400 uppercase tracking-widest flex items-center gap-2">
                                <span class="material-symbols-outlined text-lg">outbound</span> Origin Point
                            </h4>
                            <div class="flex flex-col gap-3">
                                <div>
                                    <label class="text-[9px] font-bold text-slate-500 uppercase tracking-tighter mb-1 block">Central Kitchen</label>
                                    <select name="fromCentralKitchenId" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold focus:ring-4 focus:ring-sky-500/10 focus:border-sky-500 transition-all">
                                        <option value="">-- No Source --</option>
                                        @foreach (var kitchen in Model.CentralKitchens)
                                        {
                                            <option value="@kitchen.Id">@kitchen.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="text-center italic text-[9px] font-bold text-slate-300">OR</div>
                                <div>
                                    <label class="text-[9px] font-bold text-slate-500 uppercase tracking-tighter mb-1 block">Franchise Store</label>
                                    <select name="fromStoreId" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold focus:ring-4 focus:ring-sky-500/10 focus:border-sky-500 transition-all">
                                        <option value="">-- No Source --</option>
                                        @foreach (var store in Model.Stores)
                                        {
                                            <option value="@store.Id">@store.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="flex flex-col gap-4">
                            <h4 class="text-[10px] font-black text-[#137fec] uppercase tracking-widest flex items-center gap-2">
                                <span class="material-symbols-outlined text-lg">login</span> Destination Node
                            </h4>
                            <div class="flex flex-col gap-3">
                                <div>
                                    <label class="text-[9px] font-bold text-slate-500 uppercase tracking-tighter mb-1 block">Central Kitchen</label>
                                    <select name="toCentralKitchenId" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold focus:ring-4 focus:ring-sky-500/10 focus:border-sky-500 transition-all">
                                        <option value="">-- Select Target --</option>
                                        @foreach (var kitchen in Model.CentralKitchens)
                                        {
                                            <option value="@kitchen.Id">@kitchen.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="text-center italic text-[9px] font-bold text-slate-300">OR</div>
                                <div>
                                    <label class="text-[9px] font-bold text-slate-500 uppercase tracking-tighter mb-1 block">Franchise Store</label>
                                    <select name="toStoreId" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold focus:ring-4 focus:ring-sky-500/10 focus:border-sky-500 transition-all">
                                        <option value="">-- Select Target --</option>
                                        @foreach (var store in Model.Stores)
                                        {
                                            <option value="@store.Id">@store.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col gap-6 pt-6 border-t border-slate-100">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <div class="md:col-span-2">
                                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 block">Asset Identification</label>
                                <select name="productId" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold focus:ring-4 focus:ring-sky-500/10 focus:border-sky-500 transition-all" required>
                                    <option value="">-- Choose Product --</option>
                                    @foreach (var product in Model.Products)
                                    {
                                        <option value="@product.Id">@product.Name</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 block">Allocation Qty</label>
                                <input type="number" name="quantity" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-black focus:ring-4 focus:ring-sky-500/10 focus:border-sky-500 transition-all" min="1" required placeholder="0" />
                            </div>
                        </div>

                        <div>
                            <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 block">Strategic Justification</label>
                            <textarea name="notes" rows="3" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:ring-4 focus:ring-sky-500/10 focus:border-sky-500 transition-all" placeholder="Enter reason for transfer (e.g., Low stock at Store #15)..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="px-8 py-6 bg-slate-50/50 border-t border-slate-100 flex items-center justify-end gap-3">
                    <button type="button" onclick="closeModal('createTransferModal')" class="px-6 py-3 rounded-2xl border border-slate-200 text-slate-600 font-black text-[10px] uppercase tracking-widest hover:bg-white transition-all">
                        Abort
                    </button>
                    <button type="submit" class="inline-flex items-center gap-2 px-8 py-3 bg-emerald-500 text-white rounded-2xl font-black text-[10px] uppercase tracking-widest shadow-xl shadow-emerald-500/20 hover:bg-emerald-600 hover:-translate-y-0.5 active:translate-y-0 transition-all">
                        <span class="material-symbols-outlined text-lg">send_and_archive</span>
                        Submit Order
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openModal(id) {
        const modal = document.getElementById(id);
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeModal(id) {
        const modal = document.getElementById(id);
        modal.classList.add('hidden');
        document.body.style.overflow = 'auto';
    }
</script>
