@page
@model PresentationLayer_FranLink.Pages.Manager.Inventory.TransfersModel
@{
    ViewData["Title"] = "Inventory Transfers";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-arrow-left-right"></i> Inventory Transfers</h1>
        <div>
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createTransferModal">
                <i class="bi bi-plus-circle"></i> New Transfer Request
            </button>
            <a asp-page="/Manager/Inventory/Dashboard" class="btn btn-outline-secondary ms-2">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Status Tabs -->
    <ul class="nav nav-tabs mb-4" id="transferTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link @(Model.StatusFilter == "Pending" ? "active" : "")" 
               asp-page="/Manager/Inventory/Transfers" asp-route-status="Pending">
                <i class="bi bi-clock text-warning"></i> Pending 
                <span class="badge bg-warning text-dark">@Model.Transfers.Count(t => t.Status == "Pending")</span>
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link @(Model.StatusFilter == "Approved" ? "active" : "")" 
               asp-page="/Manager/Inventory/Transfers" asp-route-status="Approved">
                <i class="bi bi-check-circle text-success"></i> Approved 
                <span class="badge bg-success">@Model.AllTransfers.Count(t => t.Status == "Approved")</span>
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link @(Model.StatusFilter == "Completed" ? "active" : "")" 
               asp-page="/Manager/Inventory/Transfers" asp-route-status="Completed">
                <i class="bi bi-check-all text-primary"></i> Completed 
                <span class="badge bg-primary">@Model.AllTransfers.Count(t => t.Status == "Completed")</span>
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link @(Model.StatusFilter == "Rejected" ? "active" : "")" 
               asp-page="/Manager/Inventory/Transfers" asp-route-status="Rejected">
                <i class="bi bi-x-circle text-danger"></i> Rejected 
                <span class="badge bg-danger">@Model.AllTransfers.Count(t => t.Status == "Rejected")</span>
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link @(string.IsNullOrEmpty(Model.StatusFilter) ? "active" : "")" 
               asp-page="/Manager/Inventory/Transfers">
                <i class="bi bi-list"></i> All
            </a>
        </li>
    </ul>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @Model.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Transfers Table -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Transfer Requests</h5>
        </div>
        <div class="card-body">
            @if (Model.Transfers.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>From</th>
                                <th>To</th>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Status</th>
                                <th>Requested By</th>
                                <th>Request Date</th>
                                <th>Notes</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var transfer in Model.Transfers)
                            {
                                var fromLocation = transfer.FromCentralKitchenId.HasValue 
                                    ? $"🏭 {transfer.FromCentralKitchen?.Name}" 
                                    : $"🏪 {transfer.FromStore?.Name}";
                                var toLocation = transfer.ToCentralKitchenId.HasValue 
                                    ? $"🏭 {transfer.ToCentralKitchen?.Name}" 
                                    : $"🏪 {transfer.ToStore?.Name}";
                                
                                <tr>
                                    <td><strong>#@transfer.Id</strong></td>
                                    <td>@fromLocation</td>
                                    <td>@toLocation</td>
                                    <td>@transfer.Product?.Name</td>
                                    <td><strong>@transfer.Quantity</strong></td>
                                    <td>
                                        @switch (transfer.Status)
                                        {
                                            case "Pending":
                                                <span class="badge bg-warning text-dark">Pending</span>
                                                break;
                                            case "Approved":
                                                <span class="badge bg-success">Approved</span>
                                                break;
                                            case "Completed":
                                                <span class="badge bg-primary">Completed</span>
                                                break;
                                            case "Rejected":
                                                <span class="badge bg-danger">Rejected</span>
                                                break;
                                        }
                                    </td>
                                    <td>@transfer.RequestedBy?.Username</td>
                                    <td>@transfer.RequestDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(transfer.Notes))
                                        {
                                            <span class="text-truncate d-inline-block" style="max-width: 150px;" title="@transfer.Notes">
                                                @transfer.Notes
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (transfer.Status == "Pending")
                                        {
                                            <form method="post" class="d-inline">
                                                <input type="hidden" name="transferId" value="@transfer.Id" />
                                                <button type="submit" asp-page-handler="Approve" class="btn btn-sm btn-success" title="Approve">
                                                    <i class="bi bi-check"></i>
                                                </button>
                                                <button type="submit" asp-page-handler="Reject" class="btn btn-sm btn-danger" title="Reject">
                                                    <i class="bi bi-x"></i>
                                                </button>
                                            </form>
                                        }
                                        else if (transfer.Status == "Approved")
                                        {
                                            <form method="post" class="d-inline">
                                                <input type="hidden" name="transferId" value="@transfer.Id" />
                                                <button type="submit" asp-page-handler="Complete" class="btn btn-sm btn-primary" title="Complete Transfer">
                                                    <i class="bi bi-check-all"></i> Complete
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No transfer requests found.
                </div>
            }
        </div>
    </div>
</div>

<!-- Create Transfer Modal -->
<div class="modal fade" id="createTransferModal" tabindex="-1" aria-labelledby="createTransferModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createTransferModalLabel">
                    <i class="bi bi-plus-circle"></i> New Transfer Request
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>From Location</h6>
                            <div class="mb-3">
                                <label class="form-label">Central Kitchen</label>
                                <select name="fromCentralKitchenId" class="form-select">
                                    <option value="">-- Select Kitchen --</option>
                                    @foreach (var kitchen in Model.CentralKitchens)
                                    {
                                        <option value="@kitchen.Id">@kitchen.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">OR Store</label>
                                <select name="fromStoreId" class="form-select">
                                    <option value="">-- Select Store --</option>
                                    @foreach (var store in Model.Stores)
                                    {
                                        <option value="@store.Id">@store.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h6>To Location</h6>
                            <div class="mb-3">
                                <label class="form-label">Central Kitchen</label>
                                <select name="toCentralKitchenId" class="form-select">
                                    <option value="">-- Select Kitchen --</option>
                                    @foreach (var kitchen in Model.CentralKitchens)
                                    {
                                        <option value="@kitchen.Id">@kitchen.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">OR Store</label>
                                <select name="toStoreId" class="form-select">
                                    <option value="">-- Select Store --</option>
                                    @foreach (var store in Model.Stores)
                                    {
                                        <option value="@store.Id">@store.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Product</label>
                                <select name="productId" class="form-select" required>
                                    <option value="">-- Select Product --</option>
                                    @foreach (var product in Model.Products)
                                    {
                                        <option value="@product.Id">@product.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Quantity</label>
                                <input type="number" name="quantity" class="form-control" min="1" required />
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes (Optional)</label>
                        <textarea name="notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-send"></i> Submit Request
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
