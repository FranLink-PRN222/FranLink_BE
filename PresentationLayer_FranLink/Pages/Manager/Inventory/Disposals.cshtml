@page
@model PresentationLayer_FranLink.Pages.Manager.Inventory.DisposalsModel
@{
    ViewData["Title"] = "Waste Management";
    Layout = "_LayoutFranLink";
}

<div class="max-w-[1440px] mx-auto w-full px-4 md:px-8 py-8 flex flex-col gap-8">
    
    <!-- Header Area -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="flex flex-col gap-2">
            <nav class="flex items-center gap-2 text-xs font-bold text-slate-400 uppercase tracking-widest">
                <a asp-page="/Manager/Inventory/Dashboard" class="hover:text-[#137fec] transition-colors">Inventory</a>
                <span class="material-symbols-outlined text-[10px]">chevron_right</span>
                <span class="text-slate-500">Asset Disposal</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-slate-900 flex items-center gap-3">
                <span class="material-symbols-outlined text-4xl text-rose-500">delete_sweep</span>
                Waste & Disposals
            </h1>
            <p class="text-slate-500 text-sm md:text-base max-w-2xl font-medium">
                Log and authorize disposal of damaged, expired, or quality-compromised stock items.
            </p>
        </div>
        <div class="flex items-center gap-3">
            <button type="button" onclick="openModal('createDisposalModal')" class="inline-flex items-center gap-2 px-6 py-3 bg-slate-900 text-white rounded-2xl font-black text-xs uppercase tracking-widest shadow-xl shadow-slate-900/20 hover:bg-slate-800 hover:-translate-y-0.5 active:translate-y-0 transition-all">
                <span class="material-symbols-outlined text-lg">add_circle</span>
                New Disposal
            </button>
            <a asp-page="/Manager/Inventory/Dashboard" class="p-3 rounded-2xl border border-slate-200 text-slate-500 hover:bg-slate-50 transition-all">
                <span class="material-symbols-outlined">dashboard</span>
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="p-4 rounded-2xl flex items-center gap-3 @(Model.IsSuccess ? "bg-emerald-50 text-emerald-700 border border-emerald-100" : "bg-rose-50 text-rose-700 border border-rose-100") anim-fade-in">
            <span class="material-symbols-outlined">@(Model.IsSuccess ? "check_circle" : "error")</span>
            <p class="text-sm font-bold">@Model.Message</p>
        </div>
    }

    <!-- Status Navigator -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        @{
            var statusTypes = new[] { 
                new { Id = "Pending", Label = "Pending", Icon = "schedule", Color = "amber", Count = Model.AllDisposals.Count(d => d.Status == "Pending") },
                new { Id = "Approved", Label = "Authorized", Icon = "verified", Color = "emerald", Count = Model.AllDisposals.Count(d => d.Status == "Approved") },
                new { Id = "Rejected", Label = "Declined", Icon = "cancel", Color = "rose", Count = Model.AllDisposals.Count(d => d.Status == "Rejected") },
                new { Id = "", Label = "All Disposal Activity", Icon = "reorder", Color = "slate", Count = Model.AllDisposals.Count() }
            };
        }

        @foreach (var status in statusTypes)
        {
            var isActive = Model.StatusFilter == status.Id || (string.IsNullOrEmpty(Model.StatusFilter) && string.IsNullOrEmpty(status.Id));
            var accentColor = status.Color;
            
            <a asp-page="/Manager/Inventory/Disposals" asp-route-status="@status.Id" 
               class="group relative bg-white p-5 rounded-[24px] border-2 transition-all duration-300 @(isActive ? $"border-{accentColor}-500 ring-4 ring-{accentColor}-500/10 shadow-lg" : "border-slate-100 hover:border-slate-300")">
                
                <div class="flex flex-col gap-3">
                    <div class="size-10 rounded-xl @(isActive ? $"bg-{accentColor}-500 text-white shadow-lg shadow-{accentColor}-500/30" : $"bg-{accentColor}-50 text-{accentColor}-500") flex items-center justify-center transition-all">
                        <span class="material-symbols-outlined text-xl">@status.Icon</span>
                    </div>
                    <div>
                        <h3 class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-0.5">@status.Label</h3>
                        <p class="text-xl font-black text-slate-900">@status.Count</p>
                    </div>
                </div>
                
                @if (isActive)
                {
                    <div class="absolute top-4 right-4 h-1.5 w-1.5 rounded-full bg-@accentColor-500"></div>
                }
            </a>
        }
    </div>

    <!-- Disposals Table -->
    <div class="bg-white rounded-[32px] border border-slate-200 shadow-sm overflow-hidden flex flex-col">
        <div class="px-8 py-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
            <h2 class="text-slate-900 font-bold flex items-center gap-2">
                <span class="material-symbols-outlined text-slate-400 text-lg">list_alt</span>
                Disposal Registry
            </h2>
            <div class="flex items-center gap-2">
                <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Viewing:</span>
                <span class="px-2.5 py-1 bg-slate-900 text-white text-[10px] font-black uppercase tracking-tight rounded-lg">@(string.IsNullOrEmpty(Model.StatusFilter) ? "Full Audit" : Model.StatusFilter)</span>
            </div>
        </div>

        <div class="overflow-x-auto">
            @if (Model.Disposals.Any())
            {
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-100">
                            <th class="px-8 py-4 text-[10px] font-black text-slate-500 uppercase tracking-widest">Registry ID</th>
                            <th class="px-6 py-4 text-[10px] font-black text-slate-500 uppercase tracking-widest">Asset & Location</th>
                            <th class="px-6 py-4 text-[10px] font-black text-slate-500 uppercase tracking-widest">Quantity & Reason</th>
                            <th class="px-6 py-4 text-[10px] font-black text-slate-500 uppercase tracking-widest text-center">Status</th>
                            <th class="px-6 py-4 text-[10px] font-black text-slate-500 uppercase tracking-widest">Authored By</th>
                            <th class="px-8 py-4 text-[10px] font-black text-slate-500 uppercase tracking-widest text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var disposal in Model.Disposals)
                        {
                            <tr class="group hover:bg-slate-50/80 transition-all">
                                <td class="px-8 py-6 font-mono text-xs font-black text-rose-500">#@disposal.Id</td>
                                <td class="px-6 py-6">
                                    <div class="flex flex-col">
                                        <span class="text-xs font-black text-slate-900 tracking-tight">@disposal.Inventory?.Product?.Name</span>
                                        <div class="flex items-center gap-1.5 mt-0.5">
                                            <span class="material-symbols-outlined text-[10px] text-slate-400">location_on</span>
                                            <span class="text-[10px] font-bold text-slate-500">@(disposal.Inventory?.CentralKitchen?.Name ?? disposal.Inventory?.FranchiseStore?.Name)</span>
                                            <span class="text-[9px] font-black text-slate-300 uppercase ml-2 tracking-tighter">Batch: @(disposal.Inventory?.BatchNumber ?? "N/A")</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-6">
                                    <div class="flex flex-col">
                                        <span class="text-xs font-black text-rose-600">-@disposal.Quantity @disposal.Inventory?.Product?.Unit</span>
                                        @{
                                            var reasonStyles = disposal.Reason switch {
                                                "Expired" => "text-rose-500",
                                                "Damaged" => "text-amber-600",
                                                "QualityIssue" => "text-sky-600",
                                                _ => "text-slate-500"
                                            };
                                        }
                                        <span class="text-[10px] font-black uppercase tracking-widest mt-0.5 @reasonStyles">@disposal.Reason</span>
                                    </div>
                                </td>
                                <td class="px-6 py-6 text-center">
                                    @{
                                        var statusStyles = disposal.Status switch {
                                            "Pending" => "bg-amber-50 text-amber-600 border-amber-100",
                                            "Approved" => "bg-emerald-50 text-emerald-600 border-emerald-100",
                                            "Rejected" => "bg-rose-50 text-rose-600 border-rose-100",
                                            _ => "bg-slate-50 text-slate-600 border-slate-100"
                                        };
                                    }
                                    <span class="px-2.5 py-1 rounded-full border @statusStyles text-[10px] font-black uppercase tracking-widest">
                                        @disposal.Status
                                    </span>
                                </td>
                                <td class="px-6 py-6 font-medium text-slate-600 text-xs">
                                    <div class="flex flex-col">
                                        <span class="font-bold text-slate-700">@disposal.DisposedBy?.Username</span>
                                        <span class="text-[10px] text-slate-400">@disposal.DisposalDate.ToString("MMM dd, HH:mm")</span>
                                    </div>
                                </td>
                                <td class="px-8 py-6 text-right">
                                    @if (disposal.Status == "Pending")
                                    {
                                        <form method="post" class="flex items-center justify-end gap-1">
                                            <input type="hidden" name="disposalId" value="@disposal.Id" />
                                            <button type="submit" asp-page-handler="Approve" class="size-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center hover:bg-emerald-500 hover:text-white transition-all shadow-sm" title="Authorize">
                                                <span class="material-symbols-outlined text-sm">check</span>
                                            </button>
                                            <button type="submit" asp-page-handler="Reject" class="size-8 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center hover:bg-rose-500 hover:text-white transition-all shadow-sm" title="Reject">
                                                <span class="material-symbols-outlined text-sm">close</span>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-[10px] font-bold text-slate-300 uppercase tracking-tighter">Read-only Log</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="p-20 flex flex-col items-center justify-center text-center gap-4">
                    <div class="size-20 rounded-full bg-slate-50 text-slate-300 flex items-center justify-center">
                        <span class="material-symbols-outlined text-5xl">inventory_2</span>
                    </div>
                    <div class="max-w-xs">
                        <h3 class="text-slate-900 font-bold text-lg">No Records Found</h3>
                        <p class="text-slate-500 text-sm">There are no disposal requests currently matching this classification.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Premium Disposal Modal -->
<div id="createDisposalModal" class="hidden fixed inset-0 z-[100] overflow-y-auto">
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" onclick="closeModal('createDisposalModal')"></div>
    <div class="flex min-h-full items-center justify-center p-4 sm:p-6 lg:p-8">
        <div class="relative w-full max-w-xl transform overflow-hidden rounded-[32px] bg-white text-left shadow-2xl transition-all border border-slate-100">
            <div class="bg-rose-500 px-8 py-6 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="size-10 rounded-xl bg-white/20 text-white flex items-center justify-center shadow-lg">
                        <span class="material-symbols-outlined text-xl">delete_sweep</span>
                    </div>
                    <div>
                        <h3 class="text-lg font-black text-white tracking-tight">Disposal Protocol</h3>
                        <p class="text-[10px] text-rose-100 font-bold uppercase tracking-widest">Asset Write-off Authorization</p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('createDisposalModal')" class="size-10 rounded-xl hover:bg-white/10 flex items-center justify-center text-white transition-all">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <form method="post" asp-page-handler="Create">
                <div class="px-8 py-10 flex flex-col gap-8">
                    <div class="flex flex-col gap-2">
                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Target Inventory Asset</label>
                        <select name="inventoryId" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold focus:ring-4 focus:ring-rose-500/10 focus:border-rose-500 transition-all" required>
                            <option value="">-- Choose Item for Disposal --</option>
                            @foreach (var item in Model.InventoryItems)
                            {
                                var location = item.CentralKitchenId.HasValue ? item.CentralKitchen?.Name : item.FranchiseStore?.Name;
                                <option value="@item.InventoryId">
                                    @item.Product?.Name (@location) - Qty: @item.Quantity [Batch: @(item.BatchNumber ?? "N/A")]
                                </option>
                            }
                        </select>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="flex flex-col gap-2">
                            <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Write-off Qty</label>
                            <input type="number" name="quantity" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-black focus:ring-4 focus:ring-rose-500/10 focus:border-rose-500 transition-all" min="1" required placeholder="0" />
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Strategic Reason</label>
                            <select name="reason" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold focus:ring-4 focus:ring-rose-500/10 focus:border-rose-500 transition-all" required>
                                <option value="">-- Select Reason --</option>
                                <option value="Expired">Product Expiration</option>
                                <option value="Damaged">Structural Damage</option>
                                <option value="QualityIssue">Quality Control Failure</option>
                                <option value="Other">Miscellaneous Write-off</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex flex-col gap-2">
                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Audit Investigation Notes</label>
                        <textarea name="notes" rows="3" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:ring-4 focus:ring-rose-500/10 focus:border-rose-500 transition-all" placeholder="Enter detailed justification for write-off..."></textarea>
                    </div>
                </div>

                <div class="px-8 py-6 bg-slate-50/50 border-t border-slate-100 flex items-center justify-end gap-3">
                    <button type="button" onclick="closeModal('createDisposalModal')" class="px-6 py-3 rounded-2xl border border-slate-200 text-slate-600 font-black text-[10px] uppercase tracking-widest hover:bg-white transition-all">
                        Cancel
                    </button>
                    <button type="submit" class="inline-flex items-center gap-2 px-8 py-3 bg-rose-500 text-white rounded-2xl font-black text-[10px] uppercase tracking-widest shadow-xl shadow-rose-500/20 hover:bg-rose-600 hover:-translate-y-0.5 active:translate-y-0 transition-all">
                        <span class="material-symbols-outlined text-lg">assignment_return</span>
                        Authorize Write-off
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openModal(id) {
        const modal = document.getElementById(id);
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeModal(id) {
        const modal = document.getElementById(id);
        modal.classList.add('hidden');
        document.body.style.overflow = 'auto';
    }
</script>
