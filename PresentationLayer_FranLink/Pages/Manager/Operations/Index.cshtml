@page
@model PresentationLayer_FranLink.Pages.Manager.Operations.IndexModel
@{
    ViewData["Title"] = "Operations Dashboard";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>🎯 Operations Dashboard</h2>
            <small class="text-muted">Real-time overview of all operations</small>
        </div>
        <div>
            <span class="badge bg-info">Last updated: @DateTime.Now.ToString("HH:mm")</span>
        </div>
    </div>

    <!-- Alerts Row -->
    <div class="row mb-4">
        @if (Model.PendingOrders > 0)
        {
            <div class="col-md-3">
                <div class="alert alert-warning mb-0 d-flex justify-content-between align-items-center">
                    <span>⏳ @Model.PendingOrders Pending Orders</span>
                    <a asp-page="../Distribution/Index" class="btn btn-sm btn-warning">View</a>
                </div>
            </div>
        }
        @if (Model.PendingDisposals > 0)
        {
            <div class="col-md-3">
                <div class="alert alert-warning mb-0 d-flex justify-content-between align-items-center">
                    <span>🗑️ @Model.PendingDisposals Pending Disposals</span>
                    <a asp-page="../Loss/Index" class="btn btn-sm btn-warning">View</a>
                </div>
            </div>
        }
        @if (Model.InventorySummary.LowStockCount > 0)
        {
            <div class="col-md-3">
                <div class="alert alert-danger mb-0 d-flex justify-content-between align-items-center">
                    <span>📦 @Model.InventorySummary.LowStockCount Low Stock Items</span>
                    <a asp-page="../Inventory/Index" class="btn btn-sm btn-danger">View</a>
                </div>
            </div>
        }
        @if (Model.InProgressProductions.Any())
        {
            <div class="col-md-3">
                <div class="alert alert-info mb-0 d-flex justify-content-between align-items-center">
                    <span>🔄 @Model.InProgressProductions.Count In Progress</span>
                    <a asp-page="../Production/Index" class="btn btn-sm btn-info">View</a>
                </div>
            </div>
        }
    </div>

    <!-- Main KPI Cards -->
    <div class="row mb-4">
        <!-- Production Today -->
        <div class="col-md-3">
            <div class="card border-primary h-100">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0">🏭 Production Today</h6>
                </div>
                <div class="card-body text-center">
                    <h2 class="text-primary">@Model.ProductionToday.TotalActualQuantity</h2>
                    <small class="text-muted">units produced</small>
                    <hr />
                    <div class="row">
                        <div class="col-6">
                            <strong>@Model.ProductionToday.TotalProductions</strong>
                            <br /><small>batches</small>
                        </div>
                        <div class="col-6">
                            <strong>@Model.ProductionToday.EfficiencyRate%</strong>
                            <br /><small>efficiency</small>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <a asp-page="../Production/Index" class="text-decoration-none">View Details →</a>
                </div>
            </div>
        </div>

        <!-- Distribution Today -->
        <div class="col-md-3">
            <div class="card border-success h-100">
                <div class="card-header bg-success text-white">
                    <h6 class="mb-0">🚚 Distribution Today</h6>
                </div>
                <div class="card-body text-center">
                    <h2 class="text-success">@Model.DistributionToday.TotalOrders</h2>
                    <small class="text-muted">orders</small>
                    <hr />
                    <div class="row">
                        <div class="col-6">
                            <strong>@Model.DistributionToday.CompletedOrders</strong>
                            <br /><small>completed</small>
                        </div>
                        <div class="col-6">
                            <strong>@Model.DistributionToday.OrderFulfillmentRate%</strong>
                            <br /><small>fulfilled</small>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <a asp-page="../Distribution/Index" class="text-decoration-none">View Details →</a>
                </div>
            </div>
        </div>

        <!-- Loss This Month -->
        <div class="col-md-3">
            <div class="card border-danger h-100">
                <div class="card-header bg-danger text-white">
                    <h6 class="mb-0">📉 Loss This Month</h6>
                </div>
                <div class="card-body text-center">
                    <h2 class="text-danger">@Model.LossThisMonth.TotalLossValue.ToString("N0")</h2>
                    <small class="text-muted">VND</small>
                    <hr />
                    <div class="row">
                        <div class="col-6">
                            <strong>@Model.LossThisMonth.TotalLossItems</strong>
                            <br /><small>items</small>
                        </div>
                        <div class="col-6">
                            <strong>@Model.LossThisMonth.TotalDisposals</strong>
                            <br /><small>disposals</small>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <a asp-page="../Loss/Index" class="text-decoration-none">View Details →</a>
                </div>
            </div>
        </div>

        <!-- Inventory Status -->
        <div class="col-md-3">
            <div class="card border-info h-100">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0">📦 Inventory Status</h6>
                </div>
                <div class="card-body text-center">
                    <h2 class="text-info">@(Model.InventorySummary.TotalCentralKitchenItems + Model.InventorySummary.TotalStoreItems)</h2>
                    <small class="text-muted">products tracked</small>
                    <hr />
                    <div class="row">
                        <div class="col-6">
                            <strong class="text-danger">@Model.InventorySummary.LowStockCount</strong>
                            <br /><small>low stock</small>
                        </div>
                        <div class="col-6">
                            <strong class="text-warning">@Model.InventorySummary.ExpiringCount</strong>
                            <br /><small>expiring</small>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <a asp-page="../Inventory/Index" class="text-decoration-none">View Details →</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Weekly Performance -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">📊 Weekly Production Performance</h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <tr>
                            <td>Total Productions</td>
                            <td class="text-end"><strong>@Model.ProductionThisWeek.TotalProductions</strong></td>
                        </tr>
                        <tr>
                            <td>Planned Quantity</td>
                            <td class="text-end"><strong>@Model.ProductionThisWeek.TotalPlannedQuantity</strong></td>
                        </tr>
                        <tr>
                            <td>Actual Quantity</td>
                            <td class="text-end"><strong>@Model.ProductionThisWeek.TotalActualQuantity</strong></td>
                        </tr>
                        <tr>
                            <td>Efficiency Rate</td>
                            <td class="text-end">
                                @{
                                    var effClass = Model.ProductionThisWeek.EfficiencyRate >= 90 ? "bg-success" : Model.ProductionThisWeek.EfficiencyRate >= 70 ? "bg-warning" : "bg-danger";
                                }
                                <span class="badge @effClass">@Model.ProductionThisWeek.EfficiencyRate%</span>
                            </td>
                        </tr>
                        <tr>
                            <td>Avg Production Time</td>
                            <td class="text-end"><strong>@Model.ProductionThisWeek.AverageProductionTimeMinutes min</strong></td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">📊 Weekly Distribution Performance</h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <tr>
                            <td>Total Orders</td>
                            <td class="text-end"><strong>@Model.DistributionThisWeek.TotalOrders</strong></td>
                        </tr>
                        <tr>
                            <td>Completed Orders</td>
                            <td class="text-end"><strong>@Model.DistributionThisWeek.CompletedOrders</strong></td>
                        </tr>
                        <tr>
                            <td>Pending Orders</td>
                            <td class="text-end"><strong>@Model.DistributionThisWeek.PendingOrders</strong></td>
                        </tr>
                        <tr>
                            <td>Total Order Value</td>
                            <td class="text-end"><strong>@Model.DistributionThisWeek.TotalValue.ToString("N0") VND</strong></td>
                        </tr>
                        <tr>
                            <td>Fulfillment Rate</td>
                            <td class="text-end">
                                @{
                                    var fulfillClass = Model.DistributionThisWeek.OrderFulfillmentRate >= 90 ? "bg-success" : Model.DistributionThisWeek.OrderFulfillmentRate >= 70 ? "bg-warning" : "bg-danger";
                                }
                                <span class="badge @fulfillClass">@Model.DistributionThisWeek.OrderFulfillmentRate%</span>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- In Progress Productions & Quick Links -->
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">🔄 In Progress Productions</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.InProgressProductions.Any())
                    {
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Recipe / Product</th>
                                    <th>Kitchen</th>
                                    <th class="text-center">Qty</th>
                                    <th>Started</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prod in Model.InProgressProductions.Take(5))
                                {
                                    var duration = DateTime.UtcNow - prod.StartTime;
                                    <tr>
                                        <td>
                                            <strong>@prod.RecipeName</strong><br />
                                            <small class="text-muted">@prod.ProductName</small>
                                        </td>
                                        <td><small>@prod.KitchenName</small></td>
                                        <td class="text-center">@prod.PlannedQuantity</td>
                                        <td>
                                            <small>@duration.Hours h @duration.Minutes m ago</small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            No productions in progress
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Quick Links -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">🔗 Quick Links</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <a asp-page="../Production/Start" class="btn btn-outline-primary w-100 py-3">
                                🚀 Start Production
                            </a>
                        </div>
                        <div class="col-6">
                            <a asp-page="../Products/Index" class="btn btn-outline-secondary w-100 py-3">
                                📦 Manage Products
                            </a>
                        </div>
                        <div class="col-6">
                            <a asp-page="../Recipes/Index" class="btn btn-outline-info w-100 py-3">
                                📖 Manage Recipes
                            </a>
                        </div>
                        <div class="col-6">
                            <a asp-page="../Inventory/Index" class="btn btn-outline-warning w-100 py-3">
                                📊 View Inventory
                            </a>
                        </div>
                        <div class="col-6">
                            <a asp-page="../Production/Report" class="btn btn-outline-success w-100 py-3">
                                📈 Production Report
                            </a>
                        </div>
                        <div class="col-6">
                            <a asp-page="../Loss/Index" class="btn btn-outline-danger w-100 py-3">
                                📉 Loss Report
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
