@page
@model PresentationLayer_FranLink.Pages.Manager.Operations.IndexModel
@{
    ViewData["Title"] = "Manager Dashboard";
    Layout = "_LayoutFranLink";
}

<div class="max-w-[1280px] mx-auto w-full px-4 md:px-8 py-8 flex flex-col gap-8">

    <!-- Header -->
    <section class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
            <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-slate-900">
                Network Operations & Performance
            </h1>
            <p class="text-slate-500 text-sm md:text-base mt-2 max-w-2xl">
                Global oversight of production standards, inventory health, and operational efficiency across the franchise network.
            </p>
        </div>
        <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-100 text-xs font-semibold text-slate-600">
                <span class="material-symbols-outlined text-sm text-blue-500">monitoring</span>
                Live Network Feed
            </span>
        </div>
    </section>

    <!-- Section 1: Standards & Action Center -->
    <section class="flex flex-col gap-4">
        <div class="flex items-center gap-2 mb-1">
            <span class="material-symbols-outlined text-indigo-600">verified</span>
            <h2 class="text-lg font-bold text-slate-900 uppercase tracking-wide">Standards & Action Center</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3">
            @if (Model.PendingOrders > 0)
            {
                <a asp-page="../Distribution/Index"
                   class="flex items-center justify-between gap-3 px-4 py-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-800 text-sm font-bold shadow-sm hover:shadow-md transition-all">
                    <span class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-xl">pending_actions</span>
                        <span>@Model.PendingOrders pending orders</span>
                    </span>
                    <span class="material-symbols-outlined text-lg">chevron_right</span>
                </a>
            }
            @if (Model.PendingDisposals > 0)
            {
                <a asp-page="../Loss/Index"
                   class="flex items-center justify-between gap-3 px-4 py-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-bold shadow-sm hover:shadow-md transition-all">
                    <span class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-xl">delete_sweep</span>
                        <span>@Model.PendingDisposals disposals</span>
                    </span>
                    <span class="material-symbols-outlined text-lg">chevron_right</span>
                </a>
            }
            <a asp-page="../Recipes/Index"
               class="flex items-center justify-between gap-3 px-4 py-4 rounded-2xl bg-indigo-50 border border-indigo-200 text-indigo-800 text-sm font-bold shadow-sm hover:shadow-md transition-all">
                <span class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-xl">menu_book</span>
                    <span>Standard Recipes</span>
                </span>
                <span class="material-symbols-outlined text-lg">settings</span>
            </a>
            <a asp-page="../Products/Index"
               class="flex items-center justify-between gap-3 px-4 py-4 rounded-2xl bg-slate-900 border border-slate-800 text-white text-sm font-bold shadow-sm hover:shadow-md transition-all">
                <span class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-xl text-slate-400">inventory</span>
                    <span>Manage Products</span>
                </span>
                <span class="material-symbols-outlined text-lg">list_alt</span>
            </a>
        </div>
    </section>

    <!-- Section 2: Inventory Oversight -->
    <section>
        <div class="flex items-center gap-2 mb-4">
            <span class="material-symbols-outlined text-amber-600">warehouse</span>
            <h2 class="text-lg font-bold text-slate-900 uppercase tracking-wide">Network Inventory Health</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                <p class="text-slate-500 text-xs font-bold uppercase tracking-widest mb-1">Total Stock Items</p>
                <p class="text-3xl font-extrabold text-slate-900">@(Model.InventorySummary.TotalCentralKitchenItems + Model.InventorySummary.TotalStoreItems)</p>
                <div class="mt-4 pt-3 border-t border-slate-50 flex justify-between text-[11px] font-bold">
                    <span class="text-slate-400">Kitchen: @Model.InventorySummary.TotalCentralKitchenItems</span>
                    <span class="text-slate-400">Stores: @Model.InventorySummary.TotalStoreItems</span>
                </div>
            </div>
            
            <a asp-page="../Inventory/Alerts" asp-route-type="lowstock" 
               class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 hover:border-rose-300 transition-colors group">
                <p class="text-slate-500 text-xs font-bold uppercase tracking-widest mb-1 group-hover:text-rose-600 transition-colors">Critical Low Stock</p>
                <p class="text-3xl font-extrabold text-rose-600">@Model.InventorySummary.LowStockCount</p>
                <p class="mt-2 text-xs text-slate-400">Items needing immediate refill</p>
            </a>

            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                <p class="text-slate-500 text-xs font-bold uppercase tracking-widest mb-1">Expiring Soon</p>
                <p class="text-3xl font-extrabold text-amber-600">@Model.InventorySummary.ExpiringCount</p>
                <p class="mt-2 text-xs text-slate-400">Batches near expiration</p>
            </div>

            <a asp-page="../Inventory/Index" 
               class="bg-blue-600 rounded-2xl shadow-lg shadow-blue-600/20 p-6 flex flex-col justify-between group hover:bg-blue-700 transition-colors">
                <p class="text-blue-100 text-xs font-bold uppercase tracking-widest">Global Status</p>
                <div class="flex items-center justify-between text-white">
                    <span class="font-bold">Inventory Dashboard</span>
                    <span class="material-symbols-outlined">analytics</span>
                </div>
            </a>
        </div>
    </section>

    <!-- Section 3: Performance & Analytics -->
    <section>
        <div class="flex items-center gap-2 mb-4">
            <span class="material-symbols-outlined text-[#137fec]">insights</span>
            <h2 class="text-lg font-bold text-slate-900 uppercase tracking-wide">Performance & Analytics</h2>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Production Performance -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="font-bold text-slate-800">Production Efficiency (Weekly)</h3>
                    <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full uppercase">Target: 95%</span>
                </div>
                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <p class="text-2xl font-black text-slate-900">@Model.ProductionThisWeek.EfficiencyRate%</p>
                        <p class="text-xs text-slate-400">Overall Efficiency</p>
                    </div>
                    <div>
                        <p class="text-2xl font-black text-slate-900">@Model.ProductionThisWeek.TotalProductions</p>
                        <p class="text-xs text-slate-400">Total Batches</p>
                    </div>
                </div>
                <div class="mt-6 pt-6 border-t border-slate-50 flex items-center justify-between">
                    <a asp-page="../Production/Report" class="text-xs font-bold text-[#137fec] hover:underline flex items-center gap-1">
                        Detailed Production Report <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    </a>
                </div>
            </div>

            <!-- Distribution Performance -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="font-bold text-slate-800">Supply Fulfillment</h3>
                    <span class="text-[10px] font-bold text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full uppercase">Today</span>
                </div>
                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <p class="text-2xl font-black text-slate-900">@Model.DistributionToday.OrderFulfillmentRate%</p>
                        <p class="text-xs text-slate-400">Fulfillment Rate</p>
                    </div>
                    <div>
                        <p class="text-2xl font-black text-slate-900">@Model.DistributionToday.TotalOrders</p>
                        <p class="text-xs text-slate-400">New Orders</p>
                    </div>
                </div>
                <div class="mt-6 pt-6 border-t border-slate-50 flex items-center justify-between">
                    <a asp-page="../Distribution/Index" class="text-xs font-bold text-[#137fec] hover:underline flex items-center gap-1">
                        Supply & Logistics Map <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 4: Efficiency & Efficiency Reporting -->
    <section class="mb-5">
        <div class="flex items-center gap-2 mb-4">
            <span class="material-symbols-outlined text-rose-600">assessment</span>
            <h2 class="text-lg font-bold text-slate-900 uppercase tracking-wide">Cost & Efficiency Reporting</h2>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-slate-100">
                <div class="p-8">
                    <p class="text-slate-500 text-xs font-bold uppercase tracking-widest mb-2">Inventory Loss (MTD)</p>
                    <p class="text-3xl font-black text-rose-600">@Model.LossThisMonth.TotalLossValue.ToString("N0") <span class="text-sm font-normal text-slate-400 tracking-tight">VND</span></p>
                    <p class="mt-4 text-xs text-slate-400">Loss from @Model.LossThisMonth.TotalDisposals recorded disposals</p>
                    <a asp-page="../Loss/Index" class="mt-6 inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-rose-50 text-rose-700 text-xs font-bold hover:bg-rose-100 transition-colors">
                        Review Waste Reasons
                    </a>
                </div>
                
                <div class="p-8">
                    <p class="text-slate-500 text-xs font-bold uppercase tracking-widest mb-2">Production Volume</p>
                    <p class="text-3xl font-black text-slate-900">@Model.ProductionThisWeek.TotalActualQuantity</p>
                    <p class="mt-4 text-xs text-slate-400">Units produced across the network this week</p>
                    <a asp-page="../Production/Index" class="mt-6 inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-100 text-slate-700 text-xs font-bold hover:bg-slate-200 transition-colors">
                        Audit All Batches
                    </a>
                </div>

                <div class="p-8 bg-slate-50/50">
                    <p class="text-slate-500 text-xs font-bold uppercase tracking-widest mb-2">Oversight Actions</p>
                    <div class="mt-4 flex flex-col gap-2">
                        <a asp-page="../Production/Report" class="flex items-center gap-2 text-sm font-bold text-[#137fec] hover:underline">
                            <span class="size-1.5 rounded-full bg-blue-500"></span>
                            Generate Cost Report
                        </a>
                        <a asp-page="../Loss/Index" class="flex items-center gap-2 text-sm font-bold text-[#137fec] hover:underline">
                            <span class="size-1.5 rounded-full bg-blue-500"></span>
                            Analyze Waste Statistics
                        </a>
                        <a asp-page="../Distribution/Index" class="flex items-center gap-2 text-sm font-bold text-[#137fec] hover:underline">
                            <span class="size-1.5 rounded-full bg-blue-500"></span>
                            Logistics Efficiency Audit
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
