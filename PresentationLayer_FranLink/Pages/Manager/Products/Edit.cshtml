@page "{id:int}"
@model PresentationLayer_FranLink.Pages.Manager.Products.EditModel
@{
    ViewData["Title"] = "Edit Product";
    Layout = "_LayoutFranLink";
}

<div class="max-w-[1280px] mx-auto w-full px-4 md:px-8 py-8 flex flex-col gap-8">
    
    <!-- Header Area -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div class="flex flex-col gap-2">
            <nav class="flex items-center gap-2 text-xs font-bold text-slate-400 uppercase tracking-widest">
                <a asp-page="Index" class="hover:text-[#137fec] transition-colors">Products</a>
                <span class="material-symbols-outlined text-[10px]">chevron_right</span>
                <span class="text-slate-500">Edit Asset</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-slate-900 flex items-center gap-3">
                <span class="material-symbols-outlined text-4xl text-amber-500">edit_square</span>
                Refine Product
            </h1>
            <p class="text-slate-500 text-sm md:text-base max-w-2xl">
                Updating specifications for <span class="font-bold text-slate-900">@Model.Input.Name</span>. Changes to pricing or units will propagate across the inventory network.
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-page="Details" asp-route-id="@Model.Input.Id" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-all flex items-center gap-2">
                <span class="material-symbols-outlined text-lg">visibility</span>
                View Live
            </a>
        </div>
    </div>

    <form method="post" class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-8 items-start">
        <input type="hidden" asp-for="Input.Id" />
        <div asp-validation-summary="ModelOnly" class="lg:col-span-2 p-4 bg-rose-50 border border-rose-200 rounded-xl text-rose-700 text-sm font-medium flex gap-3 items-start @(ViewData.ModelState.IsValid ? "hidden" : "")">
             <span class="material-symbols-outlined text-rose-500">error</span>
             <div>Please review the configuration errors below.</div>
        </div>

        <!-- Main Form Column -->
        <div class="flex flex-col gap-6">
            
            <!-- Core Specs Card -->
            <div class="bg-white rounded-[32px] border border-slate-200 shadow-sm overflow-hidden">
                <div class="px-8 py-5 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-[#137fec]">tune</span>
                        <h2 class="text-slate-900 font-bold">Base Configuration</h2>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Asset Status</span>
                        <label class="relative inline-flex items-center cursor-pointer group">
                            <input asp-for="Input.IsActive" type="checkbox" class="sr-only peer">
                            <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
                            <span class="ml-2 text-xs font-bold text-slate-500 group-peer-checked:text-emerald-600">Active</span>
                        </label>
                    </div>
                </div>
                <div class="p-8 grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="md:col-span-1">
                        <label asp-for="Input.Name" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Product Name <span class="text-rose-500">*</span></label>
                        <input asp-for="Input.Name" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-bold tracking-tight focus:ring-4 focus:ring-[#137fec]/10 focus:border-[#137fec] transition-all" />
                        <span asp-validation-for="Input.Name" class="text-[10px] text-rose-500 font-bold uppercase mt-1"></span>
                    </div>

                    <div class="md:col-span-1">
                        <label asp-for="Input.SKU" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Stock Keeping Unit (SKU)</label>
                        <input asp-for="Input.SKU" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-mono text-sm focus:ring-4 focus:ring-[#137fec]/10 focus:border-[#137fec] transition-all" />
                        <span asp-validation-for="Input.SKU" class="text-[10px] text-rose-500 font-bold uppercase mt-1"></span>
                    </div>

                    <div class="md:col-span-1">
                        <label asp-for="Input.Price" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Registry Price <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <input asp-for="Input.Price" type="number" step="1000" class="w-full pl-12 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-black focus:ring-4 focus:ring-[#137fec]/10 focus:border-[#137fec] transition-all" />
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-bold text-xs">VND</span>
                        </div>
                        <span asp-validation-for="Input.Price" class="text-[10px] text-rose-500 font-bold uppercase mt-1"></span>
                    </div>

                    <div class="md:col-span-1">
                        <label asp-for="Input.Unit" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Measurement Unit</label>
                        <select asp-for="Input.Unit" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-bold focus:ring-4 focus:ring-[#137fec]/10 focus:border-[#137fec] transition-all">
                            <option value="">-- Choose Unit --</option>
                            <option value="cái">Cái (Piece)</option>
                            <option value="hộp">Hộp (Box)</option>
                            <option value="kg">Kilogram (kg)</option>
                            <option value="gram">Gram (g)</option>
                            <option value="lít">Lít (L)</option>
                            <option value="ml">Milliliter (ml)</option>
                            <option value="gói">Gói (Packet)</option>
                            <option value="chai">Chai (Bottle)</option>
                            <option value="lon">Lon (Can)</option>
                        </select>
                        <span asp-validation-for="Input.Unit" class="text-[10px] text-rose-500 font-bold uppercase mt-1"></span>
                    </div>

                    <div class="md:col-span-2">
                        <label asp-for="Input.Category" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Catalog Category</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-lg">category</span>
                            <input asp-for="Input.Category" class="w-full pl-12 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-bold focus:ring-4 focus:ring-[#137fec]/10 focus:border-[#137fec] transition-all" list="categoryList" placeholder="Search or create category..." />
                        </div>
                        <datalist id="categoryList">
                            @foreach (var cat in Model.ExistingCategories)
                            {
                                <option value="@cat"></option>
                            }
                        </datalist>
                        <span asp-validation-for="Input.Category" class="text-[10px] text-rose-500 font-bold uppercase mt-1"></span>
                    </div>

                    <div class="md:col-span-2">
                        <label asp-for="Input.Description" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Operational Notes</label>
                        <textarea asp-for="Input.Description" rows="4" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:ring-4 focus:ring-[#137fec]/10 focus:border-[#137fec] transition-all" placeholder="Enter ingredients summary or handling instructions..."></textarea>
                        <span asp-validation-for="Input.Description" class="text-[10px] text-rose-500 font-bold uppercase mt-1"></span>
                    </div>
                </div>

                <div class="px-8 py-8 border-t border-slate-100 bg-slate-50/30 flex items-center justify-between gap-4">
                    <p class="text-[11px] text-slate-400 font-medium max-w-sm">
                        <span class="font-black text-amber-500">Warning:</span> Modifying the measurement unit may affect existing formulas that use this product as an ingredient.
                    </p>
                    <div class="flex items-center gap-3">
                        <a asp-page="Index" class="px-8 py-3.5 rounded-2xl border border-slate-200 text-slate-600 font-black text-xs uppercase tracking-widest hover:bg-slate-50 transition-all">
                            Discard
                        </a>
                        <button type="submit" class="inline-flex items-center gap-2 px-10 py-3.5 bg-amber-500 text-white rounded-2xl font-black text-xs uppercase tracking-widest shadow-xl shadow-amber-500/20 hover:bg-amber-600 hover:-translate-y-0.5 active:translate-y-0 transition-all">
                            <span class="material-symbols-outlined text-lg">save</span>
                            Commit Changes
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Area -->
        <aside class="flex flex-col gap-6 sticky top-24">
            <div class="bg-slate-900 rounded-[32px] p-6 text-white shadow-2xl relative overflow-hidden">
                <div class="absolute -right-8 -top-8 h-32 w-32 bg-amber-500/10 rounded-full blur-3xl"></div>
                <h3 class="text-sm font-bold uppercase tracking-widest text-amber-500 mb-6 flex items-center gap-2">
                    <span class="material-symbols-outlined text-xl">history</span>
                    Audit Snapshot
                </h3>
                <div class="flex flex-col gap-5 text-xs">
                    <div class="flex gap-4">
                        <div class="size-6 rounded-lg bg-white/10 flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-sm text-[#137fec]">info</span>
                        </div>
                        <p class="text-slate-400 leading-relaxed font-bold italic">
                            Product modifications are globally logged for supply chain integrity.
                        </p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-[32px] p-6 border border-slate-200 shadow-sm flex flex-col gap-4">
                <h4 class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Ownership</h4>
                <div class="flex items-center gap-4">
                    <div class="size-11 rounded-full bg-slate-50 flex items-center justify-center border border-slate-100">
                        <span class="material-symbols-outlined text-slate-400">person_edit</span>
                    </div>
                    <div>
                        <p class="text-xs font-black text-slate-900 leading-tight">Master Admin</p>
                        <p class="text-[10px] text-slate-500 font-bold uppercase tracking-tighter">Authorized Editor</p>
                    </div>
                </div>
            </div>
        </aside>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
