@page "{id:int}"
@model PresentationLayer_FranLink.Pages.Manager.Products.DetailsModel
@{
    ViewData["Title"] = $"Asset: {Model.Product.Name}";
    Layout = "_LayoutFranLink";
}

<div class="max-w-[1440px] mx-auto w-full px-4 md:px-8 py-8 flex flex-col gap-8">
    
    <!-- Intelligent Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="flex flex-col gap-2">
            <nav class="flex items-center gap-2 text-xs font-bold text-slate-400 uppercase tracking-widest">
                <a asp-page="Index" class="hover:text-[#137fec] transition-colors">Products</a>
                <span class="material-symbols-outlined text-[10px]">chevron_right</span>
                <span class="text-slate-500">Asset Intelligence</span>
            </nav>
            <div class="flex items-center gap-4">
                <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900">@Model.Product.Name</h1>
                <div class="px-3 py-1 rounded-full @(Model.Product.IsActive ? "bg-emerald-50 text-emerald-600 border border-emerald-100" : "bg-slate-50 text-slate-400 border border-slate-200") text-[10px] font-black uppercase tracking-widest">
                    @(Model.Product.IsActive ? "Active Registry" : "Retired Asset")
                </div>
            </div>
            <p class="text-slate-500 text-sm md:text-base max-w-2xl font-medium">
                Comprehensive data snapshot including master specifications, recipe links, and global inventory distribution.
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-page="Edit" asp-route-id="@Model.Product.Id" class="inline-flex items-center gap-2 px-6 py-3 bg-slate-900 text-white rounded-2xl font-black text-xs uppercase tracking-widest shadow-xl shadow-slate-900/20 hover:bg-slate-800 hover:-translate-y-0.5 active:translate-y-0 transition-all">
                <span class="material-symbols-outlined text-lg">edit</span>
                Modify Asset
            </a>
            <a asp-page="Index" class="p-3 rounded-2xl border border-slate-200 text-slate-500 hover:bg-slate-50 transition-all">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
        </div>
    </div>

    <!-- Metric Ribbon -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-[32px] p-6 border border-slate-100 shadow-sm flex items-center gap-5">
            <div class="size-14 rounded-2xl bg-[#137fec]/10 text-[#137fec] flex items-center justify-center">
                <span class="material-symbols-outlined text-3xl">payments</span>
            </div>
            <div>
                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Unit Price</p>
                <p class="text-2xl font-black text-slate-900">@Model.Product.Price.ToString("N0") <span class="text-sm text-slate-400 font-bold">VND</span></p>
            </div>
        </div>
        <div class="bg-white rounded-[32px] p-6 border border-slate-100 shadow-sm flex items-center gap-5">
            <div class="size-14 rounded-2xl bg-amber-500/10 text-amber-500 flex items-center justify-center">
                <span class="material-symbols-outlined text-3xl">category</span>
            </div>
            <div>
                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Catalog Segment</p>
                <p class="text-2xl font-black text-slate-900">@(Model.Product.Category ?? "Standard")</p>
            </div>
        </div>
        <div class="bg-white rounded-[32px] p-6 border border-slate-100 shadow-sm flex items-center gap-5">
            <div class="size-14 rounded-2xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center">
                <span class="material-symbols-outlined text-3xl">inventory_2</span>
            </div>
            <div>
                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Global Stock</p>
                <p class="text-2xl font-black text-slate-900">@Model.TotalInventoryQuantity <span class="text-sm text-slate-400 font-bold">@Model.Product.Unit</span></p>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-8 items-start">
        
        <!-- Main Body -->
        <div class="flex flex-col gap-8">
            
            <!-- Specifications Card -->
            <div class="bg-white rounded-[40px] border border-slate-200 shadow-sm overflow-hidden">
                <div class="px-10 py-6 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                    <h3 class="font-black text-slate-900 uppercase tracking-widest text-xs flex items-center gap-2">
                        <span class="material-symbols-outlined text-lg text-[#137fec]">analytics</span>
                        Master Specifications
                    </h3>
                    <code class="text-[10px] font-bold text-slate-400 bg-white px-2 py-1 rounded-lg border border-slate-100">PID: @Model.Product.Id</code>
                </div>
                <div class="p-10">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
                        <div class="flex flex-col gap-1">
                            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Internal SKU</span>
                            <span class="font-mono text-slate-900 font-bold">@(Model.Product.SKU ?? "NOT_ASSIGNED")</span>
                        </div>
                        <div class="flex flex-col gap-1">
                            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Measurement Control</span>
                            <span class="text-slate-900 font-bold">Standard @Model.Product.Unit</span>
                        </div>
                        <div class="md:col-span-2 flex flex-col gap-3 pt-4 border-t border-slate-50">
                            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Technical Description</span>
                            <p class="text-slate-600 leading-relaxed font-medium">@(Model.Product.Description ?? "No additional technical descriptors provided for this asset.")</p>
                        </div>
                    </div>
                </div>
                <div class="px-10 py-6 border-t border-slate-100 bg-slate-50/30 flex items-center justify-between">
                    <div class="flex items-center gap-6">
                        <div class="flex flex-col">
                            <span class="text-[8px] font-black text-slate-400 uppercase tracking-tighter">Registered On</span>
                            <span class="text-[10px] font-bold text-slate-600">@Model.Product.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                        @if (Model.Product.UpdatedAt.HasValue)
                        {
                            <div class="flex flex-col">
                                <span class="text-[8px] font-black text-slate-400 uppercase tracking-tighter">Last Modified</span>
                                <span class="text-[10px] font-bold text-[#137fec]">@Model.Product.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")</span>
                            </div>
                        }
                    </div>
                    <span class="material-symbols-outlined text-slate-200">verified</span>
                </div>
            </div>

            <!-- Recipe Intelligence -->
            <div class="bg-white rounded-[40px] border border-slate-200 shadow-sm overflow-hidden">
                <div class="px-10 py-6 border-b border-slate-100 flex items-center justify-between bg-emerald-50/30">
                    <h3 class="font-black text-slate-900 uppercase tracking-widest text-xs flex items-center gap-2">
                        <span class="material-symbols-outlined text-lg text-emerald-500">menu_book</span>
                        Linked Formula
                    </h3>
                    @if (Model.Recipe != null)
                    {
                        <a asp-page="/Manager/Recipes/Edit" asp-route-id="@Model.Recipe.RecipeId" class="text-[10px] font-black text-emerald-600 uppercase tracking-widest flex items-center gap-1 hover:underline">
                            Edit Formula <span class="material-symbols-outlined text-xs">open_in_new</span>
                        </a>
                    }
                </div>
                <div class="p-10">
                    @if (Model.Recipe != null)
                    {
                        <div class="flex flex-col gap-8">
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                <div class="p-4 rounded-3xl bg-slate-50 border border-slate-100">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-1">Standard Batch</span>
                                    <span class="text-xl font-black text-slate-900">@Model.Recipe.OutputQuantity @Model.Product.Unit</span>
                                </div>
                                <div class="p-4 rounded-3xl bg-slate-50 border border-slate-100">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-1">Est. Production</span>
                                    <span class="text-xl font-black text-slate-900">@Model.Recipe.EstimatedTime <span class="text-xs font-bold text-slate-400 uppercase">Min</span></span>
                                </div>
                                <div class="p-4 rounded-3xl bg-slate-50 border border-slate-100">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-1">BOM Integrity</span>
                                    <span class="text-xl font-black text-slate-900">@Model.Recipe.RecipeItems.Count <span class="text-xs font-bold text-slate-400 uppercase">Items</span></span>
                                </div>
                            </div>

                            @if (Model.Recipe.RecipeItems.Any())
                            {
                                <div class="flex flex-col gap-4">
                                    <h4 class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Bill of Materials (BOM)</h4>
                                    <div class="rounded-3xl border border-slate-100 overflow-hidden">
                                        <table class="w-full text-left">
                                            <thead>
                                                <tr class="bg-slate-50/80 border-b border-slate-100">
                                                    <th class="px-6 py-3 text-[9px] font-black text-slate-500 uppercase">Ingredient</th>
                                                    <th class="px-6 py-3 text-[9px] font-black text-slate-500 uppercase text-right">Qty / Unit</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-slate-50">
                                                @foreach (var item in Model.Recipe.RecipeItems)
                                                {
                                                    <tr class="hover:bg-slate-50 transition-colors">
                                                        <td class="px-6 py-4">
                                                            <div class="flex flex-col">
                                                                <span class="text-xs font-bold text-slate-900">@item.IngredientProduct?.Name</span>
                                                                <span class="text-[9px] font-medium text-slate-400 uppercase tracking-tighter">PID: @item.IngredientProductId</span>
                                                            </div>
                                                        </td>
                                                        <td class="px-6 py-4 text-right font-black text-slate-900 text-xs">
                                                            @item.Quantity @item.Unit
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="flex flex-col items-center justify-center py-10 gap-4 border-2 border-dashed border-slate-100 rounded-[32px]">
                            <span class="material-symbols-outlined text-4xl text-slate-200">border_color</span>
                            <div class="text-center">
                                <p class="text-sm font-bold text-slate-400">No active formula defined for this asset.</p>
                                <a asp-page="/Manager/Recipes/Create" asp-route-productId="@Model.Product.Id" class="text-[10px] font-black text-[#137fec] uppercase tracking-widest mt-2 block hover:underline">
                                    Initialize Recipe Profile
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <aside class="flex flex-col gap-8 sticky top-24">
            
            <!-- Inventory Map -->
            <div class="bg-white rounded-[40px] border border-slate-200 shadow-sm overflow-hidden p-8 flex flex-col gap-6">
                <div class="flex items-center justify-between">
                    <h4 class="text-[10px] font-black text-slate-400 uppercase tracking-widest flex items-center gap-2">
                        <span class="material-symbols-outlined text-lg text-sky-500">map</span>
                        Global Distribution
                    </h4>
                    <span class="size-2 rounded-full bg-sky-500 animate-pulse"></span>
                </div>

                @if (Model.InventoryLocations.Any())
                {
                    <div class="flex flex-col gap-4">
                        @foreach (var loc in Model.InventoryLocations)
                        {
                            <div class="group p-4 rounded-3xl bg-slate-50 border border-slate-100 hover:border-sky-200 hover:bg-white transition-all shadow-sm shadow-transparent hover:shadow-sky-500/5">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="px-2 py-0.5 rounded-md bg-white border border-slate-200 text-[8px] font-black text-slate-400 uppercase tracking-tighter">@loc.LocationType</span>
                                    <span class="text-xs font-black text-slate-900">@loc.Quantity</span>
                                </div>
                                <p class="text-[11px] font-bold text-slate-700 leading-tight">@loc.LocationName</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-[11px] text-slate-400 font-medium italic text-center py-6">No localized inventory detected.</p>
                }
            </div>

            <!-- Readiness Badge -->
            <div class="bg-slate-900 rounded-[40px] p-8 text-white relative overflow-hidden">
                <div class="absolute -right-8 -top-8 size-32 bg-[#137fec]/20 rounded-full blur-3xl"></div>
                <div class="relative z-10 flex flex-col gap-6">
                    <div class="flex items-center gap-3">
                        <div class="size-10 rounded-xl bg-white/10 flex items-center justify-center">
                            <span class="material-symbols-outlined text-emerald-400">check_circle</span>
                        </div>
                        <div>
                            <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest leading-none mb-1">Operational State</p>
                            <p class="text-sm font-black text-white">Market Ready</p>
                        </div>
                    </div>
                    <p class="text-[10px] text-slate-400 leading-relaxed font-bold">
                        This asset is fully synchronized with the franchise supply network and available for production scheduling.
                    </p>
                </div>
            </div>
        </aside>
    </div>
</div>
