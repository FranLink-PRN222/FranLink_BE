@page "{id:int}"
@model PresentationLayer_FranLink.Pages.Manager.Products.DetailsModel
@{
    ViewData["Title"] = $"Product: {Model.Product.Name}";
    Layout = "_LayoutFranLink";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="Index">Products</a></li>
            <li class="breadcrumb-item active">@Model.Product.Name</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Product Info -->
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-box-seam me-2"></i>Product Details</h5>
                    <div>
                        @if (Model.Product.IsActive)
                        {
                            <span class="badge bg-success fs-6">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">Inactive</span>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>ID:</strong></div>
                        <div class="col-sm-9">@Model.Product.Id</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>Name:</strong></div>
                        <div class="col-sm-9">@Model.Product.Name</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>SKU:</strong></div>
                        <div class="col-sm-9"><code>@(Model.Product.SKU ?? "N/A")</code></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>Price:</strong></div>
                        <div class="col-sm-9 text-primary fw-bold">@Model.Product.Price.ToString("N0") VND</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>Unit:</strong></div>
                        <div class="col-sm-9">@(Model.Product.Unit ?? "N/A")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>Category:</strong></div>
                        <div class="col-sm-9">
                            @if (!string.IsNullOrEmpty(Model.Product.Category))
                            {
                                <span class="badge bg-info">@Model.Product.Category</span>
                            }
                            else
                            {
                                <span class="text-muted">Uncategorized</span>
                            }
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>Description:</strong></div>
                        <div class="col-sm-9">@(Model.Product.Description ?? "No description")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>Created:</strong></div>
                        <div class="col-sm-9">@Model.Product.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    @if (Model.Product.UpdatedAt.HasValue)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Updated:</strong></div>
                            <div class="col-sm-9">@Model.Product.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <a asp-page="Edit" asp-route-id="@Model.Product.Id" class="btn btn-warning">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                    <a asp-page="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Back to List
                    </a>
                </div>
            </div>

            <!-- Recipe Section -->
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-journal-text me-2"></i>Recipe</h5>
                    @if (Model.Recipe == null)
                    {
                        <a asp-page="/Manager/Recipes/Create" asp-route-productId="@Model.Product.Id" class="btn btn-sm btn-primary">
                            <i class="bi bi-plus-lg me-1"></i>Create Recipe
                        </a>
                    }
                </div>
                <div class="card-body">
                    @if (Model.Recipe != null)
                    {
                        <div class="row mb-2">
                            <div class="col-sm-3"><strong>Recipe Name:</strong></div>
                            <div class="col-sm-9">@Model.Recipe.Name</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-3"><strong>Output Qty:</strong></div>
                            <div class="col-sm-9">@Model.Recipe.OutputQuantity @Model.Product.Unit</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-3"><strong>Est. Time:</strong></div>
                            <div class="col-sm-9">@Model.Recipe.EstimatedTime minutes</div>
                        </div>
                        
                        @if (Model.Recipe.RecipeItems.Any())
                        {
                            <hr />
                            <h6>Ingredients:</h6>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Ingredient</th>
                                        <th class="text-end">Quantity</th>
                                        <th>Unit</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Recipe.RecipeItems)
                                    {
                                        <tr>
                                            <td>@item.IngredientProduct?.Name</td>
                                            <td class="text-end">@item.Quantity</td>
                                            <td>@item.Unit</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        
                        <a asp-page="/Manager/Recipes/Edit" asp-route-id="@Model.Recipe.RecipeId" class="btn btn-sm btn-outline-warning">
                            <i class="bi bi-pencil me-1"></i>Edit Recipe
                        </a>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No recipe defined for this product.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Inventory Summary -->
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-boxes me-2"></i>Inventory</h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        <h2 class="mb-0 text-primary">@Model.TotalInventoryQuantity</h2>
                        <small class="text-muted">Total in Stock</small>
                    </div>
                    
                    @if (Model.InventoryLocations.Any())
                    {
                        <hr />
                        <h6>By Location:</h6>
                        <ul class="list-group list-group-flush">
                            @foreach (var loc in Model.InventoryLocations)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <small class="text-muted">@loc.LocationType</small><br />
                                        @loc.LocationName
                                    </div>
                                    <span class="badge bg-primary rounded-pill">@loc.Quantity</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted text-center">No inventory records</p>
                    }
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-graph-up me-2"></i>Quick Stats</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted text-center mb-0">
                        <i class="bi bi-info-circle"></i> Sales statistics coming soon
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
