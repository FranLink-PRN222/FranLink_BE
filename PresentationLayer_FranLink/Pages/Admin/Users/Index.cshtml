@page
@model PresentationLayer_FranLink.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "User Management";
    Layout = "_LayoutFranLink";
}

<div class="max-w-[1280px] mx-auto w-full px-4 md:px-8 py-8 flex flex-col gap-6">

    <!-- Page header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Users & Access</h1>
            <p class="text-slate-500 text-sm md:text-base mt-1">
                Manage staff accounts, roles, and store assignments across your franchise network.
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-base">search</span>
                <input id="userSearch"
                       type="text"
                       oninput="filterUsers()"
                       class="pl-9 pr-3 py-2 rounded-xl border border-slate-200 bg-white text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-[#137fec] focus:border-transparent min-w-[220px]"
                       placeholder="Search by name, username, role..." />
            </div>
            <a asp-page="Create"
               class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#137fec] text-white text-sm font-bold shadow-md hover:bg-[#137fec]/90 transition-colors">
                <span class="material-symbols-outlined text-lg">person_add</span>
                <span>New User</span>
            </a>
        </div>
    </div>

    <!-- Summary chips -->
    <div class="flex flex-wrap gap-3">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100 text-xs font-semibold text-slate-600">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            @Model.Users.Count(u => u.IsActive) active users
        </div>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100 text-xs font-semibold text-slate-600">
            <span class="size-1.5 rounded-full bg-slate-400"></span>
            @Model.Users.Count() total users
        </div>
    </div>

    <!-- Users table card -->
    <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" id="usersTable">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200">
                        <th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">User</th>
                        <th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">Roles</th>
                        <th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">Store</th>
                        <th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">Status</th>
                        <th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">Created</th>
                        <th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-500 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100" id="usersBody">
                    @foreach (var user in Model.Users)
                    {
                        var statusLabel = user.IsActive ? "Active" : "Disabled";
                        var statusBg = user.IsActive ? "bg-emerald-100" : "bg-rose-100";
                        var statusText = user.IsActive ? "text-emerald-700" : "text-rose-700";
                        var dotColor = user.IsActive ? "bg-emerald-500" : "bg-rose-500";

                        <tr class="hover:bg-slate-50/60 transition-colors user-row"
                            data-search="@($"{user.Username} {user.FullName} {user.Email} {user.Phone} {string.Join(' ', (user.UserRoles ?? Enumerable.Empty<DataAccessLayer_FranLink.Models.UserRole>()).Select(ur => ur.Role?.RoleName ?? ""))} {user.FranchiseStore?.Name}")">
                            <td class="px-5 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="h-9 w-9 rounded-full bg-[#137fec]/10 text-[#137fec] flex items-center justify-center text-xs font-bold">
                                        @(string.IsNullOrEmpty(user.FullName) ? user.Username?[0].ToString().ToUpper() : user.FullName[0].ToString().ToUpper())
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="text-sm font-semibold text-slate-900">@user.FullName</span>
                                        <span class="text-xs text-slate-500">@user.Username · @user.Email</span>
                                        @if (!string.IsNullOrWhiteSpace(user.Phone))
                                        {
                                            <span class="text-xs text-slate-400">@user.Phone</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="px-5 py-4 text-sm text-slate-700">
                                <div class="flex flex-wrap gap-1.5">
                                    @foreach (var ur in user.UserRoles ?? Enumerable.Empty<DataAccessLayer_FranLink.Models.UserRole>())
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-slate-100 text-[11px] font-semibold text-slate-700">
                                            <span class="material-symbols-outlined text-[14px] text-slate-400">shield_person</span>
                                            @ur.Role?.RoleName
                                        </span>
                                    }
                                    @if ((user.UserRoles == null || !user.UserRoles.Any()))
                                    {
                                        <span class="text-xs text-slate-400 italic">No roles</span>
                                    }
                                </div>
                            </td>
                            <td class="px-5 py-4 text-sm text-slate-700">
                                @if (user.FranchiseStore != null)
                                {
                                    <div class="flex flex-col">
                                        <span class="font-semibold">@user.FranchiseStore.Name</span>
                                        <span class="text-xs text-slate-400">Store ID: @user.FranchiseStore.Id</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-400 italic">No store assigned</span>
                                }
                            </td>
                            <td class="px-5 py-4">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold @statusBg @statusText">
                                    <span class="size-1.5 rounded-full @dotColor"></span>
                                    @statusLabel
                                </span>
                            </td>
                            <td class="px-5 py-4 text-sm text-slate-500">
                                @user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                            </td>
                            <td class="px-5 py-4 text-right text-sm">
                                <div class="inline-flex items-center gap-2">
                                    <a asp-page="Edit" asp-route-id="@user.UserId"
                                       class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                        Edit
                                    </a>
                                    <form method="post" asp-page-handler="Toggle" asp-route-userId="@user.UserId" class="inline">
                                        <button type="submit"
                                                class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold @(user.IsActive ? "text-amber-700 bg-amber-50 hover:bg-amber-100" : "text-emerald-700 bg-emerald-50 hover:bg-emerald-100")">
                                            <span class="material-symbols-outlined text-sm">power_settings_new</span>
                                            @(user.IsActive ? "Disable" : "Enable")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Users.Any())
        {
            <div class="py-16 flex flex-col items-center gap-3 text-slate-400">
                <span class="material-symbols-outlined text-5xl">group</span>
                <p class="text-sm font-medium">No users found.</p>
                <a asp-page="Create" class="text-[#137fec] text-sm font-bold hover:underline">
                    Create the first user →
                </a>
            </div>
        }
        else
        {
            <div class="px-5 py-3 border-t border-slate-100 bg-slate-50/60 flex items-center justify-between text-xs text-slate-500">
                <span id="usersCount">
                    Showing <span class="font-semibold text-slate-900">@Model.Users.Count()</span> users
                </span>
                <span class="inline-flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">admin_panel_settings</span>
                    Admin tools for the entire franchise network
                </span>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    function filterUsers() {
        const q = (document.getElementById('userSearch').value || '').toLowerCase();
        const rows = document.querySelectorAll('#usersBody .user-row');
        let visible = 0;

        rows.forEach(row => {
            const haystack = (row.dataset.search || '').toLowerCase();
            const match = !q || haystack.includes(q);
            row.style.display = match ? '' : 'none';
            if (match) visible++;
        });

        const counter = document.getElementById('usersCount');
        if (counter) {
            counter.innerHTML = 'Showing <span class="font-semibold text-slate-900">' + visible + '</span> users';
        }
    }
</script>
}
