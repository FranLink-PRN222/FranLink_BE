@page "{id}"
@model PresentationLayer_FranLink.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = "Sửa Người dùng";
    Layout = "_LayoutFranLink";
}

<div class="max-w-[1280px] mx-auto w-full px-4 md:px-8 py-8 flex flex-col gap-6">

    <!-- Header -->
    <section class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 flex items-center gap-2">
                <span class="material-symbols-outlined text-3xl text-[#137fec]">manage_accounts</span>
                Sửa người dùng
            </h1>
            <p class="text-slate-500 text-sm md:text-base mt-1">
                Tài khoản: <span class="font-semibold text-slate-800">@Model.Username</span>
            </p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-page="Index"
               class="inline-flex items-center gap-1 px-4 py-2 rounded-lg border border-slate-200 text-sm font-semibold text-slate-700 hover:bg-slate-50">
                <span class="material-symbols-outlined text-base">arrow_back</span>
                Quay lại
            </a>
        </div>
    </section>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="rounded-xl border border-rose-200 bg-rose-50 text-rose-800 px-4 py-3 text-sm">
            @Model.ErrorMessage
        </div>
    }

    <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- Profile card -->
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-slate-100 flex items-center gap-2">
                <span class="material-symbols-outlined text-lg text-[#137fec]">person</span>
                <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide">Thông tin cá nhân</h2>
            </div>

            <form method="post" class="p-5">
                <input type="hidden" asp-for="Input.UserId" />
                <div asp-validation-summary="ModelOnly" class="text-rose-600 text-sm mb-4"></div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2">
                        <label asp-for="Input.FullName" class="block text-xs font-semibold text-slate-600 uppercase mb-1">Họ tên</label>
                        <input asp-for="Input.FullName"
                               class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#137fec] focus:border-transparent" />
                        <span asp-validation-for="Input.FullName" class="text-rose-600 text-xs"></span>
                    </div>

                    <div class="md:col-span-2">
                        <label asp-for="Input.Email" class="block text-xs font-semibold text-slate-600 uppercase mb-1">
                            Email <span class="text-rose-600">*</span>
                        </label>
                        <input asp-for="Input.Email" type="email"
                               class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#137fec] focus:border-transparent" />
                        <span asp-validation-for="Input.Email" class="text-rose-600 text-xs"></span>
                    </div>

                    <div class="md:col-span-2">
                        <label asp-for="Input.Phone" class="block text-xs font-semibold text-slate-600 uppercase mb-1">Số điện thoại</label>
                        <input asp-for="Input.Phone"
                               class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#137fec] focus:border-transparent" />
                        <span asp-validation-for="Input.Phone" class="text-rose-600 text-xs"></span>
                    </div>

                    <div class="md:col-span-2">
                        <label asp-for="Input.FranchiseStoreId" class="block text-xs font-semibold text-slate-600 uppercase mb-1">
                            Thuộc Cửa hàng/Bếp
                        </label>
                        <select asp-for="Input.FranchiseStoreId" asp-items="Model.StoreOptions"
                                class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#137fec] focus:border-transparent">
                        </select>
                        <span asp-validation-for="Input.FranchiseStoreId" class="text-rose-600 text-xs"></span>
                    </div>

                    <div class="md:col-span-2">
                        <label class="inline-flex items-center gap-2 text-sm text-slate-700">
                            <input asp-for="Input.IsActive" type="checkbox"
                                   class="h-4 w-4 rounded border-slate-300 text-[#137fec] focus:ring-[#137fec]" />
                            <span class="font-semibold">Hoạt động</span>
                        </label>
                        <span asp-validation-for="Input.IsActive" class="text-rose-600 text-xs"></span>
                    </div>
                </div>

                <div class="mt-6 flex flex-wrap items-center gap-3">
                    <button type="submit"
                            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#137fec] text-white text-sm font-bold shadow-md hover:bg-[#137fec]/90 transition-colors">
                        <span class="material-symbols-outlined text-base">save</span>
                        Lưu thay đổi
                    </button>
                    <a asp-page="Index"
                       class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-200 bg-white text-slate-700 text-sm font-bold hover:bg-slate-50 transition-colors">
                        <span class="material-symbols-outlined text-base">close</span>
                        Hủy
                    </a>
                </div>
            </form>
        </div>

        <!-- Roles card -->
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-slate-100 flex items-center gap-2">
                <span class="material-symbols-outlined text-lg text-[#137fec]">shield_person</span>
                <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide">Quản lý vai trò</h2>
            </div>

            <div class="p-5 flex flex-col gap-3">
                <p class="text-sm text-slate-500">
                    Gán hoặc gỡ vai trò của user. Thay đổi có hiệu lực ngay sau khi thao tác.
                </p>

                <div class="flex flex-col gap-2">
                    @foreach (var r in Model.AllRoles)
                    {
                        var isAssigned = Model.CurrentRoleIds.Contains(r.RoleId);
                        <div class="flex items-center justify-between gap-3 rounded-xl border border-slate-200 px-4 py-3 hover:bg-slate-50/60">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-base @(isAssigned ? "text-emerald-600" : "text-slate-400")">
                                    @(isAssigned ? "check_circle" : "radio_button_unchecked")
                                </span>
                                <div class="flex flex-col">
                                    <span class="text-sm font-semibold text-slate-900">@r.RoleName</span>
                                    <span class="text-xs text-slate-400">Role ID: @r.RoleId</span>
                                </div>
                            </div>

                            @if (isAssigned)
                            {
                                <form method="post" asp-page-handler="RemoveRole" class="inline">
                                    <input type="hidden" name="userId" value="@Model.Input.UserId" />
                                    <input type="hidden" name="roleId" value="@r.RoleId" />
                                    <button type="submit"
                                            class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-rose-200 bg-rose-50 text-xs font-semibold text-rose-700 hover:bg-rose-100">
                                        <span class="material-symbols-outlined text-sm">remove_circle</span>
                                        Gỡ
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="AssignRole" class="inline">
                                    <input type="hidden" name="userId" value="@Model.Input.UserId" />
                                    <input type="hidden" name="roleId" value="@r.RoleId" />
                                    <button type="submit"
                                            class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-emerald-200 bg-emerald-50 text-xs font-semibold text-emerald-700 hover:bg-emerald-100">
                                        <span class="material-symbols-outlined text-sm">add_circle</span>
                                        Gán
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
