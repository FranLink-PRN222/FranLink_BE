@page
@model PresentationLayer_FranLink.Pages.Admin.Users.CreateModel
@{
    ViewData["Title"] = "Thêm Người dùng";
    Layout = "_LayoutFranLink";
}

<div class="px-6 py-8 lg:px-20 max-w-[1440px] mx-auto w-full flex flex-col gap-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Tạo Người dùng Mới</h1>
            <p class="text-slate-500 text-sm md:text-base mt-2">
                Thiết lập tài khoản người dùng mới, gán vai trò và phân bổ vào cửa hàng.
            </p>
        </div>
        <a asp-page="Index" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-bold text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 transition-colors">
            <span class="material-symbols-outlined text-lg">arrow_back</span>
            Quay lại danh sách
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 flex items-start gap-3">
            <span class="material-symbols-outlined text-rose-500 mt-0.5">error</span>
            <span class="text-sm font-medium">@Model.ErrorMessage</span>
        </div>
    }

    <div class="max-w-4xl">
        <form method="post" class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Left Column: Account Credentials -->
            <div class="flex flex-col gap-6">
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50">
                        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                            <span class="material-symbols-outlined text-[#137fec]">key</span>
                            Thông tin Tài khoản
                        </h2>
                    </div>
                    <div class="p-6 flex flex-col gap-5">
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="Input.Username" class="text-sm font-bold text-slate-700">Tên đăng nhập <span class="text-rose-500">*</span></label>
                            <input asp-for="Input.Username" class="px-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#137fec] focus:bg-white transition-all" placeholder="vd: nva_manager" />
                            <span asp-validation-for="Input.Username" class="text-xs text-rose-500 font-medium"></span>
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label asp-for="Input.Password" class="text-sm font-bold text-slate-700">Mật khẩu <span class="text-rose-500">*</span></label>
                            <div class="relative group">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg transition-colors group-focus-within:text-[#137fec]">lock</span>
                                <input asp-for="Input.Password" type="password" class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#137fec] focus:bg-white transition-all" />
                            </div>
                            <span asp-validation-for="Input.Password" class="text-xs text-rose-500 font-medium"></span>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50">
                        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                            <span class="material-symbols-outlined text-[#137fec]">corporate_fare</span>
                            Phân quyền & Tổ chức
                        </h2>
                    </div>
                    <div class="p-6 flex flex-col gap-5">
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="Input.RoleId" class="text-sm font-bold text-slate-700">Vai trò hệ thống <span class="text-rose-500">*</span></label>
                            <div class="relative">
                                <select asp-for="Input.RoleId" asp-items="Model.RoleOptions" class="w-full pl-4 pr-10 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-900 appearance-none focus:outline-none focus:ring-2 focus:ring-[#137fec] focus:bg-white transition-all cursor-pointer">
                                    <option value="" disabled selected>— Chọn vai trò —</option>
                                </select>
                                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">expand_more</span>
                            </div>
                            <span asp-validation-for="Input.RoleId" class="text-xs text-rose-500 font-medium"></span>
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label asp-for="Input.FranchiseStoreId" class="text-sm font-bold text-slate-700">Cửa hàng / Bếp phụ trách</label>
                            <div class="relative">
                                <select asp-for="Input.FranchiseStoreId" asp-items="Model.StoreOptions" class="w-full pl-4 pr-10 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-900 appearance-none focus:outline-none focus:ring-2 focus:ring-[#137fec] focus:bg-white transition-all cursor-pointer"></select>
                                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">expand_more</span>
                            </div>
                            <p class="text-[11px] text-slate-500 italic mt-1">Để trống nếu là quản trị viên hệ thống (Admin).</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Personal Information -->
            <div class="flex flex-col gap-6">
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden h-fit">
                    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50">
                        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                            <span class="material-symbols-outlined text-[#137fec]">badge</span>
                            Thông tin Cá nhân
                        </h2>
                    </div>
                    <div class="p-6 flex flex-col gap-5">
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="Input.FullName" class="text-sm font-bold text-slate-700">Họ và tên</label>
                            <input asp-for="Input.FullName" class="px-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#137fec] focus:bg-white transition-all" placeholder="vd: Nguyễn Văn A" />
                            <span asp-validation-for="Input.FullName" class="text-xs text-rose-500 font-medium"></span>
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label asp-for="Input.Email" class="text-sm font-bold text-slate-700">Địa chỉ Email <span class="text-rose-500">*</span></label>
                            <div class="relative group">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg transition-colors group-focus-within:text-[#137fec]">mail</span>
                                <input asp-for="Input.Email" type="email" class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#137fec] focus:bg-white transition-all" placeholder="example@gmail.com" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-xs text-rose-500 font-medium"></span>
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label asp-for="Input.Phone" class="text-sm font-bold text-slate-700">Số điện thoại</label>
                            <div class="relative group">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg transition-colors group-focus-within:text-[#137fec]">call</span>
                                <input asp-for="Input.Phone" class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#137fec] focus:bg-white transition-all" placeholder="0123 456 789" />
                            </div>
                            <span asp-validation-for="Input.Phone" class="text-xs text-rose-500 font-medium"></span>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-3 mt-4">
                    <button type="submit" class="flex-1 inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-[#137fec] text-white text-sm font-bold shadow-md hover:bg-[#137fec]/90 transition-all active:scale-[0.98]">
                        <span class="material-symbols-outlined text-lg">person_add</span>
                        Tạo Người dùng
                    </button>
                    <a asp-page="Index" class="inline-flex items-center justify-center px-6 py-3 rounded-xl text-sm font-bold text-slate-600 border border-slate-200 bg-white hover:bg-slate-50 transition-colors">
                        Hủy
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
