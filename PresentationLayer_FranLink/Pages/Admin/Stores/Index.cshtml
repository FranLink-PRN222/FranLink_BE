@page
@model PresentationLayer_FranLink.Pages.Admin.Stores.IndexModel
@{
    ViewData["Title"] = "Quản lý Cửa hàng & Bếp trung tâm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-shop"></i> Quản lý Cửa hàng & Bếp trung tâm</h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Thêm mới
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tên</th>
                <th>Loại</th>
                <th>Địa chỉ</th>
                <th>SĐT</th>
                <th>Trạng thái</th>
                <th>Ngày tạo</th>
                <th class="text-center">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var store in Model.Stores)
            {
                <tr class="@(store.IsActive ? "" : "table-secondary")">
                    <td>@store.Id</td>
                    <td><strong>@store.Name</strong></td>
                    <td>
                        @if (store.IsCentralKitchen)
                        {
                            <span class="badge bg-warning text-dark"><i class="bi bi-fire"></i> Bếp trung tâm</span>
                        }
                        else
                        {
                            <span class="badge bg-primary"><i class="bi bi-shop-window"></i> Cửa hàng</span>
                        }
                    </td>
                    <td>@store.Address</td>
                    <td>@store.Phone</td>
                    <td>
                        @if (store.IsActive)
                        {
                            <span class="badge bg-success">Hoạt động</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Vô hiệu</span>
                        }
                    </td>
                    <td>@store.CreatedDate.ToLocalTime().ToString("dd/MM/yyyy")</td>
                    <td class="text-center">
                        <a asp-page="Edit" asp-route-id="@store.Id" class="btn btn-sm btn-outline-primary me-1">
                            <i class="bi bi-pencil"></i> Sửa
                        </a>
                        <form method="post" asp-page-handler="Toggle" asp-route-storeId="@store.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm @(store.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                @(store.IsActive ? "Vô hiệu" : "Kích hoạt")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Stores.Any())
{
    <div class="alert alert-info text-center">Chưa có cửa hàng/bếp nào.</div>
}
