@page
@model PresentationLayer_FranLink.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_LayoutFranLink";
}

<div class="max-w-[1280px] mx-auto w-full p-4 md:p-8 flex flex-col gap-8">

    <!-- Page Header -->
    <section class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Manager Overview</h1>
            <p class="text-slate-500 mt-1">Real-time performance and operational insights for your franchise.</p>
        </div>
        <div class="flex gap-3">
            <a asp-page="/Admin/Users/Index"
               class="flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 rounded-xl text-sm font-semibold hover:bg-slate-50 transition-colors text-slate-700">
                <span class="material-symbols-outlined text-lg">people</span> Users
            </a>
            <a asp-page="/Admin/Stores/Index"
               class="flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 rounded-xl text-sm font-semibold hover:bg-slate-50 transition-colors text-slate-700">
                <span class="material-symbols-outlined text-lg">store</span> Stores
            </a>
            <a asp-page="/Admin/Config/Index"
               class="flex items-center gap-2 px-4 py-2 bg-[#137fec] text-white rounded-xl text-sm font-semibold hover:bg-[#137fec]/90 transition-colors">
                <span class="material-symbols-outlined text-lg">settings</span> Config
            </a>
        </div>
    </section>

    <!-- KPI Cards -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Total Users -->
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start mb-4">
                <div class="p-2 bg-[#137fec]/10 rounded-lg text-[#137fec]">
                    <span class="material-symbols-outlined">people</span>
                </div>
                <span class="text-emerald-600 text-sm font-bold flex items-center">
                    <span class="material-symbols-outlined text-sm mr-1">trending_up</span>Active
                </span>
            </div>
            <p class="text-slate-500 text-sm font-medium mb-1">Total Users</p>
            <p class="text-3xl font-bold text-slate-900">@Model.Dashboard.TotalUsers</p>
            <p class="text-xs text-slate-400 mt-1">@Model.Dashboard.TotalActiveUsers active</p>
        </div>

        <!-- Total Stores -->
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start mb-4">
                <div class="p-2 bg-emerald-100 rounded-lg text-emerald-600">
                    <span class="material-symbols-outlined">store</span>
                </div>
                <span class="text-emerald-600 text-sm font-bold">Franchise</span>
            </div>
            <p class="text-slate-500 text-sm font-medium mb-1">Franchise Stores</p>
            <p class="text-3xl font-bold text-slate-900">@Model.Dashboard.TotalStores</p>
        </div>

        <!-- Central Kitchens -->
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start mb-4">
                <div class="p-2 bg-amber-100 rounded-lg text-amber-600">
                    <span class="material-symbols-outlined">restaurant</span>
                </div>
                <span class="text-amber-600 text-sm font-bold">Kitchens</span>
            </div>
            <p class="text-slate-500 text-sm font-medium mb-1">Central Kitchens</p>
            <p class="text-3xl font-bold text-slate-900">@Model.Dashboard.TotalCentralKitchens</p>
        </div>

        <!-- Total Orders -->
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start mb-4">
                <div class="p-2 bg-blue-100 rounded-lg text-blue-600">
                    <span class="material-symbols-outlined">receipt_long</span>
                </div>
                <span class="text-blue-600 text-sm font-bold">Internal</span>
            </div>
            <p class="text-slate-500 text-sm font-medium mb-1">Total Orders</p>
            <p class="text-3xl font-bold text-slate-900">@Model.Dashboard.TotalOrders</p>
        </div>
    </section>

    <!-- Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Orders by Status + Products + Stores Table (left 2 cols) -->
        <div class="lg:col-span-2 flex flex-col gap-6">

            <!-- Orders by Status -->
            <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <h2 class="text-base font-bold text-slate-900">Orders by Status</h2>
                    <span class="text-xs bg-slate-100 text-slate-500 px-2 py-1 rounded-lg">All Time</span>
                </div>
                <div class="p-5">
                    @if (Model.Dashboard.OrdersByStatus.Any())
                    {
                        <div class="space-y-3">
                            @foreach (var item in Model.Dashboard.OrdersByStatus)
                            {
                                <div class="flex items-center justify-between py-2">
                                    <span class="text-sm font-medium text-slate-700">@item.Key</span>
                                    <span class="px-3 py-1 rounded-full text-xs font-bold bg-[#137fec]/10 text-[#137fec]">@item.Value</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-slate-400 text-sm text-center py-6">No orders yet.</p>
                    }
                </div>
            </div>

            <!-- Stores & Kitchens Overview -->
            <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <h2 class="text-base font-bold text-slate-900">Stores & Kitchens Overview</h2>
                    <a asp-page="/Admin/Stores/Index" class="text-[#137fec] text-sm font-semibold hover:underline">View All</a>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 text-xs font-bold text-slate-500 uppercase tracking-wider">
                                <th class="px-6 py-3">Name</th>
                                <th class="px-6 py-3">Type</th>
                                <th class="px-6 py-3 text-center">Orders</th>
                                <th class="px-6 py-3 text-center">Inventory Items</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var store in Model.Dashboard.StoresOverview)
                            {
                                <tr class="hover:bg-slate-50/50 transition-colors">
                                    <td class="px-6 py-4 text-sm font-semibold text-slate-900">@store.StoreName</td>
                                    <td class="px-6 py-4">
                                        @if (store.IsCentralKitchen)
                                        {
                                            <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-700">Central Kitchen</span>
                                        }
                                        else
                                        {
                                            <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-[#137fec]/10 text-[#137fec]">Franchise Store</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-sm text-center text-slate-600">@store.TotalOrders</td>
                                    <td class="px-6 py-4 text-sm text-center text-slate-600">@store.TotalInventoryItems</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Sidebar -->
        <aside class="flex flex-col gap-6">

            <!-- Quick Stats -->
            <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
                <h2 class="text-base font-bold text-slate-900 mb-5">Quick Insights</h2>
                <div class="space-y-5">
                    <div class="flex items-center gap-3">
                        <div class="size-2.5 rounded-full bg-emerald-500 flex-shrink-0"></div>
                        <div class="flex-1">
                            <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Total Products</p>
                            <p class="text-2xl font-bold text-slate-900 mt-0.5">@Model.Dashboard.TotalProducts</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="size-2.5 rounded-full bg-blue-500 flex-shrink-0"></div>
                        <div class="flex-1">
                            <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Active Users</p>
                            <p class="text-2xl font-bold text-slate-900 mt-0.5">@Model.Dashboard.TotalActiveUsers</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions Card -->
            <div class="bg-[#137fec] rounded-xl p-6 text-white shadow-lg relative overflow-hidden">
                <div class="relative z-10">
                    <h3 class="font-bold text-lg mb-1">Admin Panel</h3>
                    <p class="text-white/80 text-sm mb-5 leading-snug">Manage users, stores, and system configuration.</p>
                    <div class="flex flex-col gap-2">
                        <a asp-page="/Admin/Users/Index"
                           class="flex items-center gap-2 bg-white/20 hover:bg-white/30 text-white px-4 py-2 rounded-lg text-sm font-semibold transition-colors">
                            <span class="material-symbols-outlined text-lg">people</span> Manage Users
                        </a>
                        <a asp-page="/Admin/Stores/Index"
                           class="flex items-center gap-2 bg-white/20 hover:bg-white/30 text-white px-4 py-2 rounded-lg text-sm font-semibold transition-colors">
                            <span class="material-symbols-outlined text-lg">store</span> Manage Stores
                        </a>
                        <a asp-page="/Admin/Config/Index"
                           class="flex items-center gap-2 bg-white text-[#137fec] px-4 py-2 rounded-lg text-sm font-bold shadow-sm hover:bg-slate-100 transition-colors">
                            <span class="material-symbols-outlined text-lg">settings</span> System Config
                        </a>
                    </div>
                </div>
                <span class="material-symbols-outlined absolute -bottom-4 -right-4 text-white/10 text-9xl rotate-12">admin_panel_settings</span>
            </div>
        </aside>
    </div>
</div>
