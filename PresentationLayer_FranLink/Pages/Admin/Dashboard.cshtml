@page
@model PresentationLayer_FranLink.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1><i class="bi bi-speedometer2"></i> Bảng điều khiển Quản trị</h1>
<hr />

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary shadow">
            <div class="card-body text-center">
                <h3>@Model.Dashboard.TotalUsers</h3>
                <p class="mb-0"><i class="bi bi-people"></i> Người dùng</p>
                <small>@Model.Dashboard.TotalActiveUsers đang hoạt động</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success shadow">
            <div class="card-body text-center">
                <h3>@Model.Dashboard.TotalStores</h3>
                <p class="mb-0"><i class="bi bi-shop"></i> Cửa hàng</p>
                <small>franchise stores</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning shadow">
            <div class="card-body text-center">
                <h3>@Model.Dashboard.TotalCentralKitchens</h3>
                <p class="mb-0"><i class="bi bi-fire"></i> Bếp trung tâm</p>
                <small>central kitchens</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info shadow">
            <div class="card-body text-center">
                <h3>@Model.Dashboard.TotalOrders</h3>
                <p class="mb-0"><i class="bi bi-cart3"></i> Đơn hàng</p>
                <small>tổng đơn nội bộ</small>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">
                <strong><i class="bi bi-bar-chart"></i> Đơn hàng theo trạng thái</strong>
            </div>
            <div class="card-body">
                @if (Model.Dashboard.OrdersByStatus.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.Dashboard.OrdersByStatus)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @item.Key
                                <span class="badge bg-primary rounded-pill">@item.Value</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">Chưa có đơn hàng.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">
                <strong><i class="bi bi-box"></i> Tổng sản phẩm</strong>
            </div>
            <div class="card-body text-center">
                <h1 class="display-4 text-primary">@Model.Dashboard.TotalProducts</h1>
                <p class="text-muted">sản phẩm trong hệ thống</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">
                <strong><i class="bi bi-lightning"></i> Quản lý nhanh</strong>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-page="/Admin/Users/Index" class="btn btn-outline-primary">
                        <i class="bi bi-people"></i> Quản lý Người dùng
                    </a>
                    <a asp-page="/Admin/Stores/Index" class="btn btn-outline-success">
                        <i class="bi bi-shop"></i> Quản lý Cửa hàng
                    </a>
                    <a asp-page="/Admin/Config/Index" class="btn btn-outline-secondary">
                        <i class="bi bi-gear"></i> Cấu hình Hệ thống
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow">
    <div class="card-header bg-dark text-white">
        <strong><i class="bi bi-building"></i> Tổng quan Cửa hàng & Bếp</strong>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tên</th>
                        <th>Loại</th>
                        <th class="text-center">Tổng đơn hàng</th>
                        <th class="text-center">Tổng tồn kho</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var store in Model.Dashboard.StoresOverview)
                    {
                        <tr>
                            <td><strong>@store.StoreName</strong></td>
                            <td>
                                @if (store.IsCentralKitchen)
                                {
                                    <span class="badge bg-warning text-dark">Bếp TT</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">Cửa hàng</span>
                                }
                            </td>
                            <td class="text-center">@store.TotalOrders</td>
                            <td class="text-center">@store.TotalInventoryItems</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
