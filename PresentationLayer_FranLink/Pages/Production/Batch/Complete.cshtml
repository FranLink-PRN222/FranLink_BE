@page "{id:int}"
@model PresentationLayer_FranLink.Pages.Production.Batch.CompleteModel
@{
    ViewData["Title"] = "Complete Production";
    Layout = "_LayoutFranLink";
}

<div class="max-w-4xl mx-auto px-4 py-8">
    <!-- Breadcrumbs -->
    <nav class="flex mb-6" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3 text-sm font-medium">
            <li class="inline-flex items-center">
                <a href="@Model.DashboardUrl" class="text-slate-500 hover:text-primary transition-colors flex items-center">
                    <span class="material-symbols-outlined text-base mr-1">factory</span>
                    Production
                </a>
            </li>
            <li>
                <div class="flex items-center">
                    <span class="material-symbols-outlined text-slate-400 text-lg">chevron_right</span>
                    <span class="ml-1 text-slate-400 md:ml-2">Complete Batch #@Model.Id</span>
                </div>
            </li>
        </ol>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Form Column -->
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <!-- Header Card -->
                <div class="bg-[#137fec] px-6 py-4 flex items-center gap-3">
                    <div class="h-10 w-10 rounded-full bg-white/20 flex items-center justify-center text-white">
                        <span class="material-symbols-outlined">check_circle</span>
                    </div>
                    <div>
                        <h1 class="text-white text-lg font-bold">Complete Production</h1>
                        <p class="text-blue-50 text-xs text-opacity-80">Finalize Batch #@Model.Id</p>
                    </div>
                </div>

                <div class="p-6">
                    <!-- Production Details Summary -->
                    <div class="grid grid-cols-2 gap-6 mb-8">
                        <div>
                            <p class="text-[10px] uppercase tracking-wider text-slate-400 font-bold mb-1">Recipe & Product</p>
                            <p class="text-slate-900 font-bold text-base leading-tight">@Model.Production.Recipe.Name</p>
                            <p class="text-slate-500 text-xs mt-0.5">@Model.Production.Recipe.Product.Name</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase tracking-wider text-slate-400 font-bold mb-1">Central Kitchen</p>
                            <div class="flex items-center gap-1.5 text-slate-700">
                                <span class="material-symbols-outlined text-base text-slate-400">location_on</span>
                                <span class="font-semibold text-sm">@Model.Production.CentralKitchen.Name</span>
                            </div>
                        </div>
                    </div>

                    @{
                        var duration = DateTime.UtcNow - Model.Production.StartTime;
                    }

                    <!-- Stats Strip -->
                    <div class="grid grid-cols-3 gap-4 p-4 bg-slate-50 rounded-xl mb-8 border border-slate-100">
                        <div class="text-center">
                            <p class="text-[10px] font-bold text-slate-400 uppercase mb-1">Planned</p>
                            <p class="text-xl font-extrabold text-slate-700">@Model.Production.PlannedQuantity</p>
                        </div>
                        <div class="text-center border-x border-slate-200 px-2">
                            <p class="text-[10px] font-bold text-slate-400 uppercase mb-1">Started At</p>
                            <p class="text-sm font-bold text-slate-600">@Model.Production.StartTime.ToLocalTime().ToString("HH:mm")</p>
                        </div>
                        <div class="text-center">
                            <p class="text-[10px] font-bold text-slate-400 uppercase mb-1">Duration</p>
                            <p class="text-sm font-bold text-slate-600">@duration.Hours h @duration.Minutes m</p>
                        </div>
                    </div>

                    <form method="post" class="space-y-6">
                        <div class="space-y-2">
                            <label asp-for="Input.ActualQuantity" class="block text-sm font-bold text-slate-700">
                                Actual Quantity Produced <span class="text-rose-500">*</span>
                            </label>
                            <div class="relative group">
                                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-primary transition-colors">production_quantity_limits</span>
                                <input asp-for="Input.ActualQuantity" type="number" step="any" required
                                       class="block w-full pl-12 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-bold text-lg focus:ring-4 focus:ring-primary/10 focus:border-primary transition-all placeholder:text-slate-300"
                                       placeholder="Enter final count..." />
                            </div>
                            <span asp-validation-for="Input.ActualQuantity" class="text-[10px] font-bold text-rose-500 uppercase tracking-tight"></span>
                        </div>

                        <div class="space-y-2">
                            <label asp-for="Input.Notes" class="block text-sm font-bold text-slate-700">Batch Notes & QA Observations</label>
                            <textarea asp-for="Input.Notes" rows="3"
                                      class="block w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:ring-4 focus:ring-primary/10 focus:border-primary transition-all placeholder:text-slate-300"
                                      placeholder="Note any deviations, ingredient quality, or QC checks..."></textarea>
                        </div>

                        <div class="flex items-center justify-between pt-4 gap-4">
                            <a href="@Model.DashboardUrl" class="px-6 py-3 rounded-xl border border-slate-200 text-slate-600 font-bold text-sm hover:bg-slate-50 transition-colors">
                                Go Back
                            </a>
                            <button type="submit" class="flex-1 flex items-center justify-center gap-2 px-8 py-3 bg-emerald-600 text-white rounded-xl font-bold text-sm shadow-lg shadow-emerald-600/20 hover:bg-emerald-700 hover:-translate-y-0.5 transition-all">
                                <span class="material-symbols-outlined text-lg">fact_check</span>
                                Complete Production
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sidebar Info -->
        <div class="space-y-6">
            <div class="bg-slate-900 rounded-2xl shadow-xl p-6 text-white relative overflow-hidden">
                <div class="absolute -right-8 -top-8 h-32 w-32 bg-primary/10 rounded-full blur-3xl"></div>
                
                <h3 class="font-bold text-base mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">inventory</span>
                    Completion Process
                </h3>
                <ul class="space-y-4">
                    <li class="flex gap-3">
                        <div class="h-5 w-5 rounded-full bg-primary/20 flex items-center justify-center text-[10px] font-bold text-primary flex-shrink-0 mt-0.5">1</div>
                        <p class="text-xs text-slate-400 leading-relaxed">System will <span class="text-white font-medium">deduct raw materials</span> from Central Kitchen inventory based on the recipe BOM.</p>
                    </li>
                    <li class="flex gap-3">
                        <div class="h-5 w-5 rounded-full bg-primary/20 flex items-center justify-center text-[10px] font-bold text-primary flex-shrink-0 mt-0.5">2</div>
                        <p class="text-xs text-slate-400 leading-relaxed">The produced <span class="text-white font-medium">@Model.Production.Recipe.Product.Name</span> will be added to the kitchen's stock.</p>
                    </li>
                    <li class="flex gap-3">
                        <div class="h-5 w-5 rounded-full bg-primary/20 flex items-center justify-center text-[10px] font-bold text-primary flex-shrink-0 mt-0.5">3</div>
                        <p class="text-xs text-slate-400 leading-relaxed">This production batch will be archived in historical records.</p>
                    </li>
                </ul>
            </div>

            <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
                 <h4 class="text-slate-400 font-bold text-[10px] uppercase tracking-widest mb-4">Quality Control</h4>
                 <div class="space-y-4">
                     <div class="flex gap-3">
                         <div class="p-2 h-8 w-8 rounded-lg bg-blue-50 text-blue-500 flex items-center justify-center">
                             <span class="material-symbols-outlined text-sm">thermostat</span>
                         </div>
                         <p class="text-[10px] text-slate-500 leading-tight">Verify output temperature meets safety standards before storage.</p>
                     </div>
                     <div class="flex gap-3">
                         <div class="p-2 h-8 w-8 rounded-lg bg-purple-50 text-purple-500 flex items-center justify-center">
                             <span class="material-symbols-outlined text-sm">brush</span>
                         </div>
                         <p class="text-[10px] text-slate-500 leading-tight">Check visual presentation and consistency against the recipe guide.</p>
                     </div>
                 </div>
            </div>
        </div>
    </div>
</div>
